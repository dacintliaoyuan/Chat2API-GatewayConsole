# 依赖与构建缓存
node_modules/
**/node_modules/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
build/
**/dist/
**/dist-cloud/
web/release/
.tools/
.worktrees/
.vercel/
.wrangler/

# 运行时数据：凭据、账本、浏览器资料、部署状态，一律不入库
/data/
/profile/
/tmp/
/output/
chat2api/token.json
chat2api/token.json.*.tmp
chat2api/.edge-profile/
chat2api/chat2api.log.*

# 本机诊断与前端临时产物
web/tmp/
web/art/
web/reference/
web/verification/
web/verify-shots/
web/docs/

# 通用
*.log
*.log.*
*.jsonl
*.db
*.db-*
*.sqlite*
*.pid
*.lock
*.bak
.env
.env.*
!.env.example
*.zip
.zcode/*
# The workspace hook config is shared with the repository; workflow artifacts stay local.
!.zcode/config.json

# #72 cutover parity fixtures deliberately carry the production ledger and
# browser-profile lock names; they are isolated test data, not runtime state.
!tests/fixtures/cutover_parity/**/*.jsonl
!tests/fixtures/cutover_parity/**/*.lock
