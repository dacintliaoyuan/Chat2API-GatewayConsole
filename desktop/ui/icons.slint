// Authored 24x24 stroke icons. One stroke width and round caps/joins keep the
// family consistent; no Unicode glyphs stand in for an icon.
export component Glyph inherits Path {
    in property <length> size: 16px;
    in property <color> tint: #000;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
    @children
}

export component IconSearch inherits Glyph {
    MoveTo { x: 10; y: 4; }
    ArcTo { x: 4; y: 10; radius-x: 6; radius-y: 6; sweep: true; large-arc: false; }
    ArcTo { x: 10; y: 16; radius-x: 6; radius-y: 6; sweep: true; large-arc: false; }
    ArcTo { x: 16; y: 10; radius-x: 6; radius-y: 6; sweep: true; large-arc: false; }
    ArcTo { x: 10; y: 4; radius-x: 6; radius-y: 6; sweep: true; large-arc: false; }
    MoveTo { x: 14.5; y: 14.5; }
    LineTo { x: 20; y: 20; }
}

export component IconRefresh inherits Glyph {
    MoveTo { x: 19; y: 12; }
    ArcTo { x: 12; y: 5; radius-x: 7; radius-y: 7; sweep: true; large-arc: true; }
    ArcTo { x: 5; y: 12; radius-x: 7; radius-y: 7; sweep: true; large-arc: false; }
    ArcTo { x: 12; y: 19; radius-x: 7; radius-y: 7; sweep: true; large-arc: false; }
    MoveTo { x: 19; y: 8; }
    LineTo { x: 19; y: 12; }
    LineTo { x: 15; y: 12; }
}

export component IconChevronLeft inherits Glyph {
    MoveTo { x: 15; y: 6; }
    LineTo { x: 9; y: 12; }
    LineTo { x: 15; y: 18; }
}

export component IconChevronRight inherits Glyph {
    MoveTo { x: 9; y: 6; }
    LineTo { x: 15; y: 12; }
    LineTo { x: 9; y: 18; }
}

export component IconPause inherits Rectangle {
    in property <length> size: 16px;
    in property <color> tint: #000;
    width: root.size;
    height: root.size;
    background: transparent;
    Rectangle {
        x: 4px;
        y: 3px;
        width: 4px;
        height: 10px;
        border-radius: 1px;
        background: root.tint;
    }
    Rectangle {
        x: 10px;
        y: 3px;
        width: 4px;
        height: 10px;
        border-radius: 1px;
        background: root.tint;
    }
}

export component IconPlay inherits Glyph {
    fill: root.tint;
    stroke: transparent;
    MoveTo { x: 7; y: 4; }
    LineTo { x: 19; y: 12; }
    LineTo { x: 7; y: 20; }
    LineTo { x: 7; y: 4; }
}

export component IconCopy inherits Glyph {
    MoveTo { x: 8; y: 5; }
    LineTo { x: 8; y: 8; }
    LineTo { x: 5; y: 8; }
    LineTo { x: 5; y: 20; }
    LineTo { x: 16; y: 20; }
    LineTo { x: 16; y: 17; }
    MoveTo { x: 11; y: 3; }
    LineTo { x: 19; y: 3; }
    LineTo { x: 19; y: 15; }
    LineTo { x: 16; y: 15; }
}

export component IconClose inherits Glyph {
    MoveTo { x: 6; y: 6; }
    LineTo { x: 18; y: 18; }
    MoveTo { x: 18; y: 6; }
    LineTo { x: 6; y: 18; }
}

export component IconTrash inherits Glyph {
    MoveTo { x: 4; y: 7; }
    LineTo { x: 20; y: 7; }
    MoveTo { x: 9; y: 4; }
    LineTo { x: 15; y: 4; }
    MoveTo { x: 6; y: 7; }
    LineTo { x: 7; y: 20; }
    LineTo { x: 17; y: 20; }
    LineTo { x: 18; y: 7; }
    MoveTo { x: 10; y: 11; }
    LineTo { x: 10; y: 16; }
    MoveTo { x: 14; y: 11; }
    LineTo { x: 14; y: 16; }
}

export component IconEdit inherits Glyph {
    MoveTo { x: 4; y: 20; }
    LineTo { x: 6; y: 14; }
    LineTo { x: 15; y: 5; }
    LineTo { x: 19; y: 9; }
    LineTo { x: 10; y: 18; }
    LineTo { x: 4; y: 20; }
    MoveTo { x: 13; y: 7; }
    LineTo { x: 17; y: 11; }
}

export component IconSwap inherits Glyph {
    MoveTo { x: 4; y: 8; }
    LineTo { x: 20; y: 8; }
    MoveTo { x: 16; y: 4; }
    LineTo { x: 20; y: 8; }
    LineTo { x: 16; y: 12; }
    MoveTo { x: 20; y: 16; }
    LineTo { x: 4; y: 16; }
    MoveTo { x: 8; y: 12; }
    LineTo { x: 4; y: 16; }
    LineTo { x: 8; y: 20; }
}

export component IconCheck inherits Glyph {
    MoveTo { x: 5; y: 12; }
    LineTo { x: 10; y: 17; }
    LineTo { x: 19; y: 7; }
}

export component IconGrid inherits Rectangle {
    in property <length> size: 16px;
    in property <color> tint: #000;
    width: root.size;
    height: root.size;
    background: transparent;
    Rectangle { x: 2px; y: 2px; width: 8px; height: 8px; border-radius: 2px; border-width: 1.6px; border-color: root.tint; }
    Rectangle { x: 14px; y: 2px; width: 8px; height: 8px; border-radius: 2px; border-width: 1.6px; border-color: root.tint; }
    Rectangle { x: 2px; y: 14px; width: 8px; height: 8px; border-radius: 2px; border-width: 1.6px; border-color: root.tint; }
    Rectangle { x: 14px; y: 14px; width: 8px; height: 8px; border-radius: 2px; border-width: 1.6px; border-color: root.tint; }
}

export component IconRequests inherits Rectangle {
    in property <length> size: 16px;
    in property <color> tint: #000;
    width: root.size;
    height: root.size;
    background: transparent;
    Rectangle { x: 2px; y: 5px; width: 3px; height: 3px; border-radius: 1.5px; background: root.tint; }
    Rectangle { x: 2px; y: 11px; width: 3px; height: 3px; border-radius: 1.5px; background: root.tint; }
    Rectangle { x: 2px; y: 17px; width: 3px; height: 3px; border-radius: 1.5px; background: root.tint; }
    Glyph {
        width: parent.width;
        height: parent.height;
        tint: root.tint;
        MoveTo { x: 8; y: 6; }
        LineTo { x: 21; y: 6; }
        MoveTo { x: 8; y: 12; }
        LineTo { x: 21; y: 12; }
        MoveTo { x: 8; y: 18; }
        LineTo { x: 21; y: 18; }
    }
}

export component IconLogs inherits Rectangle {
    in property <length> size: 16px;
    in property <color> tint: #000;
    width: root.size;
    height: root.size;
    background: transparent;
    Rectangle {
        x: 2px;
        y: 3px;
        width: 20px;
        height: 18px;
        border-radius: 3px;
        border-width: 1.6px;
        border-color: root.tint;
    }
    Glyph {
        width: parent.width;
        height: parent.height;
        tint: root.tint;
        MoveTo { x: 8; y: 9; }
        LineTo { x: 12; y: 12; }
        LineTo { x: 8; y: 15; }
    }
}

export component IconSettings inherits Rectangle {
    in property <length> size: 16px;
    in property <color> tint: #000;
    width: root.size;
    height: root.size;
    background: transparent;
    Glyph {
        width: parent.width;
        height: parent.height;
        tint: root.tint;
        MoveTo { x: 3; y: 7; }
        LineTo { x: 21; y: 7; }
        MoveTo { x: 3; y: 12; }
        LineTo { x: 21; y: 12; }
        MoveTo { x: 3; y: 17; }
        LineTo { x: 21; y: 17; }
    }
    Rectangle { x: 7px; y: 5px; width: 4px; height: 4px; border-radius: 2px; background: root.tint; }
    Rectangle { x: 14px; y: 10px; width: 4px; height: 4px; border-radius: 2px; background: root.tint; }
    Rectangle { x: 6px; y: 15px; width: 4px; height: 4px; border-radius: 2px; background: root.tint; }
}

export component IconPower inherits Glyph {
    MoveTo { x: 12; y: 3; }
    LineTo { x: 12; y: 12; }
    MoveTo { x: 6; y: 7; }
    ArcTo { x: 6; y: 17; radius-x: 8; radius-y: 8; sweep: false; large-arc: false; }
    ArcTo { x: 18; y: 17; radius-x: 8; radius-y: 8; sweep: false; large-arc: false; }
    MoveTo { x: 18; y: 7; }
}

export component AppIcon inherits Rectangle {
    in property <string> kind;
    in property <length> size: 16px;
    in property <color> tint: #000;
    width: root.size;
    height: root.size;
    background: transparent;
    if root.kind == "search" : IconSearch { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "refresh" : IconRefresh { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "chevron-left" : IconChevronLeft { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "chevron-right" : IconChevronRight { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "pause" : IconPause { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "play" : IconPlay { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "copy" : IconCopy { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "close" : IconClose { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "trash" : IconTrash { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "edit" : IconEdit { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "swap" : IconSwap { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "check" : IconCheck { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "overview" : IconGrid { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "requests" : IconRequests { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "logs" : IconLogs { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "settings" : IconSettings { width: parent.width; height: parent.height; tint: root.tint; }
    if root.kind == "power" : IconPower { width: parent.width; height: parent.height; tint: root.tint; }
}
