import { Theme } from "theme.slint";

export struct UsagePoint {
    label: string,
    detail-label: string,
    token-value: string,
    request-value: string,
    token-height: float,
    request-height: float,
}

component ChartOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <color> ink;
    in property <color> accent;
    in property <color> accent-soft;
    callback picked();

    height: 32px;
    border-radius: 5px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: root.accent;
    background: root.selected || pointer.has-hover ? root.accent-soft : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.picked(); }
    forward-focus: focus;

    Text {
        text: root.label;
        color: root.selected ? root.accent : root.ink;
        font-size: 12px;
        font-weight: root.selected ? 650 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.picked();
                return accept;
            }
            return reject;
        }
    }

    pointer := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            focus.focus();
            root.picked();
        }
    }
}

export component UsageChart inherits Rectangle {
    in-out property <int> period: 0;
    in property <[UsagePoint]> points: [];
    in property <[string]> token-ticks: [];
    in property <[string]> request-ticks: [];
    in property <string> token-total: "—";
    in property <string> request-total: "—";
    in property <bool> loading: false;
    in property <string> status-text: "发送第一条模型请求后，这里会显示用量。";
    in property <color> status-tone: root.muted;
    in property <bool> allow-motion: true;
    in property <color> surface: Theme.surface;
    in property <color> border: Theme.edge;
    in property <color> ink: Theme.ink;
    in property <color> muted: Theme.muted;
    in property <color> accent: Theme.accent;
    in property <color> accent-soft: Theme.selected;
    callback period-changed(int);

    in-out property <bool> show-requests: false;
    in-out property <bool> show-line: false;
    property <bool> compact: root.width < 518px;
    property <int> pinned: -1;
    property <string> pinned-label;
    property <int> keyboard-point: -1;
    property <bool> has-data: root.points.length > 0;
    property <bool> has-selection: active >= 0 && active < root.points.length;
    property <[string]> ticks: root.show-requests ? root.request-ticks : root.token-ticks;
    property <int> hovered: root.has-data && cursor.has-hover
        ? max(0, min(root.points.length - 1, floor(cursor.mouse-x / max(1px, plot.width) * root.points.length)))
        : -1;
    property <int> active: root.pinned >= 0 ? root.pinned
        : plot-focus.has-focus && root.keyboard-point >= 0 ? root.keyboard-point : root.hovered;

    // Test seam: geometry and selection facts the interaction tests assert on.
    out property <length> plot-x: plot.absolute-position.x;
    out property <length> plot-y: plot.absolute-position.y;
    out property <length> plot-width: plot.width;
    out property <length> plot-height: plot.height;
    out property <int> pinned-index: root.pinned;
    out property <int> active-index: root.active;
    out property <bool> can-unpin: root.has-selection && root.pinned >= 0;
    out property <string> selection-label: root.has-selection
        ? root.points[root.active].detail-label
        : root.has-data ? "选择时段查看数值" : "";
    out property <string> selection-value: root.has-selection
        ? (root.show-requests ? root.points[root.active].request-value
            : root.points[root.active].token-value) : "";
    out property <[string]> axis-ticks: root.ticks;
    out property <length> unpin-x: unpin-option.absolute-position.x;
    out property <length> unpin-y: unpin-option.absolute-position.y;
    out property <length> unpin-width: unpin-option.width;
    out property <length> unpin-height: unpin-option.height;

    preferred-height: root.compact ? 385px : 352px;
    vertical-stretch: 0;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.border;
    background: root.surface;

    changed period => {
        root.pinned = -1;
        root.keyboard-point = -1;
    }

    changed points => {
        if (root.pinned >= 0 && (root.pinned >= root.points.length
            || root.points[root.pinned].detail-label != root.pinned-label)) {
            root.pinned = -1;
        }
        if (root.keyboard-point >= root.points.length) {
            root.keyboard-point = -1;
        }
    }

    pure function height-for(point: UsagePoint) -> float {
        // Negative values mark buckets with no known measurement.
        return clamp(root.show-requests ? point.request-height : point.token-height, -1, 1);
    }

    function pin(index: int) {
        root.pinned = index;
        root.pinned-label = index >= 0 ? root.points[index].detail-label : "";
    }

    function select-period(next: int) {
        if (next != root.period) {
            root.period = next;
            root.period-changed(next);
        }
    }

    function move-selection(direction: int) {
        let current = root.pinned >= 0 ? root.pinned : root.keyboard-point;
        root.keyboard-point = current < 0 ? (direction > 0 ? 0 : root.points.length - 1)
            : clamp(current + direction, 0, root.points.length - 1);
        root.pinned = -1;
    }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        padding: 14px;
        spacing: 9px;

        toolbar := Rectangle {
            height: root.compact ? 107px : 70px;
            vertical-stretch: 0;

            Text {
                text: "用量趋势";
                height: 36px;
                color: root.ink;
                font-size: 17px;
                font-weight: 650;
                vertical-alignment: center;
            }

            range-options := HorizontalLayout {
                width: 204px;
                height: 32px;
                x: root.compact ? 0px : toolbar.width - self.width;
                y: root.compact ? 36px : 2px;
                spacing: 2px;

                for label[index] in ["今天", "最近 7 天", "最近 30 天"] : ChartOption {
                    horizontal-stretch: 1;
                    label: label;
                    selected: root.period == index;
                    ink: root.ink;
                    accent: root.accent;
                    accent-soft: root.accent-soft;
                    picked => { root.select-period(index); }
                }
            }

            options := HorizontalLayout {
                width: 238px;
                height: 32px;
                x: 0px;
                y: root.compact ? 75px : 38px;
                spacing: 2px;

                for label[index] in ["Token", "请求数"] : ChartOption {
                    width: 53px;
                    label: label;
                    selected: root.show-requests == (index == 1);
                    ink: root.ink;
                    accent: root.accent;
                    accent-soft: root.accent-soft;
                    picked => { root.show-requests = index == 1; }
                }

                Rectangle {
                    width: 1px;
                    height: 17px;
                    y: (parent.height - self.height) / 2;
                    background: root.border;
                }

                for label[index] in ["柱状图", "折线图"] : ChartOption {
                    width: 53px;
                    label: label;
                    selected: root.show-line == (index == 1);
                    ink: root.ink;
                    accent: root.accent;
                    accent-soft: root.accent-soft;
                    picked => { root.show-line = index == 1; }
                }
            }

            Text {
                text: root.show-requests ? root.request-total : root.token-total;
                x: root.compact ? 103px : options.width + 12px;
                y: root.compact ? 0px : options.y;
                width: toolbar.width - self.x;
                height: 34px;
                color: root.ink;
                font-size: 17px;
                font-weight: 650;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 128px;

            if !root.has-data : Text {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                text: root.loading ? "正在读取本实例用量…" : root.status-text;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                color: root.loading ? root.muted : root.status-tone;
                font-size: 13px;
            }

            axis := Rectangle {
                visible: root.has-data;
                width: 49px;
                height: parent.height;

                for tick[index] in root.ticks : Text {
                    width: parent.width - 6px;
                    height: 16px;
                    y: 9px + (parent.height - 38px) * index / max(root.ticks.length - 1, 1) - self.height / 2;
                    text: tick;
                    color: root.muted;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            plot := Rectangle {
                visible: root.has-data;
                x: axis.width;
                width: parent.width - axis.width;
                height: parent.height - 19px;
                border-width: plot-focus.has-focus ? 1px : 0px;
                border-color: root.accent;
                border-radius: 4px;
                accessible-role: groupbox;
                accessible-label: "用量趋势图";
                accessible-description: "用左右方向键查看时段，按 Enter 固定数值，按 Esc 清除";
                forward-focus: plot-focus;

                property <length> top: 9px;
                property <length> bottom: self.height - 10px;
                property <length> bucket-width: self.width / max(root.points.length, 1);

                for tick[index] in root.ticks : Rectangle {
                    width: parent.width;
                    height: 1px;
                    y: plot.top + (plot.bottom - plot.top) * index / max(root.ticks.length - 1, 1);
                    background: root.border;
                }

                Rectangle {
                    visible: root.has-selection;
                    x: plot.bucket-width * root.active;
                    width: plot.bucket-width;
                    y: plot.top;
                    height: plot.bottom - plot.top;
                    background: root.accent-soft;
                }

                Rectangle {
                    opacity: root.show-line ? 0 : 1;
                    animate opacity { duration: root.allow-motion ? 135ms : 0ms; easing: ease-out; }

                    for point[index] in root.points : Rectangle {
                        property <float> ratio: root.height-for(point);
                        x: plot.bucket-width * (index + 0.5) - self.width / 2;
                        width: min(24px, plot.bucket-width * 0.66);
                        height: ratio > 0 ? max(1px, (plot.bottom - plot.top) * ratio) : 0px;
                        y: plot.bottom - self.height;
                        border-top-left-radius: 2px;
                        border-top-right-radius: 2px;
                        background: root.accent;
                    }
                }

                Rectangle {
                    opacity: root.show-line ? 1 : 0;
                    animate opacity { duration: root.allow-motion ? 135ms : 0ms; easing: ease-out; }

                    for point[index] in root.points : segment := Rectangle {
                        property <length> data-height: plot.bottom - plot.top;
                        property <float> from-ratio: root.height-for(point);
                        property <float> to-ratio: index + 1 < root.points.length
                            ? root.height-for(root.points[index + 1]) : -1;
                        property <float> from-y: (data-height / 1px) * (1 - from-ratio);
                        property <float> to-y: (data-height / 1px) * (1 - to-ratio);

                        x: plot.bucket-width * (index + 0.5);
                        y: plot.top;
                        width: plot.bucket-width;
                        height: data-height;

                        // Native software rendering uses the Slint software-renderer-path feature.
                        if from-ratio >= 0 && to-ratio >= 0 : Path {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            viewbox-width: parent.width / 1px;
                            viewbox-height: parent.height / 1px;
                            stroke: root.accent;
                            stroke-width: 2px;
                            MoveTo { x: 0; y: segment.from-y; }
                            LineTo { x: segment.width / 1px; y: segment.to-y; }
                        }

                        Rectangle {
                            visible: parent.from-ratio >= 0;
                            width: root.active == index ? 8px : 4px;
                            height: self.width;
                            x: -self.width / 2;
                            y: parent.from-y * 1px - self.height / 2;
                            border-radius: self.width / 2;
                            background: root.accent;
                        }
                    }
                }

                plot-focus := FocusScope {
                    enabled: root.has-data;
                    key-pressed(event) => {
                        if (event.text == Key.LeftArrow) {
                            root.move-selection(-1);
                        } else if (event.text == Key.RightArrow) {
                            root.move-selection(1);
                        } else if (event.text == Key.Return || event.text == " ") {
                            if (root.pinned >= 0) {
                                root.keyboard-point = root.pinned;
                                root.pinned = -1;
                            } else {
                                root.pin(root.has-selection ? root.active : 0);
                            }
                        } else if (event.text == Key.Escape && root.has-selection) {
                            root.pinned = -1;
                            root.keyboard-point = -1;
                        } else {
                            return reject;
                        }
                        return accept;
                    }
                }

                cursor := TouchArea {
                    enabled: root.has-data;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.keyboard-point = -1;
                        root.pin(root.pinned == root.hovered ? -1 : root.hovered);
                        plot-focus.focus();
                    }
                }
            }

            if root.has-data : Rectangle {
                property <int> stride: max(1, ceil(62px / max(1px, plot.bucket-width)));
                x: plot.x;
                y: plot.height + 2px;
                width: plot.width;
                height: 17px;

                for point[index] in root.points : Text {
                    visible: index == 0 || index == root.points.length - 1
                        || (mod(index, parent.stride) == 0 && index + parent.stride <= root.points.length - 1);
                    width: min(62px, parent.width / min(root.points.length, 2));
                    x: clamp(plot.bucket-width * (index + 0.5) - self.width / 2, 0px, parent.width - self.width);
                    text: point.label;
                    horizontal-alignment: root.points.length == 1 ? center : index == 0 ? left
                        : index == root.points.length - 1 ? right : center;
                    vertical-alignment: center;
                    color: root.active == index ? root.accent : root.muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            height: 30px;
            spacing: 10px;

            Text {
                text: root.selection-label;
                color: root.muted;
                font-size: 12px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: root.selection-value;
                color: root.ink;
                font-size: 12px;
                font-weight: 650;
                vertical-alignment: center;
            }

            unpin-option := ChartOption {
                visible: root.can-unpin;
                width: 66px;
                height: 30px;
                label: "取消固定";
                ink: root.ink;
                accent: root.accent;
                accent-soft: root.accent-soft;
                picked => {
                    root.pinned = -1;
                    plot-focus.focus();
                }
            }
        }

        Text {
            visible: root.has-data && !root.status-text.is-empty;
            text: root.status-text;
            color: root.status-tone;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
