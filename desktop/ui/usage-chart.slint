import { ListView } from "std-widgets.slint";
import { BarChart, ChartDataset, ChartSeriesType } from "@slintplot";
import { Theme, Panel, Heading, Hint, DataText, Segmented, ActionButton, SectionLabel } from "theme.slint";

export struct UsagePoint {
    label: string,
    detail-label: string,
    token-value: string,
    request-value: string,
    token-count: float,
    request-count: float,
}

export struct RequestMetric {
    label: string,
    value: string,
    detail: string,
}

export struct ModelSpeedRow {
    model: string,
    requests: string,
    output: string,
    speed: string,
    first-token: string,
}

// Request-page analytics: five metric cards, a Token/请求/速度 chart with an
// optional per-model split, and the per-model speed table.
component RequestTrendChart inherits Rectangle {
    in property <[string]> labels;
    in property <[ChartDataset]> datasets;
    in property <bool> show-legend: false;
    in property <bool> integer-ticks: true;
    in property <int> value-decimals: 0;
    in property <bool> allow-motion: true;

    BarChart {
        width: parent.width;
        height: parent.height;
        labels: root.labels;
        datasets: root.datasets;
        begin-at-zero: true;
        integer-ticks: root.integer-ticks;
        value-decimals: root.value-decimals;
        show-legend: root.show-legend;
        show-points: false;
        show-tooltip: false;
        animated: root.allow-motion;
        bar-radius: 3px;
        fill-opacity: 0.78;
        accessible-label: "请求趋势图";
    }
}

// Column order follows Magpie's model speed table: model, speed, first-token,
// requests, then output tokens.
component ModelSpeedTable inherits VerticalLayout {
    in property <[ModelSpeedRow]> rows;
    // Guards the empty state against being pushed below the card edge.
    out property <bool> empty-hint-fits: empty-hint.absolute-position.y + empty-hint.height
        <= self.absolute-position.y + self.height;
    spacing: 3px;
    SectionLabel { text: "模型速度"; }
    HorizontalLayout {
        spacing: 6px;
        Hint { text: "模型"; horizontal-stretch: 1; }
        Hint { text: "速度"; width: 58px; horizontal-alignment: right; }
        Hint { text: "首字耗时"; width: 72px; horizontal-alignment: right; }
        Hint { text: "请求"; width: 44px; horizontal-alignment: right; }
        Hint { text: "输出"; width: 58px; horizontal-alignment: right; }
    }
    // The empty-state hint must sit inside the remaining height;
    // a trailing sibling would overflow the fixed-height card row.
    Rectangle {
        vertical-stretch: 1;
        min-height: 0px;
        ListView {
            width: parent.width;
            height: parent.height;
            for row in root.rows : HorizontalLayout {
                spacing: 6px;
                height: 20px;
                Text {
                    text: row.model;
                    color: Theme.ink;
                    font-size: 12px;
                    horizontal-stretch: 1;
                    overflow: elide;
                    wrap: no-wrap;
                }
                DataText { text: row.speed; width: 58px; horizontal-alignment: right; }
                DataText { text: row.first-token; width: 72px; horizontal-alignment: right; }
                DataText { text: row.requests; width: 44px; horizontal-alignment: right; }
                DataText { text: row.output; width: 58px; horizontal-alignment: right; }
            }
        }
        empty-hint := Hint {
            text: "暂无模型速度数据";
            visible: root.rows.length == 0;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component RequestAnalytics inherits Panel {
    // The request page gives the list the remaining height; at the minimum
    // window size the page scrolls and this card keeps its preferred height.
    min-height: 0px;
    in property <bool> compact: false;
    in property <[RequestMetric]> metrics;
    in property <[string]> labels;
    in property <[float]> token-counts;
    in property <[float]> request-counts;
    in property <[float]> speed-counts;
    in property <[ChartDataset]> token-series;
    in property <[ChartDataset]> request-series;
    in property <[ChartDataset]> speed-series;
    in property <[ModelSpeedRow]> model-speeds;
    in-out property <int> metric: 0;
    in-out property <bool> split-by-model: false;
    in property <bool> allow-motion: true;

    out property <int> metric-index: root.metric;
    out property <bool> split: root.split-by-model;
    out property <string> metric-label: root.metric == 1 ? "请求数"
        : root.metric == 2 ? "输出速度" : "Token";
    out property <[float]> plotted-values: root.metric == 1 ? root.request-counts
        : root.metric == 2 ? root.speed-counts : root.token-counts;
    out property <int> series-count: !root.split-by-model ? 1
        : root.metric == 1 ? root.request-series.length
        : root.metric == 2 ? root.speed-series.length
        : root.token-series.length;
    out property <int> model-row-count: root.model-speeds.length;
    // Reads the table that is actually laid out at the current width.
    out property <bool> empty-hint-fits: root.compact
        ? compact-table.empty-hint-fits : wide-table.empty-hint-fits;

    content := VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Equal fixed widths keep the cards the same size; at compact width
        // three cards per row avoid squeezing the labels into vertical text.
        cards := FlexboxLayout {
            flex-wrap: wrap;
            spacing: 8px;
            for metric in root.metrics : Rectangle {
                width: root.compact
                    ? (root.width - 24px - 16px) / 3
                    : (root.width - 24px - 32px) / 5;
                height: 62px;
                border-radius: 8px;
                background: Theme.surface-2;
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    Hint { text: metric.label; }
                    DataText {
                        text: metric.value;
                        font-size: 18px;
                        font-weight: 650;
                        overflow: elide;
                    }
                    Hint { text: metric.detail; overflow: elide; wrap: no-wrap; }
                }
            }
        }

        header := HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Heading { text: "请求趋势"; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Segmented {
                width: root.compact ? 160px : 196px;
                options: [{ text: "Token" }, { text: "请求数" }, { text: "速度" }];
                label: "请求指标";
                current-index: root.metric;
                selected(index) => { root.metric = index; }
            }
            Segmented {
                width: root.compact ? 120px : 148px;
                options: [{ text: "合计" }, { text: "按模型" }];
                label: "拆分维度";
                current-index: root.split-by-model ? 1 : 0;
                selected(index) => { root.split-by-model = index == 1; }
            }
        }

        // Wide: the chart and the speed table share one row. Compact: the table
        // moves below the chart so neither is squeezed below its readable width.
        compact-stack := VerticalLayout {
            visible: root.compact;
            width: 100%;
            // Hidden layouts still feed the parent's preferred height, so the
            // inactive stack collapses to zero explicitly.
            height: root.compact ? self.preferred-height : 0px;
            spacing: 8px;
            RequestTrendChart {
                width: 100%;
                height: 148px;
                labels: root.labels;
                datasets: root.split-by-model
                    ? (root.metric == 1 ? root.request-series
                        : root.metric == 2 ? root.speed-series : root.token-series)
                    : [{
                        label: root.metric-label,
                        values: root.metric == 1 ? root.request-counts
                            : root.metric == 2 ? root.speed-counts : root.token-counts,
                        series-type: ChartSeriesType.bar,
                        color: root.metric == 1 ? Theme.series-b : Theme.accent,
                    }];
                show-legend: root.split-by-model;
                integer-ticks: root.metric != 2;
                value-decimals: root.metric == 2 ? 1 : 0;
                allow-motion: root.allow-motion;
            }
            compact-table := ModelSpeedTable {
                width: 100%;
                height: 146px;
                rows: root.model-speeds;
            }
        }
        wide-row := HorizontalLayout {
            visible: !root.compact;
            spacing: 12px;
            height: root.compact ? 0px : 148px;
            RequestTrendChart {
                horizontal-stretch: 1;
                height: parent.height;
                labels: root.labels;
                datasets: root.split-by-model
                    ? (root.metric == 1 ? root.request-series
                        : root.metric == 2 ? root.speed-series : root.token-series)
                    : [{
                        label: root.metric-label,
                        values: root.metric == 1 ? root.request-counts
                            : root.metric == 2 ? root.speed-counts : root.token-counts,
                        series-type: ChartSeriesType.bar,
                        color: root.metric == 1 ? Theme.series-b : Theme.accent,
                    }];
                show-legend: root.split-by-model;
                integer-ticks: root.metric != 2;
                value-decimals: root.metric == 2 ? 1 : 0;
                allow-motion: root.allow-motion;
            }
            wide-table := ModelSpeedTable {
                width: 336px;
                rows: root.model-speeds;
            }
        }
    }
}

export component UsageChart inherits Panel {
    in-out property <int> period: 0;
    in property <[UsagePoint]> points;
    in property <[string]> labels;
    in property <[float]> token-counts;
    in property <[float]> request-counts;
    in property <string> token-total: "—";
    in property <string> request-total: "—";
    in property <bool> loading;
    in property <string> status-text;
    in property <color> status-tone: Theme.muted;
    in property <bool> allow-motion;
    in-out property <bool> show-requests;
    in-out property <bool> show-line;
    // The overview owns the auto-refresh cadence; the chart only renders its
    // four steps and the shared manual-refresh state.
    in-out property <int> auto-refresh: 5;
    in property <bool> refreshing: false;
    in property <angle> refresh-rotation: 0deg;
    in property <string> updated-at: "—";
    callback refresh();
    callback period-changed(int);
    private property <int> auto-refresh-index: 0;
    out property <length> refresh-x: refresh-button.absolute-position.x;
    out property <length> refresh-y: refresh-button.absolute-position.y;
    out property <length> refresh-width: refresh-button.width;
    out property <length> refresh-height: refresh-button.height;
    out property <bool> refresh-enabled: refresh-button.enabled;
    out property <length> content-height: content.preferred-height;
    out property <length> metric-x: metric-control.absolute-position.x;
    out property <length> metric-y: metric-control.absolute-position.y;
    out property <length> metric-width: metric-control.width;
    out property <length> metric-height: metric-control.height;
    out property <length> controls-y: controls.absolute-position.y;
    out property <length> controls-height: controls.height;
    out property <length> selection-y: selection.absolute-position.y;
    out property <length> selection-height: selection.height;

    private property <int> pinned: -1;
    private property <string> pinned-label;
    private property <int> key-index: -1;
    // The header fits one row at the default width; below 650 px it splits
    // into two rows instead of overflowing the card.
    private property <bool> narrow: root.width < 650px;
    // The selection block animates for 160 ms; the data swap waits for it so
    // the chart and the block never disagree about which range is selected.
    private property <int> pending-period: -1;
    period-sync-timer := Timer {
        interval: Theme.settle;
        running: false;
        triggered => {
            if (root.pending-period >= 0) {
                root.period-changed(root.pending-period);
                root.pending-period = -1;
            }
        }
    }
    private property <int> active: root.pinned >= 0 ? root.pinned
        : root.key-index >= 0 ? root.key-index : plot.hovered-index;
    private property <bool> has-data: root.points.length > 0;
    private property <bool> has-selection: root.active >= 0 && root.active < root.points.length;
    private property <string> metric: root.show-requests ? "请求数" : "Token";
    private property <string> keyboard-help: "左右方向键查看时段 · Enter 固定 · Esc 取消固定";
    private property <string> empty-title: root.loading ? "正在读取本实例用量…"
        : !root.status-text.is-empty ? root.status-text : "暂无用量数据";

    out property <length> plot-x: plot.absolute-position.x;
    out property <length> plot-y: plot.absolute-position.y;
    out property <length> plot-width: plot.width;
    out property <length> plot-height: plot.height;
    out property <length> unpin-x: unpin.absolute-position.x;
    out property <length> unpin-y: unpin.absolute-position.y;
    out property <length> unpin-width: unpin.width;
    out property <length> unpin-height: unpin.height;
    out property <length> period-x: period-control.absolute-position.x;
    out property <length> period-y: period-control.absolute-position.y;
    out property <length> period-width: period-control.width;
    out property <int> pinned-index: root.pinned;
    out property <int> active-index: root.active;
    out property <bool> can-unpin: root.pinned >= 0 && root.has-selection;
    out property <string> selection-label: root.has-selection ? root.points[root.active].detail-label : "";
    out property <string> selection-value: !root.has-selection ? ""
        : root.show-requests ? root.points[root.active].request-value : root.points[root.active].token-value;

    preferred-height: root.width < 670px ? 408px : 368px;
    vertical-stretch: 0;
    // The chart card is a keyboard stop: Tab reaches it, the ring is the same
    // neutral edge step as the other focusable surfaces.
    border-color: chart-focus.has-focus ? Theme.edge-strong : Theme.edge;
    animate preferred-height { duration: Theme.settle; easing: ease-out; }
    animate border-color { duration: Theme.quick; easing: ease-in-out; }

    changed period => { root.pinned = -1; root.key-index = -1; }
    changed points => {
        root.key-index = -1;
        if (root.pinned >= root.points.length
            || (root.pinned >= 0 && root.points[root.pinned].detail-label != root.pinned-label)) {
            root.pinned = -1;
        }
    }
    changed show-requests => { metric-control.current-index = root.show-requests ? 1 : 0; }
    changed show-line => { type-control.current-index = root.show-line ? 1 : 0; }
    changed auto-refresh => {
        root.auto-refresh-index = root.auto-refresh == 15 ? 1
            : root.auto-refresh == 30 ? 2
            : root.auto-refresh == 60 ? 3
            : root.auto-refresh == 0 ? 4 : 0;
    }
    changed auto-refresh-index => {
        root.auto-refresh = root.auto-refresh-index == 1 ? 15
            : root.auto-refresh-index == 2 ? 30
            : root.auto-refresh-index == 3 ? 60
            : root.auto-refresh-index == 4 ? 0 : 5;
    }

    chart-focus := FocusScope {
        focus-on-click: false;
        accessible-role: groupbox;
        accessible-label: "用量趋势图";
        key-pressed(event) => {
            if (event.text == Key.Escape && root.pinned >= 0) {
                root.pinned = -1;
                return accept;
            }
            if (root.points.length == 0) { return reject; }
            if (event.text == Key.Home) {
                root.key-index = 0;
                return accept;
            }
            if (event.text == Key.End) {
                root.key-index = root.points.length - 1;
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.key-index = root.key-index <= 0 ? 0 : root.key-index - 1;
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.key-index = root.key-index < 0 ? 0
                    : root.key-index + 1 < root.points.length ? root.key-index + 1
                    : root.points.length - 1;
                return accept;
            }
            if (event.text == Key.Return && root.active >= 0 && root.active < root.points.length) {
                root.pinned = root.active;
                root.pinned-label = root.points[root.active].detail-label;
                return accept;
            }
            return reject;
        }

        // Clicking the card background moves keyboard focus here; the plot's own
        // pointer handling stays on top of this transparent target.
        chart-pointer := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { chart-focus.focus(); }
        }

        content := VerticalLayout {
            padding: 16px;
            spacing: 10px;

            // The title anchors the card; the metric switch, refresh action,
            // update label and total share the right edge. Grouping the metric
            // switch with the total it drives mirrors the Magpie overview, and
            // leaving the range and chart type on their own row keeps the
            // controls on one line at the default width instead of wrapping a
            // blank band into the card. The wide header is a plain layout so its
            // preferred height stays measurable; below 650 px it collapses and
            // the conditional narrow header takes over.
            header := Rectangle {
                height: root.width < 500px ? 128px : root.width < 650px ? 86px : 44px;
                wide-header := HorizontalLayout {
                    visible: !root.narrow;
                    height: root.narrow ? 0px : parent.height;
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 3px;
                        Heading { text: "用量趋势"; }
                        Hint { text: root.period <= 1 ? "北京时间 · 按小时" : "北京时间 · 按天"; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    right-header := HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        refresh-button := ActionButton {
                            width: Theme.icon-button;
                            height: Theme.icon-button;
                            label: "刷新";
                            icon: "refresh";
                            icon-rotation: root.refresh-rotation;
                            icon-only: true;
                            quiet: true;
                            tooltip: "刷新总览";
                            enabled: !root.refreshing;
                            clicked => { root.refresh(); }
                        }
                        metric-control := Segmented {
                            width: 188px;
                            options: [{ text: "Token" }, { text: "请求数" }];
                            label: "用量指标";
                            current-index: root.show-requests ? 1 : 0;
                            selected(index) => { root.show-requests = index == 1; }
                        }
                        DataText {
                            text: "更新于 " + root.updated-at;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: end;
                            spacing: 2px;
                            Hint { text: root.show-requests ? "请求总数" : "Token 总量"; horizontal-alignment: right; }
                            DataText {
                                text: root.show-requests ? root.request-total : root.token-total;
                                font-size: 21px;
                                font-weight: 650;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }
                if root.narrow : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            spacing: 3px;
                            Heading { text: "用量趋势"; }
                            Hint { text: root.period <= 1 ? "北京时间 · 按小时" : "北京时间 · 按天"; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: end;
                            spacing: 2px;
                            Hint { text: root.show-requests ? "请求总数" : "Token 总量"; horizontal-alignment: right; }
                            DataText {
                                text: root.show-requests ? root.request-total : root.token-total;
                                font-size: 21px;
                                font-weight: 650;
                                horizontal-alignment: right;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        ActionButton {
                            width: Theme.icon-button;
                            height: Theme.icon-button;
                            label: "刷新";
                            icon: "refresh";
                            icon-rotation: root.refresh-rotation;
                            icon-only: true;
                            quiet: true;
                            tooltip: "刷新总览";
                            enabled: !root.refreshing;
                            clicked => { root.refresh(); }
                        }
                        Segmented {
                            width: 188px;
                            options: [{ text: "Token" }, { text: "请求数" }];
                            label: "用量指标";
                            current-index: root.show-requests ? 1 : 0;
                            selected(index) => { root.show-requests = index == 1; }
                        }
                        DataText {
                            text: "更新于 " + root.updated-at;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            controls := Rectangle {
                // The same explicit height keeps the wrapping rows from
                // inflating the card's preferred height; below 650 px the
                // range and display groups split into two rows.
                height: root.width < 650px ? 76px : 34px;
                FlexboxLayout {
                    width: parent.width;
                    height: parent.height;
                    flex-wrap: wrap;
                    alignment: space-between;
                    spacing: 8px;
                    period-control := Segmented {
                        width: 300px;
                        options: [{ text: "今天" }, { text: "24 小时" }, { text: "7 天" }, { text: "30 天" }, { text: "全部" }];
                        label: "用量时间范围";
                        current-index <=> root.period;
                        selected(index) => {
                            root.pending-period = index;
                            period-sync-timer.start();
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        type-control := Segmented {
                            width: 192px;
                            options: [{ text: "柱状图" }, { text: "折线图" }];
                            label: "图表类型";
                            current-index: root.show-line ? 1 : 0;
                            selected(index) => { root.show-line = index == 1; }
                        }
                        auto-refresh-control := Segmented {
                            width: 180px;
                            options: [{ text: "5 秒" }, { text: "15 秒" }, { text: "30 秒" }, { text: "60 秒" }, { text: "关闭" }];
                            label: "总览自动刷新";
                            current-index <=> root.auto-refresh-index;
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 142px;

                VerticalLayout {
                    visible: !root.has-data;
                    alignment: center;
                    spacing: 3px;
                    Hint {
                        text: root.empty-title;
                        color: root.loading ? Theme.muted : root.status-tone;
                        horizontal-alignment: center;
                    }
                    if !root.loading && root.status-text.is-empty : Hint {
                        text: "调用模型后这里会显示用量趋势";
                        horizontal-alignment: center;
                    }
                }

                plot := BarChart {
                    visible: root.has-data;
                    width: parent.width;
                    height: parent.height;
                    labels: root.labels;
                    datasets: [{
                        label: root.metric,
                        values: root.show-requests ? root.request-counts : root.token-counts,
                        series-type: root.show-line ? ChartSeriesType.line : ChartSeriesType.bar,
                        color: root.show-requests ? Theme.series-b : Theme.accent,
                        fill: root.show-line,
                    }];
                    begin-at-zero: true;
                    integer-ticks: true;
                    value-decimals: 0;
                    show-legend: false;
                    show-points: false;
                    show-tooltip: false;
                    animated: root.allow-motion;
                    bar-radius: 4px;
                    fill-opacity: root.show-line ? 0.14 : 0.78;
                    accessible-label: "用量趋势图";
                    accessible-description: root.has-selection
                        ? root.selection-label + "，" + root.selection-value + "。" + root.keyboard-help
                        : root.keyboard-help;
                    category-clicked(index) => {
                        if (index == root.pinned) {
                            root.pinned = -1;
                        } else if (index >= 0 && index < root.points.length) {
                            root.pinned = index;
                            root.pinned-label = root.points[index].detail-label;
                        }
                    }
                }
            }

            selection := Rectangle {
                visible: root.has-data;
                height: root.has-data ? 58px : 0px;

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 40px;
                    spacing: 8px;
                    Hint {
                        text: root.has-selection ? root.selection-label : "悬停查看数值";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    DataText {
                        text: root.selection-value;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                    unpin := ActionButton {
                        visible: root.can-unpin;
                        quiet: true;
                        label: "取消固定";
                        icon: "close";
                        icon-only: true;
                        tooltip: "取消固定";
                        width: Theme.icon-button;
                        height: Theme.icon-button;
                        clicked => { root.pinned = -1; }
                    }
                }

                Hint {
                    y: 40px;
                    width: parent.width;
                    height: 18px;
                    text: "← → 切换时段 · Enter 固定 · Esc 取消固定";
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }

            if root.has-data && !root.status-text.is-empty : Hint {
                text: root.status-text;
                color: root.status-tone;
            }
        }
    }
}
