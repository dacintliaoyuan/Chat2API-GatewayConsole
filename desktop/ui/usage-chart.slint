import { ListView } from "std-widgets.slint";
import { BarChart, ChartDataset, ChartSeriesType } from "@slintplot";
import { Theme, Panel, Heading, Hint, DataText, Segmented, ActionButton, SectionLabel } from "theme.slint";

export struct UsagePoint {
    label: string,
    detail-label: string,
    token-value: string,
    request-value: string,
    token-count: float,
    request-count: float,
}

export struct RequestMetric {
    label: string,
    value: string,
    detail: string,
}

export struct RequestPoint {
    label: string,
    token-value: string,
    request-value: string,
    speed-value: string,
    token-count: float,
    request-count: float,
    speed-count: float,
}

export struct ModelSpeedRow {
    model: string,
    requests: string,
    output: string,
    speed: string,
    first-token: string,
}

// Request-page analytics: four metric cards, a Token/请求/速度 chart with an
// optional per-model split, and the per-model speed table.
export component RequestAnalytics inherits Panel {
    // The request page gives the list the remaining height; at the minimum
    // window size this card may clip instead of pushing the status row down.
    min-height: 0px;
    in property <[RequestMetric]> metrics;
    in property <[RequestPoint]> points;
    in property <[string]> labels;
    in property <[float]> token-counts;
    in property <[float]> request-counts;
    in property <[float]> speed-counts;
    in property <[ChartDataset]> token-series;
    in property <[ChartDataset]> request-series;
    in property <[ChartDataset]> speed-series;
    in property <[ModelSpeedRow]> model-speeds;
    in-out property <int> metric: 0;
    in-out property <bool> split-by-model: false;
    in property <bool> allow-motion: true;
    in property <string> status-text;
    in property <color> status-tone: Theme.muted;

    out property <int> metric-index: root.metric;
    out property <bool> split: root.split-by-model;
    out property <string> metric-label: root.metric == 1 ? "请求数"
        : root.metric == 2 ? "输出速度" : "Token";
    out property <[float]> plotted-values: root.metric == 1 ? root.request-counts
        : root.metric == 2 ? root.speed-counts : root.token-counts;
    out property <int> series-count: !root.split-by-model ? 1
        : root.metric == 1 ? root.request-series.length
        : root.metric == 2 ? root.speed-series.length
        : root.token-series.length;
    out property <int> model-row-count: root.model-speeds.length;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            for metric in root.metrics : Rectangle {
                horizontal-stretch: 1;
                height: 62px;
                border-radius: 8px;
                background: Theme.surface-2;
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    Hint { text: metric.label; }
                    DataText {
                        text: metric.value;
                        font-size: 18px;
                        font-weight: 650;
                        overflow: elide;
                    }
                    Hint { text: metric.detail; overflow: elide; wrap: no-wrap; }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Heading { text: "请求趋势"; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Segmented {
                width: 196px;
                options: [{ text: "Token" }, { text: "请求数" }, { text: "速度" }];
                label: "请求指标";
                current-index: root.metric;
                selected(index) => { root.metric = index; }
            }
            Segmented {
                width: 148px;
                options: [{ text: "合计" }, { text: "按模型" }];
                label: "拆分维度";
                current-index: root.split-by-model ? 1 : 0;
                selected(index) => { root.split-by-model = index == 1; }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            height: 148px;

            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                BarChart {
                    width: parent.width;
                    height: parent.height;
                    labels: root.labels;
                    datasets: root.split-by-model
                        ? (root.metric == 1 ? root.request-series
                            : root.metric == 2 ? root.speed-series : root.token-series)
                        : [{
                            label: root.metric-label,
                            values: root.metric == 1 ? root.request-counts
                                : root.metric == 2 ? root.speed-counts : root.token-counts,
                            series-type: ChartSeriesType.bar,
                            color: root.metric == 1 ? Theme.series-b : Theme.accent,
                        }];
                    begin-at-zero: true;
                    integer-ticks: root.metric != 2;
                    value-decimals: root.metric == 2 ? 1 : 0;
                    show-legend: root.split-by-model;
                    show-points: false;
                    show-tooltip: false;
                    animated: root.allow-motion;
                    bar-radius: 3px;
                    fill-opacity: 0.78;
                    accessible-label: "请求趋势图";
                }
            }

            VerticalLayout {
                width: 336px;
                spacing: 3px;
                SectionLabel { text: "模型速度"; }
                HorizontalLayout {
                    spacing: 6px;
                    Hint { text: "模型"; horizontal-stretch: 1; }
                    Hint { text: "请求"; width: 44px; horizontal-alignment: right; }
                    Hint { text: "输出"; width: 58px; horizontal-alignment: right; }
                    Hint { text: "速度"; width: 58px; horizontal-alignment: right; }
                    Hint { text: "首字"; width: 62px; horizontal-alignment: right; }
                }
                ListView {
                    height: 112px;
                    for row in root.model-speeds : HorizontalLayout {
                        spacing: 6px;
                        height: 20px;
                        Text {
                            text: row.model;
                            color: Theme.ink;
                            font-size: 12px;
                            horizontal-stretch: 1;
                            overflow: elide;
                            wrap: no-wrap;
                        }
                        DataText { text: row.requests; width: 44px; horizontal-alignment: right; }
                        DataText { text: row.output; width: 58px; horizontal-alignment: right; }
                        DataText { text: row.speed; width: 58px; horizontal-alignment: right; }
                        DataText { text: row.first-token; width: 62px; horizontal-alignment: right; }
                    }
                }
                if root.model-speeds.length == 0 : Hint {
                    text: "暂无模型速度数据";
                }
            }
        }

        if !root.status-text.is-empty : Hint {
            text: root.status-text;
            color: root.status-tone;
        }
    }
}

export component UsageChart inherits Panel {
    in-out property <int> period: 0;
    in property <[UsagePoint]> points;
    in property <[string]> labels;
    in property <[float]> token-counts;
    in property <[float]> request-counts;
    in property <string> token-total: "—";
    in property <string> request-total: "—";
    in property <bool> loading;
    in property <string> status-text;
    in property <color> status-tone: Theme.muted;
    in property <bool> allow-motion;
    in-out property <bool> show-requests;
    in-out property <bool> show-line;
    callback period-changed(int);

    private property <int> pinned: -1;
    private property <string> pinned-label;
    private property <int> key-index: -1;
    // The selection block animates for 160 ms; the data swap waits for it so
    // the chart and the block never disagree about which range is selected.
    private property <int> pending-period: -1;
    period-sync-timer := Timer {
        interval: Theme.settle;
        running: false;
        triggered => {
            if (root.pending-period >= 0) {
                root.period-changed(root.pending-period);
                root.pending-period = -1;
            }
        }
    }
    private property <int> active: root.pinned >= 0 ? root.pinned
        : root.key-index >= 0 ? root.key-index : plot.hovered-index;
    private property <bool> has-data: root.points.length > 0;
    private property <bool> has-selection: root.active >= 0 && root.active < root.points.length;
    private property <string> metric: root.show-requests ? "请求数" : "Token";
    private property <string> keyboard-help: "左右方向键查看时段 · Enter 固定 · Esc 取消固定";
    private property <string> empty-title: root.loading ? "正在读取本实例用量…"
        : !root.status-text.is-empty ? root.status-text : "暂无用量数据";

    out property <length> plot-x: plot.absolute-position.x;
    out property <length> plot-y: plot.absolute-position.y;
    out property <length> plot-width: plot.width;
    out property <length> plot-height: plot.height;
    out property <length> unpin-x: unpin.absolute-position.x;
    out property <length> unpin-y: unpin.absolute-position.y;
    out property <length> unpin-width: unpin.width;
    out property <length> unpin-height: unpin.height;
    out property <length> period-x: period-control.absolute-position.x;
    out property <length> period-y: period-control.absolute-position.y;
    out property <length> period-width: period-control.width;
    out property <int> pinned-index: root.pinned;
    out property <int> active-index: root.active;
    out property <bool> can-unpin: root.pinned >= 0 && root.has-selection;
    out property <string> selection-label: root.has-selection ? root.points[root.active].detail-label : "";
    out property <string> selection-value: !root.has-selection ? ""
        : root.show-requests ? root.points[root.active].request-value : root.points[root.active].token-value;

    preferred-height: root.width < 670px ? 408px : 368px;
    vertical-stretch: 0;
    // The chart card is a keyboard stop: Tab reaches it, the ring is the same
    // neutral edge step as the other focusable surfaces.
    border-color: chart-focus.has-focus ? Theme.edge-strong : Theme.edge;
    animate preferred-height { duration: Theme.settle; easing: ease-out; }
    animate border-color { duration: Theme.quick; easing: ease-in-out; }

    changed period => { root.pinned = -1; root.key-index = -1; }
    changed points => {
        root.key-index = -1;
        if (root.pinned >= root.points.length
            || (root.pinned >= 0 && root.points[root.pinned].detail-label != root.pinned-label)) {
            root.pinned = -1;
        }
    }
    changed show-requests => { metric-control.current-index = root.show-requests ? 1 : 0; }
    changed show-line => { type-control.current-index = root.show-line ? 1 : 0; }

    chart-focus := FocusScope {
        focus-on-click: false;
        accessible-role: groupbox;
        accessible-label: "用量趋势图";
        key-pressed(event) => {
            if (event.text == Key.Escape && root.pinned >= 0) {
                root.pinned = -1;
                return accept;
            }
            if (root.points.length == 0) { return reject; }
            if (event.text == Key.Home) {
                root.key-index = 0;
                return accept;
            }
            if (event.text == Key.End) {
                root.key-index = root.points.length - 1;
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.key-index = root.key-index <= 0 ? 0 : root.key-index - 1;
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.key-index = root.key-index < 0 ? 0
                    : root.key-index + 1 < root.points.length ? root.key-index + 1
                    : root.points.length - 1;
                return accept;
            }
            if (event.text == Key.Return && root.active >= 0 && root.active < root.points.length) {
                root.pinned = root.active;
                root.pinned-label = root.points[root.active].detail-label;
                return accept;
            }
            return reject;
        }

        // Clicking the card background moves keyboard focus here; the plot's own
        // pointer handling stays on top of this transparent target.
        chart-pointer := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { chart-focus.focus(); }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    spacing: 3px;
                    Heading { text: "用量趋势"; }
                    Hint { text: root.period <= 1 ? "北京时间 · 按小时" : "北京时间 · 按天"; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: end;
                    spacing: 2px;
                    Hint { text: root.show-requests ? "请求总数" : "Token 总量"; horizontal-alignment: right; }
                    DataText {
                        text: root.show-requests ? root.request-total : root.token-total;
                        font-size: 21px;
                        font-weight: 650;
                        horizontal-alignment: right;
                    }
                }
            }

            FlexboxLayout {
                flex-wrap: wrap;
                spacing: 8px;
                period-control := Segmented {
                    width: 300px;
                    options: [{ text: "今天" }, { text: "24 小时" }, { text: "7 天" }, { text: "30 天" }, { text: "全部" }];
                    label: "用量时间范围";
                    current-index <=> root.period;
                    selected(index) => {
                        root.pending-period = index;
                        period-sync-timer.start();
                    }
                }
                metric-control := Segmented {
                    width: 188px;
                    options: [{ text: "Token" }, { text: "请求数" }];
                    label: "用量指标";
                    current-index: root.show-requests ? 1 : 0;
                    selected(index) => { root.show-requests = index == 1; }
                }
                type-control := Segmented {
                    width: 192px;
                    options: [{ text: "柱状图" }, { text: "折线图" }];
                    label: "图表类型";
                    current-index: root.show-line ? 1 : 0;
                    selected(index) => { root.show-line = index == 1; }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 142px;

                VerticalLayout {
                    visible: !root.has-data;
                    alignment: center;
                    spacing: 3px;
                    Hint {
                        text: root.empty-title;
                        color: root.loading ? Theme.muted : root.status-tone;
                        horizontal-alignment: center;
                    }
                    if !root.loading && root.status-text.is-empty : Hint {
                        text: "调用模型后这里会显示用量趋势";
                        horizontal-alignment: center;
                    }
                }

                plot := BarChart {
                    visible: root.has-data;
                    width: parent.width;
                    height: parent.height;
                    labels: root.labels;
                    datasets: [{
                        label: root.metric,
                        values: root.show-requests ? root.request-counts : root.token-counts,
                        series-type: root.show-line ? ChartSeriesType.line : ChartSeriesType.bar,
                        color: root.show-requests ? Theme.series-b : Theme.accent,
                        fill: root.show-line,
                    }];
                    begin-at-zero: true;
                    integer-ticks: true;
                    value-decimals: 0;
                    show-legend: false;
                    show-points: false;
                    show-tooltip: false;
                    animated: root.allow-motion;
                    bar-radius: 4px;
                    fill-opacity: root.show-line ? 0.14 : 0.78;
                    accessible-label: "用量趋势图";
                    accessible-description: root.has-selection
                        ? root.selection-label + "，" + root.selection-value + "。" + root.keyboard-help
                        : root.keyboard-help;
                    category-clicked(index) => {
                        if (index == root.pinned) {
                            root.pinned = -1;
                        } else if (index >= 0 && index < root.points.length) {
                            root.pinned = index;
                            root.pinned-label = root.points[index].detail-label;
                        }
                    }
                }
            }

            Rectangle {
                visible: root.has-data;
                height: root.has-data ? 58px : 0px;

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 40px;
                    spacing: 8px;
                    Hint {
                        text: root.has-selection ? root.selection-label : "悬停查看数值";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    DataText {
                        text: root.selection-value;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                    unpin := ActionButton {
                        visible: root.can-unpin;
                        quiet: true;
                        label: "取消固定";
                        icon: "close";
                        icon-only: true;
                        tooltip: "取消固定";
                        width: Theme.icon-button;
                        height: Theme.icon-button;
                        clicked => { root.pinned = -1; }
                    }
                }

                Hint {
                    y: 40px;
                    width: parent.width;
                    height: 18px;
                    text: "← → 切换时段 · Enter 固定 · Esc 取消固定";
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }

            if root.has-data && !root.status-text.is-empty : Hint {
                text: root.status-text;
                color: root.status-tone;
            }
        }
    }
}
