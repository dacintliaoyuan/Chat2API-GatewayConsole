import { Button, CheckBox, LineEdit, ListView } from "std-widgets.slint";

export struct LogRow {
    at: string,
    level: string,
    text: string,
}

global Palette {
    out property <color> background: #f4f6fa;
    out property <color> surface: #ffffff;
    out property <color> border: #dce2ed;
    out property <color> ink: #19222e;
    out property <color> muted: #515d70;
    out property <color> accent: #1b5ccc;
    out property <color> accent-soft: #e6eefc;
    out property <color> good: #176a3c;
    out property <color> bad: #b42318;
    out property <color> warn: #8b4c0c;
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 34px;
    border-radius: 6px;
    background: root.active ? Palette.accent-soft : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: root.active ? 650 : 500;
        color: root.active ? Palette.accent : Palette.ink;
        vertical-alignment: center;
        x: 10px;
        width: parent.width - 20px;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component Card inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <color> tone: Palette.accent;

    height: 86px;
    border-radius: 10px;
    background: Palette.surface;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 10px;
        spacing: 3px;
        Text {
            text: root.label;
            font-size: 12px;
            color: Palette.muted;
        }
        Text {
            text: root.value;
            font-size: 16px;
            font-weight: 650;
            color: root.tone;
            overflow: elide;
        }
        Text {
            text: root.detail;
            font-size: 11px;
            color: Palette.muted;
            overflow: elide;
        }
    }
}

component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    alignment: start;
    spacing: 2px;
    Text {
        text: root.title;
        font-size: 19px;
        font-weight: 700;
        color: Palette.ink;
    }
    Text {
        text: root.subtitle;
        font-size: 12px;
        color: Palette.muted;
    }
}

export component MainWindow inherits Window {
    title: "本机控制台";
    width: 1060px;
    height: 720px;
    background: Palette.background;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    in-out property <int> page: 0;
    in property <string> gateway-value: "检测中";
    in property <string> gateway-detail: "";
    in property <color> gateway-tone: Palette.warn;
    in property <string> supervision-value: "检测中";
    in property <string> supervision-detail: "";
    in property <color> supervision-tone: Palette.warn;
    in property <string> auth-value: "读取中";
    in property <string> auth-detail: "";
    in property <color> auth-tone: Palette.warn;
    in property <string> upstream-value: "读取中";
    in property <string> upstream-detail: "";
    in property <color> upstream-tone: Palette.warn;
    in property <string> account-label: "读取中";
    in property <string> account-detail: "";
    in property <color> account-tone: Palette.warn;
    in property <string> account-saved: "未保存账号";
    in property <string> account-saved-detail: "";
    in property <string> account-state: "认证状态读取中";
    in property <string> account-state-detail: "";
    in property <color> account-state-tone: Palette.warn;
    in property <bool> account-can-clear: false;
    in property <bool> account-can-continue: false;
    in property <bool> account-form-visible: false;
    in-out property <string> credential-account-input: "";
    in-out property <string> credential-password-input: "";
    in property <bool> password-visible: false;
    in property <string> credential-status: "";
    in property <color> credential-tone: Palette.muted;
    in property <string> account-note: "首次打开可跳过登录；之后可从「配置账号」进入。账号密码只保存在本机，并交给本实例网关使用。";
    in property <string> status-line: "正在启动本实例网关";
    in property <string> last-update: "—";
    in property <string> log-status: "尚未读取日志";
    in property <color> log-tone: Palette.muted;
    in property <[LogRow]> logs: [];
    in-out property <string> port-input: "7999";
    in property <string> settings-status: "";
    in property <color> settings-tone: Palette.muted;
    in property <string> config-path: "";
    in property <string> instance-path: "";

    callback navigate(int);
    callback configure-account();
    callback open-account-form();
    callback close-account-form();
    callback save-credentials(string, string);
    callback clear-credentials();
    callback continue-login();
    callback toggle-password-visible();
    callback save-port(string);
    callback refresh-logs();
    callback hide-requested();
    callback quit-requested();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: start;
                spacing: 1px;
                Text {
                    text: "本机控制台";
                    font-size: 20px;
                    font-weight: 700;
                    color: Palette.ink;
                }
                Text {
                    text: "桌面版 · 本实例网关监督";
                    font-size: 12px;
                    color: Palette.muted;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "隐藏到托盘";
                clicked => { root.hide-requested(); }
            }
            Button {
                text: "退出 App";
                clicked => { root.quit-requested(); }
            }
        }

        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                width: 168px;
                border-radius: 10px;
                background: Palette.surface;
                border-width: 1px;
                border-color: Palette.border;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    NavItem {
                        label: "总览";
                        active: root.page == 0;
                        clicked => { root.navigate(0); }
                    }
                    NavItem {
                        label: "运行日志";
                        active: root.page == 1;
                        clicked => { root.navigate(1); }
                    }
                    NavItem {
                        label: "模型与设置";
                        active: root.page == 2;
                        clicked => { root.navigate(2); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: "关闭窗口后收起到托盘";
                        font-size: 11px;
                        color: Palette.muted;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                border-radius: 10px;

                VerticalLayout {
                    visible: root.page == 0;
                    spacing: 12px;

                    Rectangle {
                        height: 56px;
                        border-radius: 10px;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.border;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "UM 账号";
                                font-size: 12px;
                                color: Palette.muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.account-label;
                                font-size: 15px;
                                font-weight: 650;
                                color: root.account-tone;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.account-detail;
                                font-size: 12px;
                                color: Palette.muted;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "配置账号";
                                clicked => { root.configure-account(); }
                            }
                            Button {
                                text: "继续登录";
                                visible: root.account-can-continue;
                                clicked => { root.continue-login(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Card {
                            label: "本实例网关";
                            value: root.gateway-value;
                            detail: root.gateway-detail;
                            tone: root.gateway-tone;
                            horizontal-stretch: 1;
                        }
                        Card {
                            label: "网关监督";
                            value: root.supervision-value;
                            detail: root.supervision-detail;
                            tone: root.supervision-tone;
                            horizontal-stretch: 1;
                        }
                        Card {
                            label: "UM 认证";
                            value: root.auth-value;
                            detail: root.auth-detail;
                            tone: root.auth-tone;
                            horizontal-stretch: 1;
                        }
                        Card {
                            label: "上游";
                            value: root.upstream-value;
                            detail: root.upstream-detail;
                            tone: root.upstream-tone;
                            horizontal-stretch: 1;
                        }
                    }

                    Text {
                        text: root.account-note;
                        font-size: 12px;
                        color: Palette.muted;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                VerticalLayout {
                    visible: root.page == 1;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        PageTitle {
                            title: "请求与诊断";
                            subtitle: "本实例运行日志 · 最近记录（#126 接入实时增量）";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "刷新";
                            clicked => { root.refresh-logs(); }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 10px;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.border;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.log-status;
                                    font-size: 12px;
                                    color: root.log-tone;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: root.logs.length + " 条";
                                    font-size: 12px;
                                    color: Palette.muted;
                                    vertical-alignment: center;
                                }
                            }
                            ListView {
                                vertical-stretch: 1;
                                for row in root.logs : Rectangle {
                                    height: 25px;
                                    width: parent.width;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: row.at;
                                            width: 92px;
                                            font-size: 11px;
                                            color: Palette.muted;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.level;
                                            width: 58px;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: row.level == "ERROR" ? Palette.bad : row.level == "WARN" ? Palette.warn : Palette.muted;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.text;
                                            horizontal-stretch: 1;
                                            font-size: 12px;
                                            color: Palette.ink;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    visible: root.page == 2;
                    spacing: 12px;

                    PageTitle {
                        title: "模型与设置";
                        subtitle: "本实例的 UM 账号与模型 API 端口";
                    }

                    Rectangle {
                        border-radius: 10px;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.border;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            Text {
                                text: "UM 账号";
                                font-size: 14px;
                                font-weight: 650;
                                color: Palette.ink;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "已保存账号";
                                    font-size: 12px;
                                    color: Palette.muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.account-saved;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Palette.ink;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.account-state;
                                    font-size: 13px;
                                    font-weight: 650;
                                    color: root.account-state-tone;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.account-saved-detail;
                                visible: !root.account-saved-detail.is-empty;
                                font-size: 12px;
                                color: Palette.bad;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.account-state-detail;
                                font-size: 12px;
                                color: Palette.muted;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: root.account-can-clear ? "更新账号密码" : "配置账号";
                                    clicked => { root.open-account-form(); }
                                }
                                Button {
                                    text: "继续登录";
                                    enabled: root.account-can-continue;
                                    clicked => { root.continue-login(); }
                                }
                                Button {
                                    text: "清除已保存的账号密码";
                                    enabled: root.account-can-clear;
                                    clicked => { root.clear-credentials(); }
                                }
                            }
                            Text {
                                text: root.credential-status;
                                visible: !root.credential-status.is-empty;
                                font-size: 12px;
                                color: root.credential-tone;
                                wrap: word-wrap;
                            }
                            if root.account-form-visible : Rectangle {
                                border-radius: 8px;
                                background: Palette.background;
                                border-width: 1px;
                                border-color: Palette.border;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;
                                    Text {
                                        text: "录入 UM 账号密码";
                                        font-size: 13px;
                                        font-weight: 650;
                                        color: Palette.ink;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: "账号";
                                            width: 42px;
                                            font-size: 13px;
                                            color: Palette.ink;
                                            vertical-alignment: center;
                                        }
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            text: root.credential-account-input;
                                            placeholder-text: "UMPASS 账号";
                                            edited(text) => { root.credential-account-input = text; }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: "密码";
                                            width: 42px;
                                            font-size: 13px;
                                            color: Palette.ink;
                                            vertical-alignment: center;
                                        }
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            text: root.credential-password-input;
                                            input-type: root.password-visible ? InputType.text : InputType.password;
                                            placeholder-text: "UMPASS 密码";
                                            edited(text) => { root.credential-password-input = text; }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        CheckBox {
                                            text: "显示密码";
                                            checked: root.password-visible;
                                            toggled => { root.toggle-password-visible(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Button {
                                            text: "保存账号";
                                            clicked => { root.save-credentials(root.credential-account-input, root.credential-password-input); }
                                        }
                                        Button {
                                            text: "取消";
                                            clicked => { root.close-account-form(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 10px;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.border;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            Text {
                                text: "模型 API 端口";
                                font-size: 14px;
                                font-weight: 650;
                                color: Palette.ink;
                            }
                            Text {
                                text: "只绑定本机回环，默认 127.0.0.1:7999；测试实例可用 7998。保存后停止旧实例并在新端口启动；失败会恢复原端口。";
                                font-size: 12px;
                                color: Palette.muted;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "127.0.0.1:";
                                    font-size: 13px;
                                    color: Palette.ink;
                                    vertical-alignment: center;
                                }
                                LineEdit {
                                    width: 96px;
                                    text: root.port-input;
                                    edited(text) => { root.port-input = text; }
                                }
                                Button {
                                    text: "保存";
                                    clicked => { root.save-port(root.port-input); }
                                }
                            }
                            Text {
                                text: root.settings-status;
                                font-size: 12px;
                                color: root.settings-tone;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "配置文件：" + root.config-path;
                                font-size: 11px;
                                color: Palette.muted;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "实例数据：" + root.instance-path;
                                font-size: 11px;
                                color: Palette.muted;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.status-line;
                font-size: 12px;
                color: Palette.muted;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: "最近更新 " + root.last-update;
                font-size: 12px;
                color: Palette.muted;
                vertical-alignment: center;
            }
        }
    }
}
