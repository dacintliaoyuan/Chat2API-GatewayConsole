    out property <length> um-service-start-gateway-y: start-gateway.absolute-position.y;
    out property <length> um-service-start-gateway-width: start-gateway.width;
    out property <length> um-service-start-gateway-height: start-gateway.height;
    out property <length> usage-metric-x: usage-chart.metric-x;
    out property <length> usage-metric-y: usage-chart.metric-y;
    out property <length> usage-metric-width: usage-chart.metric-width;
    out property <length> usage-metric-height: usage-chart.metric-height;
    out property <length> usage-controls-y: usage-chart.controls-y;
    out property <length> usage-controls-height: usage-chart.controls-height;
