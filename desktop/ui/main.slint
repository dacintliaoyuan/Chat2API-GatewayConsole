    out property <bool> um-service-start-visible: start-um-service.visible;
    out property <string> um-service-start-label: start-um-service.label;
    out property <bool> um-service-start-gateway-visible: start-gateway.visible;
    out property <string> um-service-start-gateway-label: start-gateway.label;
    out property <length> um-service-start-x: start-um-service.absolute-position.x;
    out property <length> um-service-start-y: start-um-service.absolute-position.y;
    out property <length> um-service-start-width: start-um-service.width;
    out property <length> um-service-start-height: start-um-service.height;
