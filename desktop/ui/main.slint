    callback refresh-login-rounds();
    callback open-login-round(string);
    out property <length> login-rounds-list-height: login-rounds-list.height;
    out property <length> login-rounds-row-height: root.compact ? 72px : 44px;
    in property <string> config-path;
    in property <string> instance-path;
    // Test seam: the layout tests expand the instance card without a pointer.
    in-out property <bool> show-technical;
    in property <bool> tray-available: true;

    // Test seam: geometry and focus facts the keyboard/layout tests assert on.
    out property <length> overview-content-height: overview-content.preferred-height;
    out property <length> overview-viewport-height: overview-scroll.visible-height;
    out property <length> overview-scroll-content-height: overview-scroll.content-height;
