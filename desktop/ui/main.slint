    out property <bool> log-refresh-enabled: log-refresh.enabled;
    out property <length> settings-refresh-x: settings-refresh.absolute-position.x;
    out property <length> settings-refresh-y: settings-refresh.absolute-position.y;
    out property <length> settings-refresh-width: settings-refresh.width;
    out property <length> settings-refresh-height: settings-refresh.height;
    out property <bool> settings-refresh-enabled: settings-refresh.enabled;
    // Test seams: the settings catalog's table, empty state, stale mark and detail.
    out property <int> um-model-row-count: root.um-models.length;
    out property <bool> um-model-table-visible: um-model-list.visible;
    out property <bool> um-model-empty-visible: um-model-empty.visible;
    out property <bool> um-model-stale-visible: um-model-stale-tag.visible;
    out property <bool> um-model-refresh-enabled: um-model-refresh.enabled;
    out property <length> um-model-refresh-x: um-model-refresh.absolute-position.x;
    out property <length> um-model-refresh-y: um-model-refresh.absolute-position.y;
    out property <length> um-model-refresh-width: um-model-refresh.width;
    out property <length> um-model-refresh-height: um-model-refresh.height;
    out property <length> um-model-list-x: um-model-list.absolute-position.x;
    out property <length> um-model-list-y: um-model-list.absolute-position.y;
    out property <length> um-model-list-width: um-model-list.width;
    out property <length> um-model-list-height: um-model-list.height;
    out property <bool> um-model-detail-visible: um-model-detail.visible;
    out property <string> um-model-detail-title-text: um-model-detail.title;
    out property <string> um-model-detail-body: um-model-detail.body;
    // Test seams: the context-probe batch list, selection, run/stop controls and
    // the collapsible history. The visible properties are the user-facing facts.
    out property <int> probe-row-count: root.probe-models.length;
    out property <bool> probe-list-visible: probe-model-list.visible;
    out property <bool> probe-empty-visible: probe-empty.visible;
    out property <string> probe-selection-text: "已选 " + root.probe-selected.length + " 个";
    out property <bool> probe-run-enabled:
        root.probe-selected.length > 0 && !root.probe-loading && !root.probe-running;
    out property <bool> probe-stop-visible: root.probe-running;
    out property <bool> probe-stop-enabled: !root.probe-stop-requested;
    out property <bool> probe-history-visible: probe-history-body.visible;
    out property <bool> probe-history-empty-visible: probe-history-empty.visible;
    out property <int> probe-history-count: root.probe-history.length;
    out property <length> probe-list-x: probe-model-list.absolute-position.x;
    out property <length> probe-list-y: probe-model-list.absolute-position.y;
    out property <length> probe-list-width: probe-model-list.width;
    out property <length> probe-list-height: probe-model-list.height;
    out property <length> probe-select-all-x: probe-select-all.absolute-position.x;
    out property <length> probe-select-all-y: probe-select-all.absolute-position.y;
    out property <length> probe-select-all-width: probe-select-all.width;
    out property <length> probe-select-all-height: probe-select-all.height;
    out property <length> probe-run-x: probe-run.absolute-position.x;
    out property <length> probe-run-y: probe-run.absolute-position.y;
    out property <length> probe-run-width: probe-run.width;
    out property <length> probe-run-height: probe-run.height;
    out property <length> probe-clear-x: probe-clear.absolute-position.x;
    out property <length> probe-clear-y: probe-clear.absolute-position.y;
    out property <length> probe-clear-width: probe-clear.width;
    out property <length> probe-clear-height: probe-clear.height;
    out property <length> probe-stop-x: probe-stop.absolute-position.x;
    out property <length> probe-stop-y: probe-stop.absolute-position.y;
    out property <length> probe-stop-width: probe-stop.width;
    out property <length> probe-stop-height: probe-stop.height;
    out property <length> probe-history-toggle-x: probe-history-toggle.absolute-position.x;
    out property <length> probe-history-toggle-y: probe-history-toggle.absolute-position.y;
    out property <length> probe-history-toggle-width: probe-history-toggle.width;
    out property <length> probe-history-toggle-height: probe-history-toggle.height;
    out property <length> theme-mode-x: theme-mode-control.absolute-position.x;
    out property <length> theme-mode-y: theme-mode-control.absolute-position.y;
    out property <length> theme-mode-width: theme-mode-control.width;
    out property <length> theme-mode-height: theme-mode-control.height;
    // Test seams: acknowledgement state and the geometry of the new controls.
    out property <bool> request-detail-copied: request-details.copied;
    out property <length> request-detail-copy-x: request-details.copy-x;
    out property <length> request-detail-copy-y: request-details.copy-y;
    out property <length> request-detail-copy-width: request-details.copy-width;
    out property <length> request-detail-copy-height: request-details.copy-height;
    out property <bool> log-detail-copied: log-details.copied;
    out property <string> account-state-detail-text: root.account-state-detail();
    out property <bool> request-search-clear-visible: request-search.clear-visible;
    out property <length> request-search-clear-x: request-search.clear-x;
    out property <length> request-search-clear-y: request-search.clear-y;
    out property <length> request-search-clear-width: request-search.clear-width;
    out property <length> request-search-clear-height: request-search.clear-height;
    out property <bool> help-visible: help-scroll.visible;
    out property <bool> quit-confirm-visible: root.confirm-quit;
    out property <length> quit-button-x: quit-button.absolute-position.x;
    out property <length> quit-button-y: quit-button.absolute-position.y;
    out property <length> quit-button-width: quit-button.width;
    out property <length> quit-button-height: quit-button.height;
    out property <length> quit-confirm-x: quit-confirm-button.absolute-position.x;
    out property <length> quit-confirm-y: quit-confirm-button.absolute-position.y;
    out property <length> quit-confirm-width: quit-confirm-button.width;
    out property <length> quit-confirm-height: quit-confirm-button.height;

    callback navigate(int);
    callback configure-account();
    callback skip-login();
    callback open-account-form();
    callback close-account-form();
    callback save-credentials(string, string);
    callback clear-credentials();
    callback continue-login();
    callback verify-login();
    callback toggle-password-visible();
    callback save-port(string);
    callback refresh-overview();
    callback refresh-requests();
    callback load-earlier-requests();
    callback refresh-settings();
    callback refresh-page();
    callback refresh-logs();
    callback select-log-mode(int);
    callback select-log-range(int);
    callback toggle-log-level(int);
    callback sync-log-level();
    callback query-log-history();
    callback load-earlier-logs();
    callback query-requests(int);
    callback open-request(string);
    callback usage-range-changed(int);
    callback copy-text(string);
    callback theme-mode-changed(int);
    callback theme-dark-changed(bool);
    callback quit-requested();

    changed account-form-visible => {
        if (root.account-form-visible) {
            root.confirm-clear = false;
            if (root.credential-account-input.is-empty) { account-input.take-focus(); }
            else { password-input.take-focus(); }
        } else if (root.page == 2) {
            edit-account.take-focus();
        }
    }
    changed log-version => {
        if (root.log-mode == 0 && root.log-follow && root.logs.length > 0) {
            log-list.ensure-row-visible(root.logs.length - 1, ScrollBehavior.instant);
        }
    }
    changed page => {
        root.confirm-clear = false;
        root.confirm-quit = false;
        root.apply-chart-theme();
        if (root.page == 3 && root.log-mode == 0 && root.log-follow && root.logs.length > 0) {
            log-list.ensure-row-visible(root.logs.length - 1, ScrollBehavior.instant);
        }
        if (root.page == 2 && root.account-form-visible) {
            if (root.credential-account-input.is-empty) { account-input.take-focus(); }
            else { password-input.take-focus(); }
        }
    }
    // The chart owns a second palette, and the native title bar needs the same
    // dark/light step; both follow the one derived value.
    changed theme-dark => {
        root.apply-chart-theme();
        root.theme-dark-changed(root.theme-dark);
    }
    public function navigate-to(page: int) {
        if (root.page == page) { return; }
        if (!root.allow-motion) { root.navigate(page); return; }
        root.pending-page = page;
        // Fade to 35% instead of zero: the timer that swaps the page starts
        // on the next event-loop pass, so a full fade would leave one blank
        // frame between the old page disappearing and the new one appearing.
        root.page-opacity = 0.35;
        page-out-timer.start();
    }
    // Clear the previous result before asking the shell, so copying the same URL
    // twice still starts a fresh two-second feedback window.
    function request-copy(url: string, target: int) {
        root.copy-ok = false;
        root.copy-error = "";
        root.base-copied = false;
        root.v1-copied = false;
        root.copy-target = target;
        root.copy-text(url);
    }
    changed copy-ok => {
        if (root.copy-ok) {
            root.base-copied = root.copy-target == 1;
            root.v1-copied = root.copy-target == 2;
            copy-status-timer.start();
        }
    }
    changed copy-error => {
        if (!root.copy-error.is-empty) {
            root.base-copied = false;
            root.v1-copied = false;
            copy-status-timer.start();
        }
    }
    // Fade the old page down, swap while it is dimmed, then fade the new page
    // back in. The title and the page host share page-opacity, so they move
    // together and the swap never shows a hard cut.
    page-out-timer := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            root.navigate(root.pending-page);
            root.page-opacity = 1;
            page-out-timer.running = false;
        }
    }
    // One root timer drives the shared breathing phase, so the dots keep pulsing
    // even when a nested component is not active.
    pulse-timer := Timer {
        interval: Theme.pulse;
        running: root.allow-motion;
        triggered => { Theme.pulse-on = !Theme.pulse-on; }
    }
    // The inline clear confirmation returns to the normal row after three
    // seconds without a second click.
    // The inline restart confirmation expires after three seconds, like the
    // credential clear.
    restart-confirm-timer := Timer {
        interval: 3s;
        running: false;
        triggered => { root.confirm-restart = false; restart-confirm-timer.running = false; }
    }
    clear-confirm-timer := Timer {
        interval: 3s;
        running: false;
        triggered => { root.confirm-clear = false; clear-confirm-timer.running = false; }
    }
    public pure function auto-refresh-index-for(seconds: int) -> int {
        return seconds == 15 ? 1 : seconds == 30 ? 2 : seconds == 60 ? 3 : seconds == 0 ? 4 : 0;
    }
    public pure function auto-refresh-seconds(index: int) -> int {
        return index == 1 ? 15 : index == 2 ? 30 : index == 3 ? 60 : index == 4 ? 0 : 5;
    }
    // A manual refresh acknowledges itself for 600 ms: four 90-degree steps,
    // then the icon returns to its normal affordance.
    public function begin-manual-refresh() {
        // Reset while the icon is still static, so a completed 360-degree turn
        // never animates backwards.
        root.refresh-rotation = 0deg;
        root.refreshing = true;
    }
    public function refresh-page-data() {
        if (root.page == 0) { root.refresh-overview(); }
        else if (root.page == 1) { root.refresh-requests(); }
        else if (root.page == 2) { root.refresh-settings(); }
        else if (root.page == 3) {
            if (root.log-mode == 0) { root.refresh-logs(); }
            else { root.query-log-history(); }
        }
    }
    public function refresh-current-page() {
        root.begin-manual-refresh();
        root.refresh-page-data();
    }
    changed auto-refresh => {
        root.auto-refresh-index = root.auto-refresh-index-for(root.auto-refresh);
        if (root.auto-refresh > 0 && !root.refresh-paused && !root.refreshing) {
            auto-refresh-timer.restart();
        }
        root.settings-changed();
    }
    changed auto-refresh-index => {
        root.auto-refresh = root.auto-refresh-seconds(root.auto-refresh-index);
    }
    changed usage-period => { root.settings-changed(); }
    changed request-period => { root.settings-changed(); }
    changed request-result => { root.settings-changed(); }
    changed request-keyword => { root.settings-changed(); }
    changed log-period => { root.settings-changed(); }
    changed log-filter-level => { root.settings-changed(); }
    changed log-filter-keyword => { root.settings-changed(); }
    changed log-level-error => { root.settings-changed(); }
    changed log-level-warn => { root.settings-changed(); }
    changed log-level-info => { root.settings-changed(); }
    changed log-level-debug => { root.settings-changed(); }
    changed refreshing => {
        if (root.refreshing) {
            root.refresh-rotation = 0deg;
            auto-refresh-timer.stop();
            refresh-timer.restart();
        } else {
            refresh-timer.stop();
            root.refresh-rotation = 0deg;
            // The manual refresh restarts the auto-refresh countdown.
            if (root.auto-refresh > 0 && !root.refresh-paused) {
                auto-refresh-timer.restart();
            }
        }
    }
    changed refresh-paused => {
        if (!root.refresh-paused) {
            // Returning from minimize/tray must not wait for the next interval.
            root.refresh-page-data();
            if (root.auto-refresh > 0) { auto-refresh-timer.restart(); }
        }
    }
    auto-refresh-timer := Timer {
        // A stopped timer must not get a zero interval; 1s is only a
        // placeholder while auto refresh is off.
        interval: root.auto-refresh > 0 ? root.auto-refresh * 1s : 1s;
        running: root.auto-refresh > 0 && !root.refresh-paused && !root.refreshing;
        triggered => {
            // A tick already queued when auto refresh was switched off or the
            // window was hidden must not refresh anything.
            if (root.auto-refresh > 0 && !root.refresh-paused && !root.refreshing) {
                root.refresh-overview();
            }
        }
    }
    refresh-timer := Timer {
        interval: 150ms;
        running: root.refreshing;
        triggered => {
            root.refresh-rotation += 90deg;
            if (root.refresh-rotation >= 360deg) {
                root.refreshing = false;
            }
        }
    }
    // The check and the copy status share one two-second window.
    copy-status-timer := Timer {
        interval: 2s;
        running: false;
        triggered => {
            root.copy-ok = false;
            root.copy-error = "";
            root.base-copied = false;
            root.v1-copied = false;
            copy-status-timer.running = false;
        }
    }
    // The refresh acknowledgement stays visible for 1.2 s, then the button
    // returns to its normal refresh affordance.
    log-refreshed-timer := Timer {
        interval: 1.2s;
        running: false;
        triggered => { root.log-refreshed = false; log-refreshed-timer.running = false; }
    }
    changed log-refreshed => { if (root.log-refreshed) { log-refreshed-timer.start(); } }
    // The tray-less exit confirmation expires after three seconds, like the
    // inline credential clear.
    quit-confirm-timer := Timer {
        interval: 3s;
        running: false;
        triggered => { root.confirm-quit = false; quit-confirm-timer.running = false; }
    }
    changed tray-available => { if (root.tray-available) { root.confirm-quit = false; } }

    root-focus := FocusScope {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                // Escape closes only the detail that belongs to the current page;
                // a hidden detail on another page must survive a page switch.
                if (root.page == 2 && root.account-form-visible) { root.close-account-form(); return accept; }
                if (root.page == 1 && !root.selected-request.is-empty) { root.selected-request = ""; return accept; }
                if (root.page == 3 && !root.open-log-id.is-empty) { root.open-log-id = ""; return accept; }
                return reject;
            }
            if (event.modifiers.control) {
                if (event.text == "1") { root.navigate-to(0); return accept; }
                if (event.text == "2") { root.navigate-to(1); return accept; }
                if (event.text == "3") { root.navigate-to(3); return accept; }
                if (event.text == "4") { root.navigate-to(2); return accept; }
                if (event.text == "r" || event.text == "R") { root.refresh-page(); return accept; }
                // Ctrl+F focuses the search field of the current page; inside a
                // text field the platform keeps its own find behavior.
                if ((event.text == "f" || event.text == "F")
                    && !request-search.has-focus && !log-search.has-focus
                    && !account-input.has-focus && !password-input.has-focus
                    && !port-input.has-focus) {
                    if (root.page == 1) { request-search.take-focus(); return accept; }
                    if (root.page == 3) { log-search.take-focus(); return accept; }
                }
            }
            return reject;
        }

    HorizontalLayout {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        alignment: stretch;
        rail := Rectangle {
            width: root.compact ? 84px : 196px;
            animate width { duration: Theme.motion ? 150ms : 0ms; easing: ease-in-out; }
            background: Theme.rail;
            VerticalLayout {
                padding-left: root.compact ? 6px : 14px;
                padding-right: root.compact ? 6px : 14px;
                padding-top: root.compact ? 6px : 14px;
                padding-bottom: root.compact ? 6px : 14px;
                animate padding-left, padding-right, padding-top, padding-bottom {
                    duration: Theme.motion ? 150ms : 0ms;
                    easing: ease-in-out;
                }
                spacing: 4px;
                // The compact and full titles cross-fade with the rail width so
                // the text never swaps in one frame.
                Rectangle {
                    height: 44px;
                    Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: "本机控制台";
                        color: Theme.rail-ink;
                        font-family: Theme.font-display;
                        font-size: 17px;
                        font-weight: 650;
                        vertical-alignment: center;
                        opacity: root.compact ? 0 : 1;
                        animate opacity { duration: Theme.motion ? 150ms : 0ms; easing: ease-in-out; }
                    }
                    Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: "控制台";
                        color: Theme.rail-ink;
                        font-family: Theme.font-display;
                        font-size: 13px;
                        font-weight: 650;
                        vertical-alignment: center;
                        opacity: root.compact ? 1 : 0;
                        animate opacity { duration: Theme.motion ? 150ms : 0ms; easing: ease-in-out; }
                    }
                }
                for entry in root.nav-entries : VerticalLayout {
                    spacing: 0px;
                    // A 12 px gap separates the 观测 group from 设置.
                    if entry.group == 1 && entry.page == 2 : Rectangle { height: 12px; }
                    NavItem {
                        label: entry.label;
                        icon: entry.icon;
                        compact: root.compact;
                        selected: root.page == entry.page;
                        activate => { root.navigate-to(entry.page); }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Hint { text: root.compact ? "托盘运行" : "关窗后继续运行"; color: Theme.rail-muted; visible: root.tray-available; }
                // Without a tray there is no background home, so leaving the
                // window stops the gateway. Confirm that destructive step inline.
                VerticalLayout {
                    visible: !root.tray-available;
                    height: root.tray-available ? 0px : self.preferred-height;
                    spacing: 4px;
                    quit-button := FocusAction {
                        visible: !root.confirm-quit;
                        label: root.compact ? "退出" : "退出并停止网关";
                        icon: "power";
                        quiet: true;
                        danger: true;
                        clicked => {
                            root.confirm-quit = true;
                            quit-confirm-timer.start();
                        }
                    }
                    VerticalLayout {
                        visible: root.confirm-quit;
                        height: root.confirm-quit ? self.preferred-height : 0px;
                        spacing: 4px;
                        Hint { text: "退出？将停止本实例网关"; color: Theme.bad-text; }
                        HorizontalLayout {
                            spacing: 6px;
                            quit-confirm-button := ActionButton {
                                label: "确认退出";
                                icon: "check";
                                danger: true;
                                clicked => {
                                    root.confirm-quit = false;
                                    root.quit-requested();
                                }
                            }
                            ActionButton {
                                label: "取消";
                                quiet: true;
                                clicked => { root.confirm-quit = false; }
                            }
                        }
                    }
                }
            }
            // Hairline between the second neutral layer and the page.
            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: 1px;
                height: parent.height;
                background: Theme.rail-edge;
            }
        }

        VerticalLayout {
            width: root.width - (root.compact ? 84px : 196px);
            alignment: stretch;
            padding: root.compact ? 12px : 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                // The title sets the row height; the chips opt into the same
                // vertical center instead of sitting on the baseline.
                cross-axis-alignment: center;
                page-title := Heading {
                    text: root.page-titles[root.page];
                    font-size: 22px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    opacity: root.page-opacity;
                    animate opacity { duration: Theme.glide; easing: ease-out; }
                }
                overview-address := CopyChip {
                    label: root.base-url;
                    copied: root.base-copied;
                    visible: root.page == 0 && !root.active-address.is-empty;
                    cross-axis-self-alignment: center;
                    opacity: root.page-opacity;
                    animate opacity { duration: Theme.glide; easing: ease-out; }
                    clicked => { root.request-copy(root.base-url, 1); }
                }
                overview-v1 := CopyChip {
                    label: "/v1";
                    copied: root.v1-copied;
                    visible: root.page == 0 && !root.active-address.is-empty;
                    cross-axis-self-alignment: center;
                    opacity: root.page-opacity;
                    animate opacity { duration: Theme.glide; easing: ease-out; }
                    clicked => { root.request-copy(root.base-url + "/v1", 2); }
                }
                // The maintenance menu opens as an overlay so the overview's
                // cards and the usage chart keep their default-window layout.
                // The button takes the title row's own height, so opening the
                // menu never moves the page content or clips the settings copy.
                maintenance-toggle := ActionButton {
                    label: "维护";
                    icon: "settings";
                    tooltip: "打开维护菜单";
                    quiet: true;
                    width: 76px;
                    height: 24px;
                    visible: root.page == 0;
                    cross-axis-self-alignment: center;
                    opacity: root.page-opacity;
                    clicked => {
                        root.maintenance-menu-open = !root.maintenance-menu-open;
                        if (!root.maintenance-menu-open) { root.maintenance-confirm = -1; }
                    }
                }
            }

            page-host := Rectangle {
                preferred-width: 100%;
                vertical-stretch: 1;
                clip: true;
                // The software renderer does not implement transform-scale, so
                // the page transition is opacity-only; a scale here is a no-op.
                opacity: root.page-opacity;
                animate opacity { duration: Theme.glide; easing: ease-out; }
            overview-scroll := ScrollView {
                visible: root.page == 0;
                vertical-stretch: 1;
                content-width: self.visible-width;
                overview-content := VerticalLayout {
                    // Stretch the chart into the viewport when the cards leave
                    // room, but never shrink the page below its preferred
                    // height; the ScrollView takes over when content overflows.
                    alignment: stretch;
                    min-height: max(self.preferred-height, overview-scroll.visible-height);
                    spacing: 12px;
                    // Leave a gutter on the right so the scrollbar thumb lands on
                    // the page, never inside a card.
                    padding-right: 8px;
                    state-card := Card {
                        // Three equal stretches divide the card content in a
                        // row, so no blank strip sits on the right. The compact
                        // stack is a conditional element, while the wide row
                        // stays a plain layout so its cell widths stay
                        // measurable; collapsing its height to zero and keeping
                        // no gap between the two orientations keeps it out of
                        // the compact card.
                        VerticalLayout {
                            spacing: 0px;
                            wide-state := HorizontalLayout {
                                visible: !root.compact;
                                height: root.compact ? 0px : self.preferred-height;
                                spacing: 14px;
                                // Equal thirds keep the long detail text from
                                // squeezing the other two columns into vertical
                                // text at the wide layout.
                                // The service cell replaces the old gateway cell
                                // in the overview: the service state and the
                                // gateway supervision now share one status
                                // surface, while the settings instance card
                                // keeps the supervisor detail. It offers the
                                // start action only while the service is
                                // stopped; a failed read keeps the reason
                                // instead of a PID.
                                state-gateway := StateCell {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    preferred-width: 0px;
                                    label: "UM 服务"; value: root.um-service-state;
                                    detail: root.um-service-detail; tone: root.um-service-tone;
                                    if !root.um-service-checked-at.is-empty : Hint {
                                        text: root.um-service-checked-at;
                                    }
                                    if !root.um-service-start-status.is-empty : Hint {
                                        text: root.um-service-start-status;
                                        color: Theme.status_ink(root.um-service-start-tone);
                                    }
                                    if root.um-service-gateway-missing : Hint {
                                        text: root.um-service-gateway-detail;
                                        color: Theme.status_ink(root.um-service-tone);
                                    }
                                    start-um-service := ActionButton {
                                        visible: root.um-service-can-start
                                            && !root.um-service-busy;
                                        height: self.visible ? self.preferred-height : 0px;
                                        label: "启动 UM 服务";
                                        icon: "play";
                                        quiet: true;
                                        enabled: !root.um-service-busy;
                                        clicked => { root.start-um-service(); }
                                    }
                                    start-gateway := ActionButton {
                                        visible: root.um-service-gateway-missing
                                            && root.um-service-can-start-gateway;
                                        height: self.visible ? self.preferred-height : 0px;
                                        label: "启动网关";
                                        icon: "play";
                                        quiet: true;
                                        clicked => { root.restart-gateway(); }
                                    }
                                }
                                state-login := StateCell {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    preferred-width: 0px;
                                    label: "UM 登录"; value: root.account-label;
                                    detail: root.account-state-detail(); tone: root.account-tone;
                                    pulse: root.account-pulse;
                                }
                                state-upstream := StateCell {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    preferred-width: 0px;
                                    label: "上游"; value: root.upstream-value;
                                    detail: root.upstream-detail; tone: root.upstream-tone;
                                    pulse: root.upstream-pulse;
                                }
                            }
                            if root.compact : VerticalLayout {
                                spacing: 12px;
                                StateCell {
                                    horizontal-stretch: 1; label: "UM 服务";
                                    value: root.um-service-state;
                                    detail: root.um-service-detail; tone: root.um-service-tone;
                                    if !root.um-service-checked-at.is-empty : Hint {
                                        text: root.um-service-checked-at;
                                    }
                                    if !root.um-service-start-status.is-empty : Hint {
                                        text: root.um-service-start-status;
                                        color: Theme.status_ink(root.um-service-start-tone);
                                    }
                                    if root.um-service-gateway-missing : Hint {
                                        text: root.um-service-gateway-detail;
                                        color: Theme.status_ink(root.um-service-tone);
                                    }
                                    if root.um-service-can-start && !root.um-service-busy : ActionButton {
                                        label: "启动 UM 服务";
                                        icon: "play";
                                        quiet: true;
                                        enabled: !root.um-service-busy;
                                        clicked => { root.start-um-service(); }
                                    }
                                    if root.um-service-gateway-missing
                                        && root.um-service-can-start-gateway : ActionButton {
                                        label: "启动网关";
                                        icon: "play";
                                        quiet: true;
                                        clicked => { root.restart-gateway(); }
                                    }
                                }
                                StateCell {
                                    horizontal-stretch: 1; label: "UM 登录"; value: root.account-label;
                                    detail: root.account-state-detail(); tone: root.account-tone;
                                    pulse: root.account-pulse;
                                }
                                StateCell {
                                    horizontal-stretch: 1; label: "上游"; value: root.upstream-value;
                                    detail: root.upstream-detail; tone: root.upstream-tone;
                                    pulse: root.upstream-pulse;
                                }
                            }
                        }
                    }
                    login-card := Card {
                        gap: 10px;
                        visible: root.login-visible;
                        height: root.login-visible ? login-card.content-height : 0px;
                        VerticalLayout {
                            alignment: start;
                            spacing: 10px;
                            SectionLabel { text: "账号登录"; }
                            if root.account-label != "已登录" : Hint {
                                text: "登录 UM 后可以调用模型。也可以先查看网关和日志。";
                            }
                            if !root.login-status.is-empty : Hint { text: root.login-status; color: Theme.status_ink(root.login-tone); }
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                configure-account-button := ActionButton {
                                    visible: root.account-label != "已登录" || root.account-can-continue;
                                    label: root.account-can-continue
                                        ? (root.account-manual-takeover ? "继续登录" : "按需登录")
                                        : "配置账号";
                                    icon: "edit";
                                    enabled: !root.account-busy;
                                    primary: true;
                                    clicked => {
                                        if (root.account-can-continue) { root.continue-login(); }
                                        else { root.configure-account(); }
                                    }
                                }
                                skip-login-button := ActionButton {
                                    visible: root.show-intro && root.account-label != "已登录"; label: "稍后登录";
                                    clicked => { root.skip-login(); }
                                }
                            }
                        }
                    }
                    usage-chart := UsageChart {
                        // The overview is a fixed set of cards; the chart takes
                        // the leftover height instead of leaving a blank band
                        // above the status row.
                        vertical-stretch: 1;
                        period <=> root.usage-period;
                        points: root.usage-points;
                        labels: root.usage-labels;
                        token-counts: root.usage-token-counts;
                        request-counts: root.usage-request-counts;
                        token-total: root.token-total;
                        request-total: root.request-total;
                        loading: root.usage-loading;
                        status-text: root.usage-status;
                        status-tone: Theme.status_ink(root.usage-tone);
                        allow-motion: root.allow-motion;
                        show-line <=> root.usage-show-line;
                        show-requests <=> root.usage-show-requests;
                        auto-refresh <=> root.auto-refresh;
                        refreshing: root.refreshing;
                        refresh-rotation: root.refresh-rotation;
                        updated-at: root.overview-updated-at;
                        refresh => { root.refresh-current-page(); }
                        period-changed(index) => { root.usage-range-changed(index); }
                    }
                    upstream-fault-card := Card {
                        gap: 10px;
                        VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                SectionLabel {
                                    text: "上游故障历史";
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                DataText {
                                    text: root.upstream-fault-check;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    wrap: no-wrap;
                                }
                            }
                            Hint {
                                text: root.upstream-fault-status;
                                color: Theme.status_ink(root.upstream-fault-tone);
                            }
                            if root.upstream-fault-active : VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                HorizontalLayout {
                                    spacing: 7px;
                                    cross-axis-alignment: center;
                                    StatusDot { tone: 2; }
                                    Text {
                                        text: root.upstream-fault-active-title;
                                        color: Theme.ink;
                                        font-weight: 600;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                }
                                Hint { text: root.upstream-fault-active-detail; }
                            }
                            if root.upstream-fault-history.length > 0 : VerticalLayout {
                                spacing: 8px;
                                alignment: start;
                                for row in root.upstream-fault-history : VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    alignment: start;
                                    HorizontalLayout {
                                        spacing: 7px;
                                        cross-axis-alignment: center;
                                        StatusDot { tone: 0; }
                                        Text {
                                            text: row.title;
                                            color: Theme.ink;
                                            font-weight: 600;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Hint { text: row.detail; }
                                    if root.upstream-fault-evidence-shown : Hint {
                                        text: row.evidence;
                                    }
                                }
                            }
                            HorizontalLayout {
                                visible: root.upstream-fault-evidence-toggle-visible;
                                spacing: 8px;
                                fault-evidence-toggle := ActionButton {
                                    label: root.show-fault-evidence
                                        ? "收起恢复证据" : "展开恢复证据";
                                    icon: root.show-fault-evidence
                                        ? "chevron-down" : "chevron-right";
                                    quiet: true;
                                    clicked => {
                                        root.show-fault-evidence = !root.show-fault-evidence;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                    // The recent verify card always exists: a never-verified
                    // instance is a legal state with its own copy and the first
                    // probe action, not a blank card. It sits below the fault
                    // history so the cards above keep their default-window place.
                    verify-card := Card {
                        gap: 10px;
                        VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                SectionLabel {
                                    text: "最近核验";
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                if !root.verify-at.is-empty : DataText {
                                    text: root.verify-at;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                spacing: 7px;
                                cross-axis-alignment: center;
                                StatusDot { tone: root.verify-tone; }
                                Text {
                                    text: root.verify-result;
                                    color: Theme.ink;
                                    font-weight: 600;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                            if !root.verify-detail.is-empty : Hint {
                                text: root.verify-detail;
                            }
                            verify-action := ActionButton {
                                label: root.verify-action-label;
                                icon: "check";
                                enabled: !root.verify-busy;
                                clicked => { root.verify-login(); }
                            }
                        }
                    }
                }
            }

            request-scroll := ScrollView {
                visible: root.page == 1;
                vertical-stretch: 1;
                content-width: self.visible-width;
                // Stretch the list into the viewport when the cards leave room,
                // but never shrink the page below its preferred height; the
                // ScrollView takes over at the minimum window size.
                request-page := VerticalLayout {
                width: 100%;
                min-height: max(self.preferred-height, request-scroll.visible-height);
                // Leave a gutter on the right so the scrollbar thumb lands on
                // the page, never inside a card.
                padding-right: root.compact ? 8px : 0px;
                spacing: 8px;
                // The request page follows Magpie's 用量/请求 order: the two
                // filter rows first, then the summary hint, the metric cards and
                // chart, and finally the request list with its detail panel.
                request-filters := VerticalLayout {
                    width: 100%;
                    horizontal-stretch: 1;
                    spacing: 8px;
                    // The model select opens over the status row and the
                    // analytics card; the filter group must paint above them.
                    z: 10;
                    // First filter row: the time range on the left, the manual
                    // refresh on the right, like Magpie's range/refresh row.
                    request-filter-row := HorizontalLayout {
                        width: 100%;
                        horizontal-stretch: 1;
                        spacing: 8px;
                        request-period-control := Segmented {
                            width: 280px;
                            options: [{ text: "今天" }, { text: "24 小时" }, { text: "7 天" }, { text: "30 天" }, { text: "全部" }];
                            current-index <=> root.request-period;
                            label: "请求日期范围";
                            selected(_) => { root.query-requests(0); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        request-refresh := ActionButton {
                            width: Theme.icon-button;
                            height: Theme.icon-button;
                            label: "刷新请求";
                            icon: "refresh";
                            icon-rotation: root.refresh-rotation;
                            icon-only: true;
                            quiet: true;
                            tooltip: "刷新请求";
                            enabled: !root.refreshing;
                            clicked => { root.refresh-current-page(); }
                        }
                    }
                    // Second filter row: the model and result selects, the search
                    // field and the query action. The search covers request ID,
                    // model and error text; no agent/provider/account filters
                    // are added.
                    request-filter-result-row := HorizontalLayout {
                        width: 100%;
                        horizontal-stretch: 1;
                        spacing: 8px;
                        request-model-control := Dropdown {
                            width: root.compact ? 110px : 180px;
                            options: root.request-model-options;
                            current-index <=> root.request-model-index;
                            label: "请求模型";
                            selected(index) => {
                                root.request-model-filter = index > 0
                                    && index < root.request-model-options.length
                                    ? root.request-model-options[index] : "";
                                root.query-requests(0);
                            }
                        }
                        request-result-control := Dropdown {
                            width: root.compact ? 110px : 160px;
                            options: root.request-result-options;
                            current-index <=> root.request-result;
                            label: "请求结果";
                            selected(_) => { root.query-requests(0); }
                        }
                        request-search := MaterialField {
                            horizontal-stretch: 1;
                            icon: "search";
                            placeholder: "请求 ID、模型或错误";
                            clearable: true;
                            text <=> root.request-keyword;
                            accepted => { root.query-requests(0); }
                            cleared => { root.query-requests(0); }
                        }
                        request-query := ActionButton {
                            width: Theme.icon-button;
                            height: Theme.icon-button;
                            label: "查询";
                            icon: "arrow-right";
                            icon-only: true;
                            primary: true;
                            tooltip: "查询请求";
                            clicked => { root.query-requests(0); }
                        }
                    }
                }
                request-status-row := HorizontalLayout {
                    width: 100%;
                    horizontal-stretch: 1;
                    spacing: 8px;
                    Hint { text: root.request-status; color: Theme.status_ink(root.request-tone); horizontal-stretch: 1; vertical-alignment: center; overflow: elide; wrap: no-wrap; }
                    DataText { text: root.request-updated-at-label; vertical-alignment: center; }
                }
                request-analytics := RequestAnalytics {
                    width: 100%;
                    horizontal-stretch: 1;
                    compact: root.compact;
                    metrics: root.request-metrics;
                    summary-line: root.request-summary;
                    labels: root.request-chart-labels;
                    token-counts: root.request-chart-token-counts;
                    request-counts: root.request-chart-request-counts;
                    speed-counts: root.request-chart-speed-counts;
                    token-series: root.request-chart-token-series;
                    request-series: root.request-chart-request-series;
                    speed-series: root.request-chart-speed-series;
                    model-speeds: root.request-model-speeds;
                    metric <=> root.request-metric;
                    split-by-model <=> root.request-split-by-model;
                    allow-motion: root.allow-motion;
                }
                request-row := HorizontalLayout {
                    width: 100%;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    spacing: root.compact && !root.selected-request.is-empty ? 0px : 12px;
                    request-list-pane := VerticalLayout {
                    horizontal-stretch: 0;
                    // The page scrolls; the list keeps a readable height at
                    // every width instead of collapsing to one row.
                    min-height: root.compact ? 320px : 240px;
                    // Follow the detail panel's animated width so closing it
                    // gives the space back to the list without a jump.
                    width: root.compact
                        ? (root.selected-request.is-empty ? root.request-content-width() : 0px)
                        : root.request-content-width()
                            - (request-details.width > 1px ? request-details.width + 12px : 0px);
                    visible: !root.compact || root.selected-request.is-empty;
                    spacing: 8px;
                    request-list-panel := Panel {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-left: 6px;
                            // Leave the 14 px scrollbar its own gutter so it
                            // never covers the result tag.
                            padding-right: 18px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 4px;
                            // The column header uses the same widths as the
                            // rows, so the list reads as one table: time,
                            // model, first-token and result.
                            request-list-header := HorizontalLayout {
                                height: 20px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                request-list-header-at := Hint { text: "时间"; width: 96px; vertical-alignment: center; }
                                request-list-header-model := Hint { text: "模型"; horizontal-stretch: 1; vertical-alignment: center; }
                                request-list-header-first-token := Hint { text: "首字"; width: 76px; horizontal-alignment: right; vertical-alignment: center; }
                                request-list-header-outcome := Hint { text: "结果"; width: 76px; horizontal-alignment: right; vertical-alignment: center; }
                            }
                            if root.requests.length == 0 : VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 4px;
                                Hint { text: "暂无请求记录"; color: Theme.ink; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
                                Hint { text: "本实例收到请求后会列在这里"; horizontal-alignment: center; }
                            }
                            request-rows := ListView {
                                visible: root.requests.length > 0;
                                vertical-stretch: 1;
                                content-y <=> root.request-scroll-y;
                                for item in root.requests : Selectable {
                                    label: item.at + " " + item.model + " " + item.outcome;
                                    height: 50px;
                                    selected: root.selected-request == item.id;
                                    activate => { root.open-request(item.id); }
                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px; padding-top: 5px; padding-bottom: 5px;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            DataText { text: item.at; width: 96px; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                            Text { text: item.model; color: Theme.ink; horizontal-stretch: 1; overflow: elide; font-weight: 600; vertical-alignment: center; }
                                            DataText { text: item.first-token; width: 76px; horizontal-alignment: right; vertical-alignment: center; }
                                            Tag { label: item.outcome; tone: item.tone; width: 76px; }
                                        }
                                        Hint { text: item.summary; overflow: elide; wrap: no-wrap; }
                                    }
                                }
                            }
                            // The footer holds 加载更早 (append history under the
                            // current filters) next to the 较新/较早 page pager.
                            // The two kinds never share state: loading earlier
                            // keeps the scroll and the current page; the pager
                            // replaces the page and starts at its top.
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                request-load-earlier := ActionButton {
                                    label: "加载更早";
                                    icon: "chevron-down";
                                    quiet: true;
                                    enabled: root.has-earlier-records;
                                    tooltip: "加载更早的请求";
                                    clicked => { root.load-earlier-requests(); }
                                }
                                request-earlier-hint := Hint {
                                    text: "没有更早记录";
                                    visible: root.requests.length > 0 && !root.has-earlier-records;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                request-newer-page := ActionButton { label: "较新"; icon: "chevron-left"; quiet: true; enabled: root.newer-requests; tooltip: "较新的请求"; clicked => { root.request-scroll-y = 0px; root.query-requests(-1); } }
                                request-older-page := ActionButton { label: "较早"; icon: "chevron-right"; quiet: true; enabled: root.older-requests; tooltip: "较早的请求"; clicked => { root.request-scroll-y = 0px; root.query-requests(1); } }
                            }
                        }
                    }
                }
                request-details := TextDetails {
                    visible: !root.selected-request.is-empty || self.width > 1px;
                    // The detail fills the list row; its own content must not
                    // raise the page's preferred height.
                    preferred-height: 0px;
                    width: root.selected-request.is-empty ? 0px : root.compact ? max(300px, root.width - 134px) : min(400px, (root.width - 212px) * 0.48);
                    clip: true;
                    animate width { duration: Theme.settle; easing: ease-out; }
                    title: root.request-detail-title;
                    body: root.request-detail;
                    closed => { root.selected-request = ""; }
                }
                }
                }
            }

            VerticalLayout {
                visible: root.page == 3; vertical-stretch: 1; spacing: 6px;
                FlexboxLayout {
                    flex-wrap: wrap;
                    spacing: 8px;
                    // Two layers, one control: 实时 keeps the file tail; 历史
                    // switches to the gateway's bounded server-side history.
                    log-mode-control := Segmented {
                        width: root.compact ? 140px : 160px;
                        options: [{ text: "实时" }, { text: "历史" }];
                        current-index <=> root.log-mode;
                        label: "日志层";
                        selected(_) => { root.select-log-mode(root.log-mode); }
                    }
                    // The five history windows only exist in the history layer.
                    log-range-control := Segmented {
                        visible: root.log-mode == 1;
                        width: root.compact ? 200px : 252px;
                        options: [{ text: "今天" }, { text: "24 小时" }, { text: "7 天" }, { text: "30 天" }, { text: "全部" }];
                        current-index <=> root.log-range;
                        label: "日志日期范围";
                        selected(_) => { root.select-log-range(root.log-range); }
                    }
                    // The four levels are independent toggles; no selection means
                    // every level, including the ungraded rows.
                    log-level-error := Toggle {
                        visible: root.log-mode == 1;
                        label: "错误";
                        checked <=> root.log-level-error;
                        toggled => { root.sync-log-level(); root.query-log-history(); }
                    }
                    log-level-warn := Toggle {
                        visible: root.log-mode == 1;
                        label: "警告";
                        checked <=> root.log-level-warn;
                        toggled => { root.sync-log-level(); root.query-log-history(); }
                    }
                    log-level-info := Toggle {
                        visible: root.log-mode == 1;
                        label: "信息";
                        checked <=> root.log-level-info;
                        toggled => { root.sync-log-level(); root.query-log-history(); }
                    }
                    log-level-debug := Toggle {
                        visible: root.log-mode == 1;
                        label: "调试";
                        checked <=> root.log-level-debug;
                        toggled => { root.sync-log-level(); root.query-log-history(); }
                    }
                }
                // The source and the page actions share the second filter row,
                // so the first row keeps its controls without wrapping at the
                // common window width.
                FlexboxLayout {
                    flex-wrap: wrap;
                    spacing: 8px;
                    // The source list is the gateway's closed set; the first entry
                    // is "all sources".
                    log-source-control := Dropdown {
                        visible: root.log-mode == 1;
                        width: root.compact ? 120px : 150px;
                        options: root.log-source-options;
                        current-index <=> root.log-source-index;
                        label: "日志来源";
                        selected(index) => {
                            root.log-source = index > 0 && index < root.log-source-options.length
                                ? root.log-source-options[index] : "";
                            root.query-log-history();
                        }
                    }
                    // The whole toolbar reads like the Magpie session list:
                    // filters first, then search, the page actions and the one
                    // jump to settings. It wraps at the minimum width.
                    log-search := MaterialField {
                        visible: root.log-mode == 1;
                        width: root.compact ? 140px : 160px;
                        icon: "search";
                        placeholder: "关键词";
                        clearable: true;
                        text <=> root.log-filter-keyword;
                        edited(_) => { root.query-log-history(); }
                        cleared => { root.query-log-history(); }
                    }
                    // The slot keeps its width; only the glyph swaps to a
                    // check so the neighbouring actions never shift.
                    log-refresh := ActionButton {
                        width: Theme.icon-button;
                        height: Theme.icon-button;
                        label: root.log-refreshed ? "已刷新" : "刷新";
                        icon: root.log-refreshed ? "check" : "refresh";
                        icon-rotation: root.refresh-rotation;
                        icon-only: true;
                        quiet: true;
                        tooltip: root.log-refreshed ? "已刷新" : "刷新日志";
                        enabled: !root.refreshing;
                        clicked => { root.refresh-current-page(); }
                    }
                    // Live follow stays next to the live layer it belongs to;
                    // pausing only stops the list from jumping, never the read.
                    log-follow := ActionButton {
                        visible: root.log-mode == 0;
                        width: Theme.icon-button;
                        height: Theme.icon-button;
                        quiet: true;
                        label: root.log-follow ? "暂停跟随" : "恢复跟随";
                        icon: root.log-follow ? "pause" : "play";
                        icon-only: true;
                        tooltip: root.log-follow ? "暂停跟随" : "恢复跟随";
                        badge: root.new-log-count > 0 && !root.log-follow ? root.new-log-count : "";
                        clicked => {
                            root.log-follow = !root.log-follow;
                            if (root.log-follow) {
                                root.new-log-count = 0;
                                if (root.logs.length > 0) { log-list.ensure-row-visible(root.logs.length - 1, ScrollBehavior.instant); }
                            }
                        }
                    }
                    // The log page is read-only diagnostics, so it has no recycle
                    // bin; the settings entry is the one jump out of this page.
                    log-settings-button := ActionButton {
                        width: Theme.icon-button;
                        height: Theme.icon-button;
                        label: "设置";
                        icon: "settings";
                        icon-only: true;
                        quiet: true;
                        tooltip: "打开设置";
                        clicked => { root.navigate-to(2); }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: start;
                    Tag {
                        label: root.log-layer-label;
                        tone: root.log-mode == 0 ? 0 : 3;
                        y: (parent.height - self.height) / 2;
                    }
                    StatusDot { tone: root.log-tone; y: (parent.height - self.height) / 2; }
                    Hint { text: root.log-status; color: Theme.status_ink(root.log-tone); vertical-alignment: center; overflow: elide; wrap: no-wrap; horizontal-stretch: 1; }
                    Hint { visible: root.log-mode == 1 && !root.log-history-note.is-empty; text: root.log-history-note; vertical-alignment: center; }
                    DataText { text: root.log-updated-at-label; vertical-alignment: center; }
                    log-earlier := ActionButton {
                        visible: root.log-mode == 1;
                        height: Theme.icon-button;
                        quiet: true;
                        label: "加载更早";
                        icon: "chevron-down";
                        tooltip: "加载更早的历史日志";
                        enabled: root.older-logs;
                        clicked => { root.load-earlier-logs(); }
                    }
                }
                Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-left: 6px;
                        padding-right: 14px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        if root.logs.length == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            Hint {
                                text: root.log-mode == 0
                                    ? "暂无日志"
                                    : root.log-tone == 2 ? "历史日志读取失败" : "读取范围内没有符合条件的日志";
                                color: Theme.ink; font-size: 13px; font-weight: 600; horizontal-alignment: center;
                            }
                            Hint {
                                text: root.log-mode == 0
                                    ? "网关输出会实时显示在这里"
                                    : root.log-tone == 2 ? "原因见上方状态行" : "调整筛选或加载更早";
                                horizontal-alignment: center;
                            }
                        }
                        log-list := ListView {
                            visible: root.logs.length > 0;
                            vertical-stretch: 1;
                            content-y <=> root.log-scroll-y;
                            scrolled => {
                                if (root.log-mode == 0 && (-self.content-y + self.visible-height) < self.content-height - 8px) {
                                    root.log-follow = false;
                                }
                            }
                            for row in root.logs : Selectable {
                                label: row.at + " " + row.level + " " + row.source + " " + row.text;
                                height: 36px;
                                selected: row.id == root.open-log-id;
                                activate => {
                                    root.open-log-id = row.id;
                                    root.open-log-title = row.at + "  " + row.level;
                                    root.open-log-body = row.detail;
                                }
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    DataText { text: row.at; width: root.compact ? 92px : 96px; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                    Tag {
                                        label: row.level;
                                        tone: row.level == "错误" ? 2 : row.level == "警告" ? 1 : 3;
                                    }
                                    if root.log-mode == 1 : Tag {
                                        label: row.source;
                                        tone: 3;
                                    }
                                    Text { text: row.text; horizontal-stretch: 1; color: Theme.ink; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }
                    }
                }
                log-details := TextDetails {
                    visible: !root.open-log-id.is-empty || self.height > 0px;
                    height: root.open-log-id.is-empty ? 0px : root.compact ? 130px : 170px;
                    clip: true;
                    animate height { duration: Theme.settle; easing: ease-out; }
                    title: root.open-log-title;
                    body: root.open-log-body;
                    closed => { root.open-log-id = ""; }
                }
            }

            settings-scroll := ScrollView {
                visible: root.page == 2;
                vertical-stretch: 1;
                content-width: self.visible-width;
                settings-content := VerticalLayout {
                    alignment: start;
                    min-height: self.preferred-height;
                    spacing: 12px;
                    padding-right: 8px;
                    // Leave a gutter below the last card instead of letting
                    // the footer cut through the API address row.
                    padding-bottom: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        settings-refresh := ActionButton {
                            width: Theme.icon-button;
                            height: Theme.icon-button;
                            label: "刷新";
                            icon: "refresh";
                            icon-rotation: root.refresh-rotation;
                            icon-only: true;
                            quiet: true;
                            tooltip: "重新检查网关与账号状态";
                            enabled: !root.refreshing;
                            clicked => { root.refresh-current-page(); }
                        }
                        Hint { text: root.settings-updated-at-label; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    appearance-card := Card {
                        inset: 16px;
                        inset-y: 12px;
                        gap: 12px;
                        VerticalLayout {
                            alignment: start;
                            spacing: 12px;
                            appearance-title := SectionLabel { text: "外观"; }
                            appearance-hint := Hint { text: "跟随系统时会随 Windows 应用主题切换，手动选择会覆盖系统设置。当前界面无透明度效果，开关已保存。"; }
                            appearance-row := SettingRow {
                                label: "主题";
                                Rectangle { horizontal-stretch: 1; }
                                theme-mode-control := Segmented {
                                    width: root.compact ? 260px : 300px;
                                    label: "主题";
                                    options: [
                                        { text: "跟随系统" },
                                        { text: "浅色" },
                                        { text: "深色" },
                                    ];
                                    current-index <=> root.theme-mode;
                                    selected(index) => { root.theme-mode-changed(index); }
                                }
                            }
                            // The three secondary appearance choices sit in one row
                            // when the card has room and stack at narrow widths.
                            appearance-options := GridLayout {
                                spacing: 8px;
                                appearance-sidebar-row := SettingRow {
                                    row: 0;
                                    col: 0;
                                    height: 34px;
                                    width: root.appearance-narrow
                                        ? (root.compact ? root.width - 148px : root.width - 276px)
                                        : ((root.compact ? root.width - 148px : root.width - 276px) - 16px) / 3;
                                    label: "侧栏";
                                    Rectangle { horizontal-stretch: 1; }
                                    sidebar-mode-control := Segmented {
                                        width: root.appearance-narrow ? 260px : 120px;
                                        label: "侧栏";
                                        options: [
                                            { text: "展开" },
                                            { text: "仅图标" },
                                        ];
                                        current-index <=> root.sidebar-mode;
                                        selected(index) => { root.sidebar-mode-changed(index); }
                                    }
                                }
                                appearance-motion-row := SettingRow {
                                    row: root.appearance-narrow ? 1 : 0;
                                    col: root.appearance-narrow ? 0 : 1;
                                    height: 34px;
                                    width: root.appearance-narrow
                                        ? (root.compact ? root.width - 148px : root.width - 276px)
                                        : ((root.compact ? root.width - 148px : root.width - 276px) - 16px) / 3;
                                    label: "界面动效";
                                    Rectangle { horizontal-stretch: 1; }
                                    motion-mode-control := Segmented {
                                        width: root.appearance-narrow ? 260px : 120px;
                                        label: "界面动效";
                                        options: [
                                            { text: "跟随系统" },
                                            { text: "减少动效" },
                                        ];
                                        current-index <=> root.motion-mode;
                                        selected(index) => { root.motion-mode-changed(index); }
                                    }
                                }
                                appearance-transparency-row := SettingRow {
                                    row: root.appearance-narrow ? 2 : 0;
                                    col: root.appearance-narrow ? 0 : 2;
                                    height: 34px;
                                    width: root.appearance-narrow
                                        ? (root.compact ? root.width - 148px : root.width - 276px)
                                        : ((root.compact ? root.width - 148px : root.width - 276px) - 16px) / 3;
                                    label: "透明度";
                                    Rectangle { horizontal-stretch: 1; }
                                    transparency-toggle := Toggle {
                                        label: "降低透明度";
                                        cross-axis-self-alignment: center;
                                        checked <=> root.reduce-transparency;
                                        toggled => { root.transparency-changed(root.reduce-transparency); }
                                    }
                                }
                            }
                        }
                    }
                    account-card := Card {
                        inset: 16px;
                        gap: 12px;
                        VerticalLayout {
                            alignment: start;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 8px;
                                account-title := SectionLabel { text: "UM 账号"; horizontal-stretch: 1; vertical-alignment: center; }
                                account-state := Tag {
                                    label: root.account-label;
                                    tone: root.account-tone;
                                    cross-axis-self-alignment: center;
                                }
                            }
                            account-saved-hint := Hint { text: root.account-saved; }
                            account-saved-detail := Hint {
                                visible: !root.account-saved-detail.is-empty;
                                height: self.visible ? self.preferred-height : 0px;
                                text: root.account-saved-detail;
                            }
                            if !root.account-detail.is-empty : Hint { text: root.account-detail; color: Theme.status_ink(root.account-tone); }
                            account-actions := HorizontalLayout {
                                height: root.account-form-visible ? 0px : self.preferred-height;
                                spacing: 8px; alignment: start;
                                edit-account := FocusAction {
                                    visible: !root.account-form-visible; enabled: !root.account-busy;
                                    label: root.account-can-clear ? "更新账号密码" : "配置账号";
                                    icon: "edit";
                                    clicked => { root.open-account-form(); }
                                }
                                ActionButton {
                                    visible: root.account-can-continue && !root.account-form-visible;
                                    enabled: !root.account-busy; primary: true;
                                    label: root.account-manual-takeover ? "继续登录" : "按需登录";
                                    clicked => { root.continue-login(); }
                                }
                            }
                            HorizontalLayout {
                                height: root.account-can-clear && !root.account-form-visible ? self.preferred-height : 0px;
                                alignment: start;
                                spacing: 8px;
                                clear-account := FocusAction {
                                    visible: root.account-can-clear && !root.account-form-visible && !root.confirm-clear;
                                    enabled: !root.account-busy;
                                    quiet: true;
                                    danger: true;
                                    label: "清除已保存的账号密码";
                                    icon: "trash";
                                    clicked => {
                                        root.confirm-clear = true;
                                        clear-confirm-timer.start();
                                    }
                                }
                                if root.confirm-clear : Hint {
                                    visible: root.confirm-clear;
                                    text: "确认清除？";
                                    color: Theme.bad-text;
                                    vertical-alignment: center;
                                }
                                clear-confirm := FocusAction {
                                    visible: root.confirm-clear;
                                    label: "确认";
                                    danger: true;
                                    enabled: !root.account-busy;
                                    clicked => {
                                        root.confirm-clear = false;
                                        root.clear-credentials();
                                    }
                                }
                                if root.confirm-clear : FocusAction {
                                    label: "取消";
                                    quiet: true;
                                    clicked => { root.confirm-clear = false; }
                                }
                            }
                            if !root.credential-status.is-empty : Hint { text: root.credential-status; color: Theme.status_ink(root.credential-tone); }
                            if !root.login-status.is-empty : Hint { text: root.login-status; color: Theme.status_ink(root.login-tone); }
                            VerticalLayout {
                                visible: root.account-form-visible;
                                height: self.visible ? self.preferred-height : 0px;
                                spacing: 8px;
                                Divider { }
                                SectionLabel { text: "录入账号密码"; }
                                Hint { text: "账号密码保存在本机，供此网关重新登录。"; }
                                account-input := Field {
                                    label: "UMPASS 账号";
                                    placeholder: "输入账号";
                                    text <=> root.credential-account-input;
                                    invalid: root.account-input-invalid;
                                    edited(_) => {
                                        root.account-input-invalid = false;
                                        root.account-input-error = "";
                                    }
                                    accepted => { password-input.take-focus(); }
                                }
                                if !root.account-input-error.is-empty : Hint {
                                    text: root.account-input-error;
                                    color: Theme.bad-text;
                                }
                                password-input := Field {
                                    label: "UMPASS 密码";
                                    placeholder: "输入密码";
                                    password: true;
                                    text <=> root.credential-password-input;
                                    invalid: root.password-input-invalid;
                                    edited(_) => {
                                        root.password-input-invalid = false;
                                        root.password-input-error = "";
                                    }
                                    accepted => {
                                        if (!root.account-busy) { root.save-credentials(root.credential-account-input, root.credential-password-input); }
                                    }
                                }
                                if !root.password-input-error.is-empty : Hint {
                                    text: root.password-input-error;
                                    color: Theme.bad-text;
                                }
                                password-toggle := Toggle {
                                    label: "显示密码";
                                    checked: root.password-visible;
                                    toggled => { root.toggle-password-visible(); }
                                }
                                HorizontalLayout {
                                    alignment: end; spacing: 8px;
                                    cancel-account := FocusAction { label: "取消"; icon: "close"; quiet: true; clicked => { root.close-account-form(); } }
                                    save-account := FocusAction {
                                        label: "保存账号"; icon: "check"; primary: true; enabled: !root.account-busy;
                                        clicked => { root.save-credentials(root.credential-account-input, root.credential-password-input); }
                                    }
                                }
                            }
                        }
                    }
                    gateway-card := Card {
                        inset: 16px;
                        gap: 12px;
                        VerticalLayout {
                            spacing: 12px;
                            gateway-title := SectionLabel { text: "网关"; }
                            gateway-hint := Hint { text: "仅在本机可用。更改端口会先检查新端口，再等待当前请求完成。"; }
                            Divider { }
                            port-row := SettingRow {
                                label: "网关端口";
                                Rectangle { horizontal-stretch: 1; }
                                port-input := MaterialField {
                                    width: 148px;
                                    placeholder: "端口";
                                    numeric: true;
                                    text <=> root.port-input;
                                    enabled: !root.port-busy;
                                    invalid: root.port-input-invalid;
                                    edited(_) => { root.port-input-invalid = false; root.port-input-error = ""; }
                                    accepted => { if (!root.port-busy) { root.save-port(root.port-input); } }
                                }
                                port-apply := ActionButton { label: "应用"; icon: "swap"; primary: true; enabled: !root.port-busy; clicked => { root.save-port(root.port-input); } }
                            }
                            port-error-hint := Hint {
                                visible: !root.port-input-error.is-empty;
                                height: self.visible ? self.preferred-height : 0px;
                                text: root.port-input-error;
                                color: Theme.bad-text;
                            }
                            settings-status-hint := Hint {
                                visible: !root.settings-status.is-empty;
                                height: self.visible ? self.preferred-height : 0px;
                                text: root.settings-status;
                                color: Theme.status_ink(root.settings-tone);
                            }
                            // A gateway that is down gets one recovery action; the
                            // restart asks once because it interrupts in-flight requests.
                            gateway-restart-row := HorizontalLayout {
                                visible: root.gateway-tone == 2;
                                height: self.visible ? self.preferred-height : 0px;
                                spacing: 8px;
                                restart-gateway := ActionButton {
                                    visible: !root.confirm-restart && !root.gateway-restarting;
                                    label: "重启网关";
                                    icon: "refresh";
                                    quiet: true;
                                    enabled: !root.port-busy;
                                    clicked => {
                                        root.confirm-restart = true;
                                        restart-confirm-timer.start();
                                    }
                                }
                                if root.gateway-restarting : Hint {
                                    text: "正在重启本实例网关…";
                                    color: Theme.status_ink(1);
                                    vertical-alignment: center;
                                }
                                if root.confirm-restart : Hint {
                                    text: "确认重启？会中断在途请求";
                                    color: Theme.bad-text;
                                    vertical-alignment: center;
                                }
                                // Always instantiated so the confirmation keeps a
                                // testable geometry; only visible while asking.
                                restart-confirm := ActionButton {
                                    visible: root.confirm-restart;
                                    height: root.confirm-restart ? self.preferred-height : 0px;
                                    label: "确认";
                                    danger: true;
                                    enabled: !root.gateway-restarting;
                                    clicked => {
                                        root.confirm-restart = false;
                                        root.restart-gateway();
                                    }
                                }
                                if root.confirm-restart : ActionButton {
                                    label: "取消";
                                    quiet: true;
                                    clicked => { root.confirm-restart = false; }
                                }
                            }
                            Divider { }
                            gateway-address-row := SettingRow {
                                label: "模型 API 地址";
                                gateway-address := DataText {
                                    text: root.access-display-address;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    wrap: no-wrap;
                                }
                                copy-base := ActionButton {
                                    width: Theme.icon-button;
                                    height: Theme.icon-button;
                                    label: root.base-copied ? "已复制" : "复制";
                                    icon: root.base-copied ? "check" : "copy";
                                    quiet: true;
                                    enabled: root.access-address-available;
                                    tooltip: "复制模型 API 地址";
                                    clicked => { root.request-copy(root.access-display-address, 1); }
                                }
                                copy-v1 := ActionButton {
                                    width: Theme.icon-button;
                                    height: Theme.icon-button;
                                    label: root.v1-copied ? "已复制" : "复制";
                                    icon: root.v1-copied ? "check" : "copy";
                                    quiet: true;
                                    enabled: root.access-address-available;
                                    tooltip: "复制 /v1 地址";
                                    clicked => {
                                        root.request-copy(
                                            root.access-full-base-url.is-empty
                                                ? root.access-display-address + "/v1"
                                                : root.access-full-base-url,
                                            2
                                        );
                                    }
                                }
                            }
                            access-address-note := Hint {
                                visible: !root.access-address-note.is-empty;
                                height: self.visible ? self.preferred-height : 0px;
                                text: root.access-address-note;
                                color: Theme.status_ink(root.access-tone);
                            }
                            access-type-row := SettingRow {
                                label: "接口类型";
                                access-type-value := Hint {
                                    text: root.access-interface-type;
                                    color: Theme.status_ink(root.access-tone);
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    wrap: no-wrap;
                                }
                            }
                            access-hints := VerticalLayout {
                                visible: root.access-hints.length > 0;
                                height: self.visible ? self.preferred-height : 0px;
                                spacing: 4px;
                                for hint in root.access-hints : Hint { text: hint; }
                            }
                            access-status-hint := Hint {
                                visible: !root.access-status.is-empty;
                                height: self.visible ? self.preferred-height : 0px;
                                text: root.access-status;
                                color: Theme.status_ink(root.access-tone);
                            }
                        }
                    }
                    technical-card := ClickableCard {
                        card-label: "实例管理";
                        inset: 16px;
                        gap: 12px;
                        checked: root.show-technical;
                        activated => { root.show-technical = !root.show-technical; }
                        VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 8px;
                                SectionLabel { text: "实例管理"; horizontal-stretch: 1; vertical-alignment: center; }
                                // The desktop renderer supports 2D transforms, so the
                                // disclosure chevron rotates literally instead of
                                // cross-fading two glyphs.
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    cross-axis-self-alignment: center;
                                    AppIcon {
                                        x: 0px;
                                        y: 0px;
                                        size: 16px;
                                        kind: "chevron-right";
                                        tint: technical-card.hovered || technical-card.focused || root.show-technical ? Theme.accent : Theme.muted;
                                        transform-rotation: root.show-technical ? 90deg : 0deg;
                                        animate transform-rotation { duration: 160ms; easing: ease-out; }
                                        animate tint { duration: Theme.quick; easing: ease-in-out; }
                                    }
                                }
                            }
                            details := Rectangle {
                                visible: root.show-technical || self.height > 0px;
                                preferred-height: root.show-technical ? details-content.preferred-height : 0px;
                                height: self.preferred-height;
                                clip: true;
                                animate preferred-height { duration: Theme.settle; easing: ease-out; }
                                details-content := VerticalLayout {
                                    spacing: 12px;
                                    instance-supervision := SettingRow {
                                        label: "网关状态";
                                        instance-supervision-value := Hint {
                                            text: root.supervision-value + (root.supervision-detail.is-empty ? "" : "  " + root.supervision-detail);
                                            color: Theme.status_ink(root.supervision-tone);
                                            horizontal-stretch: 1;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            wrap: no-wrap;
                                        }
                                    }
                                    instance-config := SettingRow {
                                        label: "配置文件";
                                        instance-config-value := DataText {
                                            text: root.config-path;
                                            horizontal-stretch: 1;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            wrap: no-wrap;
                                        }
                                        instance-config-copy := ActionButton {
                                            width: Theme.icon-button; height: Theme.icon-button;
                                            label: "复制配置文件路径"; icon: "copy"; icon-only: true; quiet: true;
                                            tooltip: "复制配置文件路径";
                                            clicked => { root.copy-text(root.config-path); }
                                        }
                                    }
                                    instance-data := SettingRow {
                                        label: "实例数据";
                                        instance-data-value := DataText {
                                            text: root.instance-path;
                                            horizontal-stretch: 1;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            wrap: no-wrap;
                                        }
                                        instance-data-copy := ActionButton {
                                            width: Theme.icon-button; height: Theme.icon-button;
                                            label: "复制实例数据路径"; icon: "copy"; icon-only: true; quiet: true;
                                            tooltip: "复制实例数据路径";
                                            clicked => { root.copy-text(root.instance-path); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // The UM model catalog: a strict refresh, one row per model
                    // and the full facts behind each row's 详情. A failed refresh
                    // keeps the rows and marks them 已过期; an empty catalog is
                    // the legal 无模型 state instead of stale rows.
                    model-card := Card {
                        inset: 16px;
                        gap: 12px;
                        VerticalLayout {
                            alignment: start;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 8px;
                                SectionLabel { text: "UM 模型"; horizontal-stretch: 1; vertical-alignment: center; }
                                um-model-stale-tag := Tag {
                                    visible: root.um-model-stale;
                                    label: "已过期";
                                    tone: 1;
                                    cross-axis-self-alignment: center;
                                }
                                um-model-refresh := ActionButton {
                                    label: "刷新 UM 模型列表";
                                    icon: "refresh";
                                    quiet: true;
                                    enabled: !root.um-model-loading;
                                    tooltip: "严格从 UM 取新目录，不使用缓存";
                                    clicked => { root.refresh-um-models(); }
                                }
                            }
                            um-model-status-hint := Hint {
                                text: root.um-model-status;
                                color: Theme.status_ink(root.um-model-tone);
                            }
                            um-model-empty := VerticalLayout {
                                visible: root.um-model-empty;
                                alignment: center;
                                spacing: 4px;
                                Hint { text: "无模型"; color: Theme.ink; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
                                Hint { text: "后端合法地返回了 0 个模型"; horizontal-alignment: center; }
                            }
                            um-model-header := HorizontalLayout {
                                visible: root.um-models.length > 0;
                                height: 20px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Hint { text: "模型名称 / ID"; horizontal-stretch: 1; vertical-alignment: center; }
                                Hint { text: "上下文信息"; width: root.compact ? 90px : 120px; vertical-alignment: center; }
                                Hint { text: "思考档位"; width: root.compact ? 100px : 150px; vertical-alignment: center; }
                                Hint { text: "最近测试"; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                            um-model-list := ListView {
                                visible: root.um-models.length > 0;
                                height: min(240px, root.um-models.length * 56px);
                                for item in root.um-models : Selectable {
                                    label: item.name + " " + item.id + " " + item.context + " " + item.efforts + " " + item.last-test;
                                    height: 56px;
                                    selected: root.selected-model == item.id;
                                    activate => { root.open-model(item.id); }
                                    VerticalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-top: 5px;
                                        padding-bottom: 5px;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 1px;
                                                Text { text: item.name; color: Theme.ink; font-weight: 600; overflow: elide; vertical-alignment: center; }
                                                DataText { text: item.id; font-size: 11px; overflow: elide; vertical-alignment: center; }
                                            }
                                            Hint { text: item.context; width: root.compact ? 90px : 120px; vertical-alignment: center; }
                                            Hint { text: item.efforts; width: root.compact ? 100px : 150px; vertical-alignment: center; }
                                            Hint { text: item.last-test; horizontal-stretch: 1; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                            um-model-detail := TextDetails {
                                visible: !root.selected-model.is-empty;
                                height: self.visible ? 190px : 0px;
                                animate height { duration: Theme.settle; easing: ease-out; }
                                title: root.um-model-detail-title;
                                body: root.um-model-detail;
                                closed => { root.selected-model = ""; }
                            }
                            // Context probes (#154): pick a batch, run it, stop the
                            // rest and read the collapsible history. The gateway keeps
                            // the queue and the per-model results, so this card only
                            // reads and submits; a failed probe keeps its reason.
                            Divider { }
                            probe-toolbar := HorizontalLayout {
                                spacing: 8px;
                                probe-select-all := ActionButton {
                                    label: "全选";
                                    quiet: true;
                                    enabled: root.probe-models.length > 0;
                                    clicked => { root.select-all-probes(); }
                                }
                                probe-selection-hint := Hint {
                                    text: root.probe-selection-text;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                probe-run := ActionButton {
                                    label: root.probe-loading ? "正在提交…" : "上下文探测";
                                    icon: "play";
                                    primary: true;
                                    enabled: root.probe-run-enabled;
                                    tooltip: "按顺序对已勾选模型执行上下文探测；整批共用请求预算";
                                    clicked => { root.run-context-probe(); }
                                }
                                probe-stop := ActionButton {
                                    visible: root.probe-running;
                                    label: root.probe-stop-requested ? "已请求停止" : "停止后续探测";
                                    icon: "close";
                                    danger: true;
                                    enabled: root.probe-stop-enabled;
                                    tooltip: "在途请求返回后不再开始后续模型";
                                    clicked => { root.stop-context-probe(); }
                                }
                                probe-clear := ActionButton {
                                    label: "清空选择";
                                    quiet: true;
                                    enabled: root.probe-selected.length > 0;
                                    clicked => { root.clear-probe-selection(); }
                                }
                            }
                            probe-status-hint := Hint {
                                text: root.probe-status;
                                color: Theme.status_ink(root.probe-tone);
                            }
                            probe-progress-hint := Hint {
                                visible: !root.probe-progress.is-empty;
                                text: root.probe-progress;
                            }
                            probe-budget-hint := Hint {
                                text: root.probe-budget;
                            }
                            probe-empty := Hint {
                                visible: root.probe-models.length == 0;
                                text: "没有可探测的模型：先刷新 UM 模型目录";
                            }
                            probe-model-list := ListView {
                                visible: root.probe-models.length > 0;
                                height: min(220px, root.probe-models.length * 44px);
                                for item in root.probe-models : Selectable {
                                    label: item.name + " " + item.model-id + " " + item.state + " " + item.summary;
                                    height: 44px;
                                    selected: item.selected;
                                    activate => { root.toggle-probe-model(item.model-id); }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;
                                        ProbeCheck {
                                            checked: item.selected;
                                            label: "选择 " + item.name;
                                            toggled => { root.toggle-probe-model(item.model-id); }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 1px;
                                            Text {
                                                text: item.name;
                                                color: Theme.ink;
                                                font-weight: 600;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            DataText {
                                                text: item.model-id;
                                                font-size: 11px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Hint {
                                            text: item.state;
                                            width: 76px;
                                            color: Theme.status_ink(item.tone);
                                            vertical-alignment: center;
                                        }
                                        Hint {
                                            text: item.summary;
                                            horizontal-stretch: 2;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            probe-history-toggle := ActionButton {
                                label: root.probe-history-open
                                    ? "收起历史测试记录"
                                    : "历史测试记录（" + root.probe-history.length + "）";
                                icon: root.probe-history-open ? "chevron-down" : "chevron-right";
                                quiet: true;
                                clicked => { root.probe-history-open = !root.probe-history-open; }
                            }
                            probe-history-body := VerticalLayout {
                                visible: root.probe-history-open;
                                height: self.visible ? self.preferred-height : 0px;
                                spacing: 6px;
                                probe-history-empty := Hint {
                                    visible: root.probe-history.length == 0;
                                    text: "没有历史测试记录";
                                }
                                probe-history-list := ListView {
                                    visible: root.probe-history.length > 0;
                                    height: min(220px, root.probe-history.length * 40px);
                                    for row in root.probe-history : Selectable {
                                        label: row.time + " " + row.model + " " + row.result + " " + row.summary;
                                        height: 40px;
                                        VerticalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            padding-top: 3px;
                                            padding-bottom: 3px;
                                            spacing: 1px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                DataText {
                                                    text: row.time;
                                                    width: 110px;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: row.model;
                                                    horizontal-stretch: 1;
                                                    color: Theme.ink;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                Hint {
                                                    text: row.result;
                                                    width: 64px;
                                                    color: Theme.status_ink(row.tone);
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Hint {
                                                text: row.summary;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    login-rounds-card := Card {
                        inset: 16px;
                        gap: 12px;
                        VerticalLayout {
                            alignment: start;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                login-rounds-title := SectionLabel {
                                    text: "UM 登录轮次";
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                login-rounds-refresh := ActionButton {
                                    width: Theme.icon-button;
                                    height: Theme.icon-button;
                                    label: "刷新登录轮次";
                                    icon: "refresh";
                                    icon-only: true;
                                    quiet: true;
                                    enabled: !root.login-rounds-loading;
                                    tooltip: "重新读取本实例网关的登录历史";
                                    clicked => { root.refresh-login-rounds(); }
                                }
                            }
                            Hint { text: "来源：本实例网关的登录历史（只读，不触发探测或登录）。"; }
                            HorizontalLayout {
                                spacing: 8px;
                                login-rounds-round-filter := MaterialField {
                                    width: root.compact ? 110px : 130px;
                                    placeholder: "轮次";
                                    numeric: true;
                                    text <=> root.login-rounds-round-filter;
                                    accepted => { root.filter-login-rounds(root.login-rounds-round-filter, root.login-rounds-reason-filter); }
                                }
                                login-rounds-reason-filter := MaterialField {
                                    width: root.compact ? 150px : 220px;
                                    placeholder: "按原因或结果查找";
                                    clearable: true;
                                    text <=> root.login-rounds-reason-filter;
                                    accepted => { root.filter-login-rounds(root.login-rounds-round-filter, root.login-rounds-reason-filter); }
                                    cleared => { root.filter-login-rounds(root.login-rounds-round-filter, root.login-rounds-reason-filter); }
                                }
                                login-rounds-filter := FocusAction {
                                    label: "筛选";
                                    icon: "search";
                                    quiet: true;
                                    clicked => { root.filter-login-rounds(root.login-rounds-round-filter, root.login-rounds-reason-filter); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                StatusDot {
                                    tone: root.login-rounds-tone;
                                    y: (parent.height - self.height) / 2;
                                }
                                Hint {
                                    text: root.login-rounds-status;
                                    color: Theme.status_ink(root.login-rounds-tone);
                                    vertical-alignment: center;
                                    overflow: elide;
                                    wrap: no-wrap;
                                    horizontal-stretch: 1;
                                }
                                if root.login-rounds-truncated : Hint {
                                    text: "已达单页上限";
                                    color: Theme.status_ink(1);
                                    vertical-alignment: center;
                                }
                            }
                            login-rounds-scope-hint := Hint {
                                visible: !root.login-rounds-scope.is-empty;
                                text: root.login-rounds-scope;
                            }
                            if root.login-rounds-table-visible && !root.compact : HorizontalLayout {
                                height: 20px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Hint { text: "开始（北京时间）"; width: 118px; vertical-alignment: center; }
                                Hint { text: "轮次"; width: 36px; vertical-alignment: center; }
                                Hint { text: "状态"; width: 64px; vertical-alignment: center; }
                                Hint { text: "模式"; width: 56px; vertical-alignment: center; }
                                Hint { text: "触发来源"; width: 72px; vertical-alignment: center; }
                                Hint { text: "提交"; width: 36px; vertical-alignment: center; }
                                Hint { text: "结果"; width: 72px; vertical-alignment: center; }
                                Hint { text: "原因"; horizontal-stretch: 1; vertical-alignment: center; }
                                Hint { text: "上游 / 证据"; width: 120px; vertical-alignment: center; }
                            }
                            login-rounds-list := ListView {
                                visible: root.login-rounds-table-visible;
                                height: min(280px, root.login-rounds.length * root.login-rounds-row-height);
                                for row in root.login-rounds : Selectable {
                                    label: row.at + " 轮次 " + row.round + " " + row.state
                                        + " " + row.mode + " " + row.trigger + " 提交 " + row.submit
                                        + " " + row.outcome + " " + row.reason + " " + row.upstream;
                                    height: root.login-rounds-row-height;
                                    selected: root.login-rounds-selected == row.key;
                                    activate => { root.open-login-round(row.key); }
                                    if root.compact : VerticalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        spacing: 1px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            DataText { text: row.at; horizontal-stretch: 1; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                            DataText { text: "轮次 " + row.round; width: 52px; vertical-alignment: center; }
                                            Tag { label: row.state; tone: row.state-tone; width: 64px; }
                                            Hint { text: row.mode; width: 56px; vertical-alignment: center; }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Hint { text: "触发 " + row.trigger; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                            Hint { text: "提交 " + row.submit; width: 52px; vertical-alignment: center; }
                                            Hint { text: row.outcome; width: 72px; vertical-alignment: center; overflow: elide; }
                                            Hint { text: row.upstream; width: 110px; vertical-alignment: center; overflow: elide; }
                                        }
                                        Hint { text: "原因 " + row.reason; overflow: elide; }
                                    }
                                    if !root.compact : HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;
                                        DataText { text: row.at; width: 118px; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                        DataText { text: row.round; width: 36px; vertical-alignment: center; }
                                        Tag { label: row.state; tone: row.state-tone; width: 64px; }
                                        Hint { text: row.mode; width: 56px; vertical-alignment: center; }
                                        Hint { text: row.trigger; width: 72px; vertical-alignment: center; overflow: elide; }
                                        DataText { text: row.submit; width: 36px; vertical-alignment: center; }
                                        Hint { text: row.outcome; width: 72px; vertical-alignment: center; overflow: elide; }
                                        Hint { text: row.reason; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                        Hint { text: row.upstream; width: 120px; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                            login-rounds-empty-hint := Hint {
                                visible: !root.login-rounds-empty-text.is-empty;
                                text: root.login-rounds-empty-text;
                            }
                            login-rounds-detail := TextDetails {
                                visible: !root.login-rounds-selected.is-empty || self.height > 0px;
                                height: root.login-rounds-selected.is-empty ? 0px : root.compact ? 150px : 190px;
                                animate height { duration: Theme.settle; easing: ease-out; }
                                title: root.login-rounds-detail-title;
                                body: root.login-rounds-detail;
                                closed => { root.open-login-round(""); }
                            }
                        }
                    }
                }
            }

            // Help is a first-class page: shortcuts, the UM login flow and the
            // port switch each get their own card, plus the on-disk locations
            // that document the running instance.
            help-scroll := ScrollView {
                visible: root.page == 4;
                vertical-stretch: 1;
                content-width: self.visible-width;
                help-content := VerticalLayout {
                    alignment: start;
                    min-height: self.preferred-height;
                    spacing: 12px;
                    padding-right: 8px;
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "快捷键"; }
                            HorizontalLayout { spacing: 12px; DataText { text: "Ctrl+1…4"; width: 96px; } Hint { text: "切换总览、请求诊断、运行日志、设置"; horizontal-stretch: 1; } }
                            HorizontalLayout { spacing: 12px; DataText { text: "Ctrl+R"; width: 96px; } Hint { text: "刷新当前页数据"; horizontal-stretch: 1; } }
                            HorizontalLayout { spacing: 12px; DataText { text: "Ctrl+F"; width: 96px; } Hint { text: "聚焦请求或日志搜索框"; horizontal-stretch: 1; } }
                            HorizontalLayout { spacing: 12px; DataText { text: "Esc"; width: 96px; } Hint { text: "关闭当前页的详情或账号表单"; horizontal-stretch: 1; } }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "UM 登录"; }
                            Hint { text: "在「总览」或「设置」中录入 UMPASS 账号密码。账号密码只保存在本机，本实例网关会用它们自动重新登录。"; }
                            Hint { text: "点「按需登录」会先核验当前凭据，有效时不打开窗口；需要人工完成 Duo 验证时，点「继续登录」会打开可见的 Edge 窗口，完成后回到控制台即可看到登录状态。"; }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "端口切换"; }
                            Hint { text: "在「设置 → 网关端口」修改端口。切换前会检查新端口是否可用，并等待在途请求结束；失败时恢复原端口。"; }
                            Hint { text: "模型 API 只监听本机回环地址，分享链不会经过这个端口。"; }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "指标说明"; }
                            HorizontalLayout { spacing: 12px; DataText { text: "Token"; width: 96px; } Hint { text: "模型返回的输入与输出 Token 总量"; horizontal-stretch: 1; } }
                            HorizontalLayout { spacing: 12px; DataText { text: "缓存命中率"; width: 96px; } Hint { text: "缓存读取 Token 占输入 Token 的比例"; horizontal-stretch: 1; } }
                            HorizontalLayout { spacing: 12px; DataText { text: "首字耗时"; width: 96px; } Hint { text: "从请求开始到首个输出 Token 的时间"; horizontal-stretch: 1; } }
                            HorizontalLayout { spacing: 12px; DataText { text: "输出速度"; width: 96px; } Hint { text: "整次请求的输出 Token 除以总耗时"; horizontal-stretch: 1; } }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "本机数据"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Hint { text: "配置文件"; width: 96px; }
                                DataText { text: root.config-path; horizontal-stretch: 1; overflow: elide; wrap: no-wrap; }
                                ActionButton {
                                    width: Theme.icon-button; height: Theme.icon-button;
                                    label: "复制配置文件路径"; icon: "copy"; icon-only: true; quiet: true;
                                    tooltip: "复制配置文件路径";
                                    clicked => { root.copy-text(root.config-path); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Hint { text: "实例数据"; width: 96px; }
                                DataText { text: root.instance-path; horizontal-stretch: 1; overflow: elide; wrap: no-wrap; }
                                ActionButton {
                                    width: Theme.icon-button; height: Theme.icon-button;
                                    label: "复制实例数据路径"; icon: "copy"; icon-only: true; quiet: true;
                                    tooltip: "复制实例数据路径";
                                    clicked => { root.copy-text(root.instance-path); }
                                }
                            }
                        }
                    }
                }
            }
            // The maintenance menu overlay: the app instance gateway is the UM
            // service itself. A closed action shows its reason; the first click
            // only arms the inline confirmation. The records area says 不适用
            // because the app instance has no console-state.sqlite3 source.
            maintenance-menu := Panel {
                visible: root.maintenance-menu-open && root.page == 0;
                x: page-host.width - self.width - 8px;
                y: 36px;
                width: min(520px, page-host.width - 16px);
                height: maintenance-menu-content.preferred-height;
                z: 20;
                maintenance-menu-content := VerticalLayout {
                    width: parent.width;
                    padding: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        SectionLabel {
                            text: "维护";
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        ActionButton {
                            label: "关闭维护菜单";
                            icon: "close";
                            icon-only: true;
                            quiet: true;
                            clicked => {
                                root.maintenance-menu-open = false;
                                root.maintenance-confirm = -1;
                            }
                        }
                    }
                    Hint { text: "每项动作先显示影响，二次确认后才执行。"; }
                    maintenance-verify := MaintenanceItem {
                        item: root.maintenance-items[0];
                        confirming: root.maintenance-confirm == 0;
                        busy: root.maintenance-busy;
                        activate => { root.maintenance-confirm = 0; }
                        confirmed => {
                            root.maintenance-confirm = -1;
                            root.maintenance-act(0);
                        }
                        cancelled => { root.maintenance-confirm = -1; }
                    }
                    maintenance-login := MaintenanceItem {
                        item: root.maintenance-items[1];
                        confirming: root.maintenance-confirm == 1;
                        busy: root.maintenance-busy;
                        activate => { root.maintenance-confirm = 1; }
                        confirmed => {
                            root.maintenance-confirm = -1;
                            root.maintenance-act(1);
                        }
                        cancelled => { root.maintenance-confirm = -1; }
                    }
                    maintenance-start := MaintenanceItem {
                        item: root.maintenance-items[2];
                        confirming: root.maintenance-confirm == 2;
                        busy: root.maintenance-busy;
                        activate => { root.maintenance-confirm = 2; }
                        confirmed => {
                            root.maintenance-confirm = -1;
                            root.maintenance-act(2);
                        }
                        cancelled => { root.maintenance-confirm = -1; }
                    }
                    maintenance-stop := MaintenanceItem {
                        item: root.maintenance-items[3];
                        confirming: root.maintenance-confirm == 3;
                        busy: root.maintenance-busy;
                        activate => { root.maintenance-confirm = 3; }
                        confirmed => {
                            root.maintenance-confirm = -1;
                            root.maintenance-act(3);
                        }
                        cancelled => { root.maintenance-confirm = -1; }
                    }
                    maintenance-restart := MaintenanceItem {
                        item: root.maintenance-items[4];
                        confirming: root.maintenance-confirm == 4;
                        busy: root.maintenance-busy;
                        activate => { root.maintenance-confirm = 4; }
                        confirmed => {
                            root.maintenance-confirm = -1;
                            root.maintenance-act(4);
                        }
                        cancelled => { root.maintenance-confirm = -1; }
                    }
                    if root.maintenance-busy : Hint {
                        text: "同一操作正在进行，等待它结束";
                        color: Theme.status_ink(1);
                    }
                    if !root.maintenance-status.is-empty : Hint {
                        text: root.maintenance-status;
                        color: Theme.status_ink(root.maintenance-status-tone);
                    }
                    Divider { }
                    SectionLabel { text: "维护记录"; }
                    Hint {
                        text: root.maintenance-records-status;
                        color: Theme.status_ink(root.maintenance-records-tone);
                    }
                    if root.maintenance-table-visible : VerticalLayout {
                        spacing: 6px;
                        for record-row in root.maintenance-records : HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: record-row.at;
                                color: Theme.ink;
                                font-size: 12px;
                            }
                            Text {
                                text: record-row.action;
                                color: Theme.ink;
                                font-size: 12px;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: record-row.result;
                                color: Theme.muted;
                                font-size: 12px;
                            }
                        }
                    }
                }
            }
            }

            status-row := HorizontalLayout {
                spacing: 8px;
                status-dot := StatusDot { tone: root.status-tone; y: (parent.height - self.height) / 2; }
                Hint { text: root.status-line; horizontal-stretch: 1; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
                copy-status-hint := Hint {
                    visible: !root.copy-status.is-empty;
                    text: root.copy-status;
                    color: Theme.status_ink(root.copy-tone);
                    vertical-alignment: center;
                    overflow: elide;
                    wrap: no-wrap;
                }
                DataText { text: "全局更新于 " + root.last-update; vertical-alignment: center; }
            }
        }
    }
    }
}
