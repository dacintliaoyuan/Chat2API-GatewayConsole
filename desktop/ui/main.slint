    out property <string> overview-address-icon: overview-address.icon;
    out property <string> overview-v1-icon: overview-v1.icon;
    out property <string> copy-status: !root.copy-error.is-empty ? "复制失败：" + root.copy-error
        : root.copy-ok ? "已复制到剪贴板" : "";
    out property <int> copy-tone: !root.copy-error.is-empty ? 2 : root.copy-ok ? 0 : 3;
    out property <bool> copy-status-visible: copy-status-hint.visible;
    out property <length> usage-plot-x: usage-chart.plot-x;
    out property <length> usage-plot-y: usage-chart.plot-y;
