import { ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme, Panel, Heading, Hint, Selectable, ActionButton, FocusAction, NavItem, Field, MaterialField, Toggle, Segmented, Tag, StatusDot, DataText, SectionLabel } from "theme.slint";
import { ChartEngine, ChartTheme } from "@slintplot";
import { AppIcon } from "icons.slint";
export { ChartEngine }
import { UsageChart, UsagePoint } from "usage-chart.slint";
export { UsagePoint }

export struct LogRow {
    id: string,
    at: string,
    level: string,
    text: string,
    detail: string,
}

export struct RequestRow {
    id: string,
    at: string,
    model: string,
    outcome: string,
    tone: int,
    summary: string,
    detail: string,
}

// One navigation entry. The page number lives next to its label so the rail and
// the page title can never drift apart again.
export struct NavEntry {
    label: string,
    page: int,
}

component StateCell inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <int> tone: 3;
    in property <bool> pulse: false;
    spacing: 4px;
    alignment: start;
    Text { text: root.label; color: Theme.muted; font-size: 11px; font-weight: 600; }
    HorizontalLayout {
        spacing: 7px;
        alignment: start;
        StatusDot {
            tone: root.tone;
            y: (parent.height - self.height) / 2;
            pulsing: root.pulse;
        }
        Text {
            text: root.value;
            color: Theme.ink;
            font-family: Theme.font-display;
            font-weight: 650;
            font-size: 15px;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    Hint { text: root.detail; visible: !root.detail.is-empty; }
    @children
}

component Divider inherits Rectangle { height: 1px; background: Theme.edge; }

component TextDetails inherits Panel {
    in property <string> title;
    in property <string> body;
    callback closed();
    // A copy is confirmed in place for 1.2 s so the action never looks like a
    // no-op; a new body clears the old acknowledgement immediately.
    in-out property <bool> copied: false;
    changed body => { root.copied = false; }
    // Test seam: the acknowledgement and the copy control geometry.
    out property <length> copy-x: copy-button.absolute-position.x;
    out property <length> copy-y: copy-button.absolute-position.y;
    out property <length> copy-width: copy-button.width;
    out property <length> copy-height: copy-button.height;
    copy-timer := Timer {
        interval: 1.2s;
        running: false;
        triggered => { root.copied = false; }
    }
    clip: true;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Heading { text: root.title; horizontal-stretch: 1; vertical-alignment: center; }
            copy-button := ActionButton {
                width: root.copied ? 70px : Theme.icon-button;
                height: Theme.icon-button;
                label: root.copied ? "已复制" : "复制全文";
                icon: root.copied ? "check" : "copy";
                icon-only: !root.copied;
                quiet: true;
                tooltip: root.copied ? "已复制" : "复制全文";
                clicked => {
                    full-text.select-all();
                    full-text.copy();
                    root.copied = true;
                    copy-timer.start();
                }
            }
            ActionButton { width: Theme.icon-button; height: Theme.icon-button; label: "关闭"; icon: "close"; icon-only: true; quiet: true; tooltip: "关闭详情"; clicked => { root.closed(); } }
        }
        // The platform text editor draws an accent underline when focused; the
        // wrapper clips those last two pixels so the detail panel keeps the
        // neutral console surface while selection and copy still work.
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            full-text := TextEdit {
                width: parent.width;
                height: parent.height + 2px;
                text: root.body;
                read-only: true;
                wrap: word-wrap;
                font-family: Theme.font-data;
                font-size: 11px;
                accessible-label: root.title;
            }
        }
    }
}

// A card in a scrollable page. A plain Rectangle in a layout has a zero
// preferred height and stretch 1, so it would absorb the viewport height and
// leave no room for the following siblings. Size it from its content instead and
// opt out of the layout's extra space, so the page scrolls when content overflows.
//
// A clickable card is one target: the pointer and the keyboard activate the same
// callback, hover steps the neutral surface and edge, and focus uses the same
// neutral step instead of a blue outline.
component Card inherits Panel {
    in property <length> inset: 16px;
    in property <length> gap: 10px;
    in property <bool> clickable: false;
    callback activated();
    out property <bool> hovered: root.clickable && pointer.has-hover;
    out property <bool> focused: root.clickable && keyboard.has-focus;
    out property <length> content-height: content.preferred-height;
    out property <length> content-width: content.width;
    vertical-stretch: 0;
    preferred-height: content.preferred-height;
    background: root.hovered || root.focused ? Theme.surface-2 : Theme.surface;
    border-color: root.hovered || root.focused ? Theme.edge-strong : Theme.edge;
    animate background, border-color { duration: Theme.quick; easing: ease-in-out; }
    drop-shadow-offset-y: 1px;
    drop-shadow-blur: 3px;
    drop-shadow-color: Theme.card-shadow;
    content := VerticalLayout {
        padding: root.inset;
        spacing: root.gap;
        @children
    }
    keyboard := FocusScope {
        enabled: root.clickable;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    pointer := TouchArea {
        enabled: root.clickable;
        mouse-cursor: MouseCursor.pointer;
        clicked => { keyboard.focus(); root.activated(); }
    }
}

// The instance card is one target: the pointer and the keyboard both toggle the
// detail, and hover or focus steps the same neutral surface and edge.
component ClickableCard inherits Card {
    in property <string> card-label;
    // Disclosure state exposed to assistive technology as both the check state
    // and the expanded state, since the same card opens and closes details.
    in-out property <bool> checked: false;
    clickable: true;
    accessible-role: button;
    accessible-label: root.card-label;
    accessible-checked: root.checked;
    accessible-expanded: root.checked;
    accessible-action-default => { root.activated(); }
}

export component MainWindow inherits Window {
    title: "本机控制台";
    preferred-width: 1060px;
    preferred-height: 720px;
    min-width: 540px;
    min-height: 420px;
    background: Theme.background;
    default-font-family: "Segoe UI";
    default-font-size: 12px;
    // Keep the shortcut handler reachable when no control owns focus.
    forward-focus: root-focus;
    private property <bool> compact: root.width < 800px;
    // The card stays after "稍后登录": skipping the first-run prompt must not
    // remove the explanation or the way back to the account form.
    private property <bool> login-visible: root.account-label != "已登录"
        || !root.login-status.is-empty || root.account-can-continue;
    // The rail and the page title read from the same table, so a page has one
    // name and one number everywhere.
    private property <[NavEntry]> nav-entries: [
        { label: "总览", page: 0 },
        { label: "请求诊断", page: 1 },
        { label: "运行日志", page: 3 },
        { label: "设置", page: 2 },
        { label: "帮助", page: 4 },
    ];
    private property <[string]> page-titles: ["总览", "请求诊断", "设置", "运行日志", "帮助"];
    // The account cell always carries a detail line so the three state columns
    // keep the same rhythm, even when the gateway only reports "已登录".
    public pure function account-state-detail() -> string {
        if (!root.account-detail.is-empty) { return root.account-detail; }
        if (root.account-label == "已登录") { return "登录状态正常"; }
        if (root.account-saved == "未配置账号") { return "未配置账号"; }
        return "登录后可用";
    }

    in-out property <int> page: 0;
    private property <float> page-opacity: 1;
    private property <int> pending-page: 0;
    init => { Theme.motion = root.allow-motion; root.apply-chart-theme(); }
    changed allow-motion => {
        Theme.motion = root.allow-motion;
        if (!root.allow-motion) { Theme.pulse-on = false; }
        root.apply-chart-theme();
    }
    // The chart library keeps its own palette; follow the system theme when it
    // changes at runtime instead of only reading it once at startup. The local
    // mirror gives `changed` a property name it can observe.
    private property <bool> chart-dark: Theme.dark;
    changed chart-dark => { root.apply-chart-theme(); }
    changed visible => { if (root.visible && root.allow-motion) { pulse-timer.start(); } }
    // The chart library owns a second theme; align its axes and motion with the
    // console so the plot does not read as a second design system.
    function apply-chart-theme() {
        ChartTheme.dark = Theme.dark;
        ChartTheme.text-color = Theme.muted;
        ChartTheme.grid-color = Theme.grid;
        ChartTheme.axis-color = Theme.edge;
        ChartTheme.font-size = 11px;
        ChartTheme.animation-duration = root.allow-motion ? 420ms : 0ms;
    }
    in property <string> gateway-value: "检测中";
    in property <string> gateway-detail;
    in property <int> gateway-tone: 3;
    in property <bool> gateway-pulse: true;
    in property <string> supervision-value;
    in property <string> supervision-detail;
    in property <int> supervision-tone: 3;
    in property <string> upstream-value: "检测中";
    in property <string> upstream-detail;
    in property <int> upstream-tone: 3;
    in property <bool> upstream-pulse: true;
    in property <string> account-label: "读取中";
    in property <string> account-detail;
    in property <int> account-tone: 3;
    in property <bool> account-pulse: true;
    in property <string> account-saved: "未配置账号";
    in property <string> account-saved-detail;
    in property <bool> account-can-clear;
    in property <bool> account-can-continue;
    in property <bool> account-form-visible;
    in property <bool> account-busy;
    in property <bool> show-intro;
    in-out property <string> credential-account-input;
    in-out property <string> credential-password-input;
    in-out property <bool> account-input-invalid;
    in-out property <string> account-input-error;
    in-out property <bool> password-input-invalid;
    in-out property <string> password-input-error;
    in property <bool> password-visible;
    in property <string> credential-status;
    in property <int> credential-tone: 3;
    in property <string> login-status;
    in property <int> login-tone: 3;
    in property <string> status-line;
    in property <int> status-tone: 0;
    // Inline clear confirmation: one click arms it, the next click clears.
    private property <bool> confirm-clear: false;
    // The tray-less exit uses the same two-step inline confirmation.
    private property <bool> confirm-quit: false;
    in property <string> last-update: "—";
    // Manual refresh is one shared action: the icon spins for 600 ms and every
    // refresh button stays disabled until the spin ends. Auto refresh only drives
    // the overview and never touches the log page's live follow.
    in-out property <bool> refreshing: false;
    out property <angle> refresh-rotation: 0deg;
    in-out property <int> auto-refresh: 5;
    in-out property <bool> refresh-paused: false;
    in-out property <int> auto-refresh-index: 0;
    in property <string> overview-updated-at: "—";
    in property <string> request-updated-at: "—";
    in property <string> log-updated-at: "—";
    in property <string> settings-updated-at: "—";
    in-out property <int> usage-period: 0;
    in property <[UsagePoint]> usage-points: [];
    in property <[string]> usage-labels;
    in property <[float]> usage-token-counts;
    in property <[float]> usage-request-counts;
    in property <string> token-total: "—";
    in property <string> request-total: "—";
    in property <bool> usage-loading: true;
    in property <string> usage-status;
    in property <int> usage-tone: 3;
    in property <bool> allow-motion: true;
    // The saved appearance choice: 0 follows the system, 1 light, 2 dark.
    in-out property <int> theme-mode <=> Theme.theme-mode;
    // Test seam: the headless tests stand in for the Windows app theme.
    in-out property <bool> system-dark <=> Theme.system-dark;
    out property <bool> theme-dark: Theme.dark;
    // Test seam: lets the interaction tests switch chart modes without pixels.
    in-out property <bool> usage-show-line: false;
    in-out property <bool> usage-show-requests: false;

    in property <string> log-status: "尚未读取日志";
    in property <int> log-tone: 3;
    // The manual refresh acknowledges itself twice: the status line says it is
    // refreshing, then the button shows 已刷新 for 1.2 s after the read lands.
    in-out property <bool> log-refreshed: false;
    in-out property <bool> log-refresh-pending: false;
    in property <[LogRow]> logs: [];
    in-out property <int> log-filter-level: 0;
    in-out property <string> log-filter-keyword;
    in-out property <bool> log-follow: true;
    in-out property <length> log-scroll-y: 0px;
    in-out property <int> new-log-count;
    in property <int> log-total;
    in property <int> log-version;
    in-out property <int> log-period;
    in property <bool> older-logs;
    in property <bool> newer-logs;
    // Test seam: the log detail state is set by row activation and read by the
    // layout test that checks the list height after closing the detail.
    in-out property <string> open-log-id;
    private property <string> open-log-title;
    private property <string> open-log-body;

    in property <[RequestRow]> requests: [];
    in property <string> request-status: "等待从本实例读取请求记录…";
    in property <int> request-tone: 3;
    in property <bool> older-requests;
    in property <bool> newer-requests;
    in-out property <string> request-keyword;
    in-out property <int> request-period;
    in-out property <int> request-result;
    in-out property <string> selected-request;
    in property <string> request-detail-title;
    in property <string> request-detail;
    in-out property <length> request-scroll-y: 0px;

    in-out property <string> port-input: "7999";
    in-out property <bool> port-input-invalid;
    in-out property <string> port-input-error;
    in property <string> active-address;
    in property <bool> port-busy;
    in property <string> settings-status;
    in property <int> settings-tone: 3;
    in property <string> config-path;
    in property <string> instance-path;
    private property <bool> show-technical;
    in property <bool> tray-available: true;

    // Test seam: geometry and focus facts the keyboard/layout tests assert on.
    out property <length> overview-content-height: overview-content.preferred-height;
    out property <length> overview-viewport-height: overview-scroll.visible-height;
    out property <length> overview-scroll-content-height: overview-scroll.content-height;
    out property <length> overview-state-card-height: state-card.height;
    out property <length> overview-state-content-height: state-card.content-height;
    out property <length> overview-state-content-width: state-card.content-width;
    out property <length> overview-login-card-height: login-card.height;
    out property <length> overview-login-content-height: login-card.content-height;
    out property <length> overview-chart-y: usage-chart.y;
    out property <length> overview-chart-height: usage-chart.height;
    out property <length> usage-plot-x: usage-chart.plot-x;
    out property <length> usage-plot-y: usage-chart.plot-y;
    out property <length> usage-plot-width: usage-chart.plot-width;
    out property <length> usage-plot-height: usage-chart.plot-height;
    out property <int> usage-pinned-index: usage-chart.pinned-index;
    out property <int> usage-active-index: usage-chart.active-index;
    out property <bool> usage-can-unpin: usage-chart.can-unpin;
    out property <string> usage-selection-label: usage-chart.selection-label;
    out property <string> usage-selection-value: usage-chart.selection-value;
    out property <length> usage-unpin-x: usage-chart.unpin-x;
    out property <length> usage-unpin-y: usage-chart.unpin-y;
    out property <length> usage-unpin-width: usage-chart.unpin-width;
    out property <length> usage-unpin-height: usage-chart.unpin-height;
    out property <length> usage-period-x: usage-chart.period-x;
    out property <length> usage-period-y: usage-chart.period-y;
    out property <length> usage-period-width: usage-chart.period-width;
    out property <length> request-period-x: request-period-control.absolute-position.x;
    out property <length> request-period-y: request-period-control.absolute-position.y;
    out property <length> request-period-width: request-period-control.width;
    out property <length> technical-card-x: technical-card.absolute-position.x;
    out property <length> technical-card-y: technical-card.absolute-position.y;
    out property <length> technical-card-width: technical-card.width;
    out property <length> technical-card-height: technical-card.height;
    out property <length> settings-content-height: settings-content.preferred-height;
    out property <length> settings-viewport-height: settings-scroll.visible-height;
    out property <length> request-list-width: request-list-pane.width;
    out property <length> request-list-x: request-list-panel.absolute-position.x;
    out property <length> request-list-y: request-list-panel.absolute-position.y;
    out property <length> request-list-height: request-list-panel.height;
    out property <length> log-list-height: log-list.height;
    out property <length> log-details-height: log-details.height;
    out property <length> log-level-x: log-level-control.absolute-position.x;
    out property <length> log-level-y: log-level-control.absolute-position.y;
    out property <length> log-level-width: log-level-control.width;
    out property <length> log-level-height: log-level-control.height;
    out property <length> status-row-y: status-row.y;
    out property <length> status-row-height: status-row.height;
    out property <length> window-width: root.width;
    out property <length> window-height: root.height;
    out property <bool> account-input-focused: account-input.has-focus;
    out property <bool> password-input-focused: password-input.has-focus;
    out property <bool> password-toggle-focused: password-toggle.has-focus;
    out property <bool> save-button-focused: save-account.has-focus;
    out property <bool> cancel-button-focused: cancel-account.has-focus;
    out property <bool> login-card-visible: login-card.visible;
    out property <bool> skip-login-visible: skip-login-button.visible;
    out property <bool> configure-account-visible: configure-account-button.visible;
    out property <bool> account-saved-detail-visible: account-saved-detail.visible;
    out property <bool> account-clear-visible: clear-account.visible;
    out property <bool> clear-confirm-visible: clear-confirm.visible;
    out property <length> clear-button-x: clear-account.absolute-position.x;
    out property <length> clear-button-y: clear-account.absolute-position.y;
    out property <length> clear-button-width: clear-account.width;
    out property <length> clear-button-height: clear-account.height;
    out property <length> clear-confirm-x: clear-confirm.absolute-position.x;
    out property <length> clear-confirm-y: clear-confirm.absolute-position.y;
    out property <length> clear-confirm-width: clear-confirm.width;
    out property <length> clear-confirm-height: clear-confirm.height;
    out property <int> status-dot-tone: status-dot.tone;
    out property <float> page-title-opacity: page-title.opacity;
    out property <float> page-host-opacity: page-host.opacity;
    // Test seams: the refresh controls, their disabled state, the rotation
    // angle and the per-page update labels.
    out property <string> overview-updated-at-label: "更新于 " + root.overview-updated-at;
    out property <string> request-updated-at-label: "更新于 " + root.request-updated-at;
    out property <string> log-updated-at-label: "更新于 " + root.log-updated-at;
    out property <string> settings-updated-at-label: "更新于 " + root.settings-updated-at;
    out property <length> overview-refresh-x: usage-chart.refresh-x;
    out property <length> overview-refresh-y: usage-chart.refresh-y;
    out property <length> overview-refresh-width: usage-chart.refresh-width;
    out property <length> overview-refresh-height: usage-chart.refresh-height;
    out property <bool> overview-refresh-enabled: usage-chart.refresh-enabled;
    out property <length> request-refresh-x: request-refresh.absolute-position.x;
    out property <length> request-refresh-y: request-refresh.absolute-position.y;
    out property <length> request-refresh-width: request-refresh.width;
    out property <length> request-refresh-height: request-refresh.height;
    out property <bool> request-refresh-enabled: request-refresh.enabled;
    out property <length> log-refresh-x: log-refresh.absolute-position.x;
    out property <length> log-refresh-y: log-refresh.absolute-position.y;
    out property <length> log-refresh-width: log-refresh.width;
    out property <length> log-refresh-height: log-refresh.height;
    out property <bool> log-refresh-enabled: log-refresh.enabled;
    out property <length> settings-refresh-x: settings-refresh.absolute-position.x;
    out property <length> settings-refresh-y: settings-refresh.absolute-position.y;
    out property <length> settings-refresh-width: settings-refresh.width;
    out property <length> settings-refresh-height: settings-refresh.height;
    out property <bool> settings-refresh-enabled: settings-refresh.enabled;
    out property <length> theme-mode-x: theme-mode-control.absolute-position.x;
    out property <length> theme-mode-y: theme-mode-control.absolute-position.y;
    out property <length> theme-mode-width: theme-mode-control.width;
    out property <length> theme-mode-height: theme-mode-control.height;
    // Test seams: acknowledgement state and the geometry of the new controls.
    out property <bool> request-detail-copied: request-details.copied;
    out property <length> request-detail-copy-x: request-details.copy-x;
    out property <length> request-detail-copy-y: request-details.copy-y;
    out property <length> request-detail-copy-width: request-details.copy-width;
    out property <length> request-detail-copy-height: request-details.copy-height;
    out property <bool> log-detail-copied: log-details.copied;
    out property <string> account-state-detail-text: root.account-state-detail();
    out property <bool> request-search-clear-visible: request-search.clear-visible;
    out property <length> request-search-clear-x: request-search.clear-x;
    out property <length> request-search-clear-y: request-search.clear-y;
    out property <length> request-search-clear-width: request-search.clear-width;
    out property <length> request-search-clear-height: request-search.clear-height;
    out property <bool> help-visible: help-scroll.visible;
    out property <bool> quit-confirm-visible: root.confirm-quit;
    out property <length> quit-button-x: quit-button.absolute-position.x;
    out property <length> quit-button-y: quit-button.absolute-position.y;
    out property <length> quit-button-width: quit-button.width;
    out property <length> quit-button-height: quit-button.height;
    out property <length> quit-confirm-x: quit-confirm-button.absolute-position.x;
    out property <length> quit-confirm-y: quit-confirm-button.absolute-position.y;
    out property <length> quit-confirm-width: quit-confirm-button.width;
    out property <length> quit-confirm-height: quit-confirm-button.height;

    callback navigate(int);
    callback configure-account();
    callback skip-login();
    callback open-account-form();
    callback close-account-form();
    callback save-credentials(string, string);
    callback clear-credentials();
    callback continue-login();
    callback toggle-password-visible();
    callback save-port(string);
    callback refresh-overview();
    callback refresh-requests();
    callback refresh-settings();
    callback refresh-page();
    callback refresh-logs();
    callback apply-log-filter(int, string);
    callback log-history(int, int);
    callback query-requests(int);
    callback open-request(string);
    callback usage-range-changed(int);
    callback theme-mode-changed(int);
    callback theme-dark-changed(bool);
    callback quit-requested();

    changed account-form-visible => {
        if (root.account-form-visible) {
            root.confirm-clear = false;
            if (root.credential-account-input.is-empty) { account-input.take-focus(); }
            else { password-input.take-focus(); }
        } else if (root.page == 2) {
            edit-account.take-focus();
        }
    }
    changed log-version => {
        if (root.log-period == 0 && root.log-follow && root.logs.length > 0) {
            log-list.ensure-row-visible(root.logs.length - 1, ScrollBehavior.instant);
        }
    }
    changed page => {
        root.confirm-clear = false;
        root.confirm-quit = false;
        if (root.page == 3 && root.log-period == 0 && root.log-follow && root.logs.length > 0) {
            log-list.ensure-row-visible(root.logs.length - 1, ScrollBehavior.instant);
        }
        if (root.page == 2 && root.account-form-visible) {
            if (root.credential-account-input.is-empty) { account-input.take-focus(); }
            else { password-input.take-focus(); }
        }
    }
    // The chart owns a second palette, and the native title bar needs the same
    // dark/light step; both follow the one derived value.
    changed theme-dark => {
        root.apply-chart-theme();
        root.theme-dark-changed(root.theme-dark);
    }
    public function navigate-to(page: int) {
        if (root.page == page) { return; }
        if (!root.allow-motion) { root.navigate(page); return; }
        root.pending-page = page;
        // Fade to 35% instead of zero: the timer that swaps the page starts
        // on the next event-loop pass, so a full fade would leave one blank
        // frame between the old page disappearing and the new one appearing.
        root.page-opacity = 0.35;
        page-out-timer.start();
    }
    // Fade the old page down, swap while it is dimmed, then fade the new page
    // back in. The title and the page host share page-opacity, so they move
    // together and the swap never shows a hard cut.
    page-out-timer := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            root.navigate(root.pending-page);
            root.page-opacity = 1;
        }
    }
    // One root timer drives the shared breathing phase, so the dots keep pulsing
    // even when a nested component is not active.
    pulse-timer := Timer {
        interval: Theme.pulse;
        running: root.allow-motion;
        triggered => { Theme.pulse-on = !Theme.pulse-on; }
    }
    // The inline clear confirmation returns to the normal row after three
    // seconds without a second click.
    clear-confirm-timer := Timer {
        interval: 3s;
        running: false;
        triggered => { root.confirm-clear = false; }
    }
    public pure function auto-refresh-index-for(seconds: int) -> int {
        return seconds == 15 ? 1 : seconds == 30 ? 2 : seconds == 60 ? 3 : seconds == 0 ? 4 : 0;
    }
    public pure function auto-refresh-seconds(index: int) -> int {
        return index == 1 ? 15 : index == 2 ? 30 : index == 3 ? 60 : index == 4 ? 0 : 5;
    }
    // A manual refresh acknowledges itself for 600 ms: four 90-degree steps,
    // then the icon returns to its normal affordance.
    public function begin-manual-refresh() {
        // Reset while the icon is still static, so a completed 360-degree turn
        // never animates backwards.
        root.refresh-rotation = 0deg;
        root.refreshing = true;
    }
    public function refresh-page-data() {
        if (root.page == 0) { root.refresh-overview(); }
        else if (root.page == 1) { root.refresh-requests(); }
        else if (root.page == 2) { root.refresh-settings(); }
        else if (root.page == 3) {
            if (root.log-period == 0) { root.refresh-logs(); }
            else { root.log-history(root.log-period, 0); }
        }
    }
    public function refresh-current-page() {
        root.begin-manual-refresh();
        root.refresh-page-data();
    }
    changed auto-refresh => {
        root.auto-refresh-index = root.auto-refresh-index-for(root.auto-refresh);
        if (root.auto-refresh > 0 && !root.refresh-paused && !root.refreshing) {
            auto-refresh-timer.restart();
        }
    }
    changed auto-refresh-index => {
        root.auto-refresh = root.auto-refresh-seconds(root.auto-refresh-index);
    }
    changed refreshing => {
        if (root.refreshing) {
            root.refresh-rotation = 0deg;
            refresh-timer.restart();
        } else {
            refresh-timer.stop();
            root.refresh-rotation = 0deg;
        }
    }
    changed refresh-paused => {
        if (!root.refresh-paused) {
            // Returning from minimize/tray must not wait for the next interval.
            root.refresh-page-data();
            if (root.auto-refresh > 0) { auto-refresh-timer.restart(); }
        }
    }
    auto-refresh-timer := Timer {
        // A stopped timer must not get a zero interval; 1s is only a
        // placeholder while auto refresh is off.
        interval: root.auto-refresh > 0 ? root.auto-refresh * 1s : 1s;
        running: root.auto-refresh > 0 && !root.refresh-paused && !root.refreshing;
        triggered => {
            // A tick already queued when auto refresh was switched off or the
            // window was hidden must not refresh anything.
            if (root.auto-refresh > 0 && !root.refresh-paused && !root.refreshing) {
                root.refresh-overview();
            }
        }
    }
    refresh-timer := Timer {
        interval: 150ms;
        running: root.refreshing;
        triggered => {
            root.refresh-rotation += 90deg;
            if (root.refresh-rotation >= 360deg) {
                root.refreshing = false;
            }
        }
    }
    // The refresh acknowledgement stays visible for 1.2 s, then the button
    // returns to its normal refresh affordance.
    log-refreshed-timer := Timer {
        interval: 1.2s;
        running: false;
        triggered => { root.log-refreshed = false; }
    }
    changed log-refreshed => { if (root.log-refreshed) { log-refreshed-timer.start(); } }
    // The tray-less exit confirmation expires after three seconds, like the
    // inline credential clear.
    quit-confirm-timer := Timer {
        interval: 3s;
        running: false;
        triggered => { root.confirm-quit = false; }
    }
    changed tray-available => { if (root.tray-available) { root.confirm-quit = false; } }

    root-focus := FocusScope {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                // Escape closes only the detail that belongs to the current page;
                // a hidden detail on another page must survive a page switch.
                if (root.page == 2 && root.account-form-visible) { root.close-account-form(); return accept; }
                if (root.page == 1 && !root.selected-request.is-empty) { root.selected-request = ""; return accept; }
                if (root.page == 3 && !root.open-log-id.is-empty) { root.open-log-id = ""; return accept; }
                return reject;
            }
            if (event.modifiers.control) {
                if (event.text == "1") { root.navigate-to(0); return accept; }
                if (event.text == "2") { root.navigate-to(1); return accept; }
                if (event.text == "3") { root.navigate-to(3); return accept; }
                if (event.text == "4") { root.navigate-to(2); return accept; }
                if (event.text == "r" || event.text == "R") { root.refresh-page(); return accept; }
                // Ctrl+F focuses the search field of the current page; inside a
                // text field the platform keeps its own find behavior.
                if ((event.text == "f" || event.text == "F")
                    && !request-search.has-focus && !log-search.has-focus
                    && !account-input.has-focus && !password-input.has-focus
                    && !port-input.has-focus) {
                    if (root.page == 1) { request-search.take-focus(); return accept; }
                    if (root.page == 3) { log-search.take-focus(); return accept; }
                }
            }
            return reject;
        }

    HorizontalLayout {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        Rectangle {
            width: root.compact ? 84px : 196px;
            animate width { duration: Theme.motion ? 150ms : 0ms; easing: ease-in-out; }
            background: Theme.rail;
            VerticalLayout {
                padding-left: root.compact ? 6px : 14px;
                padding-right: root.compact ? 6px : 14px;
                padding-top: root.compact ? 6px : 14px;
                padding-bottom: root.compact ? 6px : 14px;
                animate padding-left, padding-right, padding-top, padding-bottom {
                    duration: Theme.motion ? 150ms : 0ms;
                    easing: ease-in-out;
                }
                spacing: 4px;
                // The compact and full titles cross-fade with the rail width so
                // the text never swaps in one frame.
                Rectangle {
                    height: 44px;
                    Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: "本机控制台";
                        color: Theme.rail-ink;
                        font-family: Theme.font-display;
                        font-size: 17px;
                        font-weight: 650;
                        vertical-alignment: center;
                        opacity: root.compact ? 0 : 1;
                        animate opacity { duration: Theme.motion ? 150ms : 0ms; easing: ease-in-out; }
                    }
                    Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: "控制台";
                        color: Theme.rail-ink;
                        font-family: Theme.font-display;
                        font-size: 13px;
                        font-weight: 650;
                        vertical-alignment: center;
                        opacity: root.compact ? 1 : 0;
                        animate opacity { duration: Theme.motion ? 150ms : 0ms; easing: ease-in-out; }
                    }
                }
                for entry in root.nav-entries : NavItem {
                    label: entry.label;
                    selected: root.page == entry.page;
                    activate => { root.navigate-to(entry.page); }
                }
                Rectangle { vertical-stretch: 1; }
                Hint { text: root.compact ? "托盘运行" : "关窗后继续运行"; color: Theme.rail-muted; visible: root.tray-available; }
                // Without a tray there is no background home, so leaving the
                // window stops the gateway. Confirm that destructive step inline.
                VerticalLayout {
                    visible: !root.tray-available;
                    height: root.tray-available ? 0px : self.preferred-height;
                    spacing: 4px;
                    quit-button := FocusAction {
                        visible: !root.confirm-quit;
                        label: root.compact ? "退出" : "退出并停止网关";
                        icon: "power";
                        quiet: true;
                        danger: true;
                        clicked => {
                            root.confirm-quit = true;
                            quit-confirm-timer.start();
                        }
                    }
                    VerticalLayout {
                        visible: root.confirm-quit;
                        height: root.confirm-quit ? self.preferred-height : 0px;
                        spacing: 4px;
                        Hint { text: "退出？将停止本实例网关"; color: Theme.bad-text; }
                        HorizontalLayout {
                            spacing: 6px;
                            quit-confirm-button := ActionButton {
                                label: "确认退出";
                                icon: "check";
                                danger: true;
                                clicked => {
                                    root.confirm-quit = false;
                                    root.quit-requested();
                                }
                            }
                            ActionButton {
                                label: "取消";
                                quiet: true;
                                clicked => { root.confirm-quit = false; }
                            }
                        }
                    }
                }
            }
            // Hairline between the second neutral layer and the page.
            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: 1px;
                height: parent.height;
                background: Theme.rail-edge;
            }
        }

        VerticalLayout {
            alignment: stretch;
            padding: root.compact ? 12px : 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                page-title := Heading {
                    text: root.page-titles[root.page];
                    font-size: 22px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    opacity: root.page-opacity;
                    animate opacity { duration: Theme.glide; easing: ease-out; }
                }
                Tag {
                    label: root.active-address;
                    tone: 3;
                    visible: !root.active-address.is-empty;
                    cross-axis-self-alignment: center;
                    opacity: root.page-opacity;
                    animate opacity { duration: Theme.glide; easing: ease-out; }
                }
            }

            page-host := Rectangle {
                vertical-stretch: 1;
                clip: true;
                // The software renderer does not implement transform-scale, so
                // the page transition is opacity-only; a scale here is a no-op.
                opacity: root.page-opacity;
                animate opacity { duration: Theme.glide; easing: ease-out; }
            overview-scroll := ScrollView {
                visible: root.page == 0;
                vertical-stretch: 1;
                content-width: self.visible-width;
                overview-content := VerticalLayout {
                    // Stretch the chart into the viewport when the cards leave
                    // room, but never shrink the page below its preferred
                    // height; the ScrollView takes over when content overflows.
                    alignment: stretch;
                    min-height: max(self.preferred-height, overview-scroll.visible-height);
                    spacing: 12px;
                    // Leave a gutter on the right so the scrollbar thumb lands on
                    // the page, never inside a card.
                    padding-right: 8px;
                    state-card := Card {
                        if root.compact : VerticalLayout {
                            spacing: 12px;
                            StateCell {
                                horizontal-stretch: 1; label: "网关"; value: root.gateway-value;
                                detail: root.gateway-detail; tone: root.gateway-tone;
                                pulse: root.gateway-pulse;
                            }
                            StateCell {
                                horizontal-stretch: 1; label: "UM 登录"; value: root.account-label;
                                detail: root.account-state-detail(); tone: root.account-tone;
                                pulse: root.account-pulse;
                            }
                            StateCell {
                                horizontal-stretch: 1; label: "上游"; value: root.upstream-value;
                                detail: root.upstream-detail; tone: root.upstream-tone;
                                pulse: root.upstream-pulse;
                            }
                        }
                        if !root.compact : HorizontalLayout {
                            spacing: 14px;
                            // The card content is the window minus the rail, the page
                            // padding and the card inset; three equal cells leave the
                            // same gutter on every width.
                            StateCell {
                                width: (root.width - 304px) / 3;
                                label: "网关"; value: root.gateway-value;
                                detail: root.gateway-detail; tone: root.gateway-tone;
                                pulse: root.gateway-pulse;
                            }
                            StateCell {
                                width: (root.width - 304px) / 3;
                                label: "UM 登录"; value: root.account-label;
                                detail: root.account-state-detail(); tone: root.account-tone;
                                pulse: root.account-pulse;
                            }
                            StateCell {
                                width: (root.width - 304px) / 3;
                                label: "上游"; value: root.upstream-value;
                                detail: root.upstream-detail; tone: root.upstream-tone;
                                pulse: root.upstream-pulse;
                            }
                        }
                    }
                    login-card := Card {
                        gap: 10px;
                        visible: root.login-visible;
                        height: root.login-visible ? login-card.content-height : 0px;
                        VerticalLayout {
                            alignment: start;
                            spacing: 10px;
                            SectionLabel { text: "账号登录"; }
                            if root.account-label != "已登录" : Hint {
                                text: "登录 UM 后可以调用模型。也可以先查看网关和日志。";
                            }
                            if !root.login-status.is-empty : Hint { text: root.login-status; color: Theme.status_ink(root.login-tone); }
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                configure-account-button := ActionButton {
                                    visible: root.account-label != "已登录" || root.account-can-continue;
                                    label: root.account-can-continue ? "继续登录" : "配置账号";
                                    icon: "edit";
                                    enabled: !root.account-busy;
                                    primary: true;
                                    clicked => {
                                        if (root.account-can-continue) { root.continue-login(); }
                                        else { root.configure-account(); }
                                    }
                                }
                                skip-login-button := ActionButton {
                                    visible: root.show-intro && root.account-label != "已登录"; label: "稍后登录";
                                    clicked => { root.skip-login(); }
                                }
                            }
                        }
                    }
                    usage-chart := UsageChart {
                        // The overview is a fixed set of cards; the chart takes
                        // the leftover height instead of leaving a blank band
                        // above the status row.
                        vertical-stretch: 1;
                        period <=> root.usage-period;
                        points: root.usage-points;
                        labels: root.usage-labels;
                        token-counts: root.usage-token-counts;
                        request-counts: root.usage-request-counts;
                        token-total: root.token-total;
                        request-total: root.request-total;
                        loading: root.usage-loading;
                        status-text: root.usage-status;
                        status-tone: Theme.status_ink(root.usage-tone);
                        allow-motion: root.allow-motion;
                        show-line <=> root.usage-show-line;
                        show-requests <=> root.usage-show-requests;
                        auto-refresh <=> root.auto-refresh;
                        refreshing: root.refreshing;
                        refresh-rotation: root.refresh-rotation;
                        updated-at: root.overview-updated-at;
                        refresh => { root.refresh-current-page(); }
                        period-changed(index) => { root.usage-range-changed(index); }
                    }
                }
            }

            HorizontalLayout {
                visible: root.page == 1;
                vertical-stretch: 1;
                spacing: 12px;
                request-list-pane := VerticalLayout {
                    horizontal-stretch: 1;
                    visible: !root.compact || root.selected-request.is-empty;
                    spacing: 8px;
                    FlexboxLayout {
                        flex-wrap: wrap;
                        spacing: 8px;
                        request-period-control := Segmented {
                            width: 280px;
                            options: [{ text: "今天" }, { text: "24 小时" }, { text: "7 天" }, { text: "30 天" }, { text: "全部" }];
                            current-index <=> root.request-period;
                            label: "请求日期范围";
                            selected(_) => { root.query-requests(0); }
                        }
                        Segmented {
                            width: 268px;
                            options: [{ text: "全部结果" }, { text: "成功" }, { text: "失败" }];
                            current-index <=> root.request-result;
                            label: "请求结果";
                            selected(_) => { root.query-requests(0); }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                request-search := MaterialField {
                                    horizontal-stretch: 1;
                                    icon: "search";
                                    placeholder: "模型或请求 ID";
                                    clearable: true;
                                    text <=> root.request-keyword;
                                    accepted => { root.query-requests(0); }
                                    cleared => { root.query-requests(0); }
                                }
                                ActionButton { width: Theme.icon-button; height: Theme.icon-button; label: "查询"; icon: "arrow-right"; icon-only: true; primary: true; tooltip: "查询请求"; clicked => { root.query-requests(0); } }
                                request-refresh := ActionButton {
                                    width: Theme.icon-button;
                                    height: Theme.icon-button;
                                    label: "刷新请求";
                                    icon: "refresh";
                                    icon-rotation: root.refresh-rotation;
                                    icon-only: true;
                                    quiet: true;
                                    tooltip: "刷新请求";
                                    enabled: !root.refreshing;
                                    clicked => { root.refresh-current-page(); }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Hint { text: root.request-status; color: Theme.status_ink(root.request-tone); horizontal-stretch: 1; vertical-alignment: center; overflow: elide; wrap: no-wrap; }
                        DataText { text: root.request-updated-at-label; vertical-alignment: center; }
                    }
                    request-list-panel := Panel {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-left: 6px;
                            padding-right: 14px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            if root.requests.length == 0 : VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 4px;
                                Hint { text: "暂无请求记录"; color: Theme.ink; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
                                Hint { text: "本实例收到请求后会列在这里"; horizontal-alignment: center; }
                            }
                            ListView {
                                visible: root.requests.length > 0;
                                vertical-stretch: 1;
                                content-y <=> root.request-scroll-y;
                                for item in root.requests : Selectable {
                                    label: item.at + " " + item.model + " " + item.outcome;
                                    height: 46px;
                                    selected: root.selected-request == item.id;
                                    activate => { root.open-request(item.id); }
                                    VerticalLayout {
                                        padding-left: 10px; padding-right: 10px; padding-top: 5px; padding-bottom: 5px;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: item.model; color: Theme.ink; horizontal-stretch: 1; overflow: elide; font-weight: 600; }
                                            Tag { label: item.outcome; tone: item.tone; }
                                        }
                                        Hint { text: item.at + "  " + item.summary; overflow: elide; wrap: no-wrap; }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: end;
                        ActionButton { label: "较新"; icon: "chevron-left"; icon-only: true; quiet: true; width: Theme.icon-button; height: Theme.icon-button; enabled: root.newer-requests; tooltip: "较新的请求"; clicked => { root.query-requests(-1); } }
                        ActionButton { label: "较早"; icon: "chevron-right"; icon-only: true; quiet: true; width: Theme.icon-button; height: Theme.icon-button; enabled: root.older-requests; tooltip: "较早的请求"; clicked => { root.query-requests(1); } }
                    }
                }
                request-details := TextDetails {
                    visible: !root.selected-request.is-empty || self.width > 1px;
                    width: root.selected-request.is-empty ? 0px : root.compact ? max(300px, root.width - 134px) : min(400px, (root.width - 212px) * 0.48);
                    clip: true;
                    animate width { duration: Theme.settle; easing: ease-out; }
                    title: root.request-detail-title;
                    body: root.request-detail;
                    closed => { root.selected-request = ""; }
                }
            }

            VerticalLayout {
                visible: root.page == 3; vertical-stretch: 1; spacing: 6px;
                FlexboxLayout {
                    flex-wrap: wrap;
                    spacing: 8px;
                    Segmented {
                        width: root.compact ? 190px : 240px;
                        options: [{ text: "实时" }, { text: "今天" }, { text: "7 天" }, { text: "30 天" }];
                        current-index <=> root.log-period;
                        label: "日志日期范围";
                        selected(_) => { root.log-history(root.log-period, 0); }
                    }
                    // One 5-item segmented control at every width, so the level
                    // filter keeps the console's field/edge/radius language.
                    log-level-control := Segmented {
                        width: root.compact ? 170px : 260px;
                        options: [{ text: "全部" }, { text: "信息" }, { text: "警告" }, { text: "错误" }, { text: "原始" }];
                        current-index <=> root.log-filter-level;
                        label: "日志级别";
                        selected(_) => { root.apply-log-filter(root.log-filter-level, root.log-filter-keyword); }
                    }
                    // Refresh sits next to the level row so it never wraps alone;
                    // the keyword field follows and may take the next row.
                    log-refresh := ActionButton {
                        width: root.log-refreshed ? 74px : Theme.icon-button;
                        height: Theme.icon-button;
                        label: root.log-refreshed ? "已刷新" : "刷新";
                        icon: root.log-refreshed ? "check" : "refresh";
                        icon-rotation: root.refresh-rotation;
                        icon-only: !root.log-refreshed;
                        quiet: true;
                        tooltip: root.log-refreshed ? "已刷新" : "刷新日志";
                        enabled: !root.refreshing;
                        clicked => { root.refresh-current-page(); }
                    }
                    log-search := MaterialField {
                        width: root.compact ? 140px : 180px;
                        icon: "search";
                        placeholder: "关键词";
                        clearable: true;
                        text <=> root.log-filter-keyword;
                        edited(_) => { root.apply-log-filter(root.log-filter-level, root.log-filter-keyword); }
                        cleared => { root.apply-log-filter(root.log-filter-level, root.log-filter-keyword); }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: start;
                    Hint { text: root.log-status; color: Theme.status_ink(root.log-tone); vertical-alignment: center; overflow: elide; wrap: no-wrap; horizontal-stretch: 1; }
                    DataText { text: root.log-updated-at-label; vertical-alignment: center; }
                    ActionButton {
                        visible: root.log-period == 0;
                        width: Theme.icon-button;
                        height: Theme.icon-button;
                        quiet: true;
                        label: root.log-follow ? "暂停跟随" : "恢复跟随";
                        icon: root.log-follow ? "pause" : "play";
                        icon-only: true;
                        tooltip: root.log-follow ? "暂停跟随" : "恢复跟随";
                        badge: root.new-log-count > 0 && !root.log-follow ? root.new-log-count : "";
                        clicked => {
                            root.log-follow = !root.log-follow;
                            if (root.log-follow) {
                                root.new-log-count = 0;
                                if (root.logs.length > 0) { log-list.ensure-row-visible(root.logs.length - 1, ScrollBehavior.instant); }
                            }
                        }
                    }
                    ActionButton { visible: root.log-period != 0; width: Theme.icon-button; height: Theme.icon-button; quiet: true; enabled: root.newer-logs; label: "较新"; icon: "chevron-left"; icon-only: true; tooltip: "较新的日志"; clicked => { root.log-history(root.log-period, -1); } }
                    ActionButton { visible: root.log-period != 0; width: Theme.icon-button; height: Theme.icon-button; quiet: true; enabled: root.older-logs; label: "较早"; icon: "chevron-right"; icon-only: true; tooltip: "较早的日志"; clicked => { root.log-history(root.log-period, 1); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-left: 6px;
                        padding-right: 14px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        if root.logs.length == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            Hint { text: "暂无日志"; color: Theme.ink; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
                            Hint { text: "网关输出会实时显示在这里"; horizontal-alignment: center; }
                        }
                        log-list := ListView {
                            visible: root.logs.length > 0;
                            vertical-stretch: 1;
                            content-y <=> root.log-scroll-y;
                            scrolled => {
                                if (root.log-period == 0 && (-self.content-y + self.visible-height) < self.content-height - 8px) {
                                    root.log-follow = false;
                                }
                            }
                            for row in root.logs : Selectable {
                                label: row.at + " " + row.level + " " + row.text;
                                height: 36px;
                                selected: row.id == root.open-log-id;
                                activate => {
                                    root.open-log-id = row.id;
                                    root.open-log-title = row.at + "  " + row.level;
                                    root.open-log-body = row.detail;
                                }
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    DataText { text: row.at; width: root.compact ? 92px : 96px; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                    Tag {
                                        label: row.level;
                                        tone: row.level == "错误" ? 2 : row.level == "警告" ? 1 : 3;
                                    }
                                    Text { text: row.text; horizontal-stretch: 1; color: Theme.ink; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }
                    }
                }
                log-details := TextDetails {
                    visible: !root.open-log-id.is-empty || self.height > 0px;
                    height: root.open-log-id.is-empty ? 0px : root.compact ? 130px : 170px;
                    clip: true;
                    animate height { duration: Theme.settle; easing: ease-out; }
                    title: root.open-log-title;
                    body: root.open-log-body;
                    closed => { root.open-log-id = ""; }
                }
            }

            settings-scroll := ScrollView {
                visible: root.page == 2;
                vertical-stretch: 1;
                content-width: self.visible-width;
                settings-content := VerticalLayout {
                    alignment: start;
                    min-height: self.preferred-height;
                    spacing: 12px;
                    padding-right: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        settings-refresh := ActionButton {
                            width: Theme.icon-button;
                            height: Theme.icon-button;
                            label: "刷新";
                            icon: "refresh";
                            icon-rotation: root.refresh-rotation;
                            icon-only: true;
                            quiet: true;
                            tooltip: "重新检查网关与账号状态";
                            enabled: !root.refreshing;
                            clicked => { root.refresh-current-page(); }
                        }
                        Hint { text: root.settings-updated-at-label; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "外观"; }
                            Hint { text: "跟随系统时会随 Windows 应用主题切换，手动选择会覆盖系统设置。"; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "主题";
                                    height: Theme.control-height;
                                    vertical-alignment: center;
                                    color: Theme.ink;
                                    font-size: 12px;
                                }
                                theme-mode-control := Segmented {
                                    width: 300px;
                                    label: "主题";
                                    options: [
                                        { text: "跟随系统" },
                                        { text: "浅色" },
                                        { text: "深色" },
                                    ];
                                    current-index <=> root.theme-mode;
                                    selected(index) => { root.theme-mode-changed(index); }
                                }
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "UM 账号"; }
                            Hint { text: root.account-saved; }
                            account-saved-detail := Hint {
                                visible: !root.account-saved-detail.is-empty;
                                height: self.visible ? self.preferred-height : 0px;
                                text: root.account-saved-detail;
                            }
                            Text { text: root.account-label; color: Theme.status_ink(root.account-tone); font-size: 15px; font-weight: 650; wrap: word-wrap; }
                            if !root.account-detail.is-empty : Hint { text: root.account-detail; }
                            HorizontalLayout {
                                height: root.account-form-visible ? 0px : self.preferred-height;
                                spacing: 8px; alignment: start;
                                edit-account := FocusAction {
                                    visible: !root.account-form-visible; enabled: !root.account-busy;
                                    label: root.account-can-clear ? "更新账号密码" : "配置账号";
                                    icon: "edit";
                                    clicked => { root.open-account-form(); }
                                }
                                ActionButton {
                                    visible: root.account-can-continue && !root.account-form-visible;
                                    enabled: !root.account-busy; primary: true; label: "继续登录";
                                    clicked => { root.continue-login(); }
                                }
                            }
                            HorizontalLayout {
                                height: root.account-can-clear && !root.account-form-visible ? self.preferred-height : 0px;
                                alignment: start;
                                spacing: 8px;
                                clear-account := FocusAction {
                                    visible: root.account-can-clear && !root.account-form-visible && !root.confirm-clear;
                                    enabled: !root.account-busy;
                                    quiet: true;
                                    danger: true;
                                    label: "清除已保存的账号密码";
                                    icon: "trash";
                                    clicked => {
                                        root.confirm-clear = true;
                                        clear-confirm-timer.start();
                                    }
                                }
                                if root.confirm-clear : Hint {
                                    visible: root.confirm-clear;
                                    text: "确认清除？";
                                    color: Theme.bad-text;
                                    vertical-alignment: center;
                                }
                                clear-confirm := FocusAction {
                                    visible: root.confirm-clear;
                                    label: "确认";
                                    danger: true;
                                    enabled: !root.account-busy;
                                    clicked => {
                                        root.confirm-clear = false;
                                        root.clear-credentials();
                                    }
                                }
                                if root.confirm-clear : FocusAction {
                                    label: "取消";
                                    quiet: true;
                                    clicked => { root.confirm-clear = false; }
                                }
                            }
                            if !root.credential-status.is-empty : Hint { text: root.credential-status; color: Theme.status_ink(root.credential-tone); }
                            if !root.login-status.is-empty : Hint { text: root.login-status; color: Theme.status_ink(root.login-tone); }
                            VerticalLayout {
                                visible: root.account-form-visible;
                                height: self.visible ? self.preferred-height : 0px;
                                spacing: 8px;
                                Divider { }
                                SectionLabel { text: "录入账号密码"; }
                                Hint { text: "账号密码保存在本机，供此网关重新登录。"; }
                                account-input := Field {
                                    placeholder: "UMPASS 账号";
                                    text <=> root.credential-account-input;
                                    invalid: root.account-input-invalid;
                                    edited(_) => {
                                        root.account-input-invalid = false;
                                        root.account-input-error = "";
                                    }
                                    accepted => { password-input.take-focus(); }
                                }
                                if !root.account-input-error.is-empty : Hint {
                                    text: root.account-input-error;
                                    color: Theme.bad-text;
                                }
                                password-input := Field {
                                    placeholder: "UMPASS 密码";
                                    password: true;
                                    text <=> root.credential-password-input;
                                    invalid: root.password-input-invalid;
                                    edited(_) => {
                                        root.password-input-invalid = false;
                                        root.password-input-error = "";
                                    }
                                    accepted => {
                                        if (!root.account-busy) { root.save-credentials(root.credential-account-input, root.credential-password-input); }
                                    }
                                }
                                if !root.password-input-error.is-empty : Hint {
                                    text: root.password-input-error;
                                    color: Theme.bad-text;
                                }
                                password-toggle := Toggle {
                                    label: "显示密码";
                                    checked: root.password-visible;
                                    toggled => { root.toggle-password-visible(); }
                                }
                                HorizontalLayout {
                                    alignment: end; spacing: 8px;
                                    cancel-account := FocusAction { label: "取消"; icon: "close"; quiet: true; clicked => { root.close-account-form(); } }
                                    save-account := FocusAction {
                                        label: "保存账号"; icon: "check"; primary: true; enabled: !root.account-busy;
                                        clicked => { root.save-credentials(root.credential-account-input, root.credential-password-input); }
                                    }
                                }
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            spacing: 9px;
                            SectionLabel { text: "模型 API 地址"; }
                            Hint { text: "仅在本机可用。更改端口会先检查新端口，再等待当前请求完成。"; }
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                Hint { text: "127.0.0.1:"; height: Theme.control-height; vertical-alignment: center; }
                                port-input := MaterialField {
                                    width: 148px;
                                    placeholder: "端口";
                                    numeric: true;
                                    text <=> root.port-input;
                                    enabled: !root.port-busy;
                                    invalid: root.port-input-invalid;
                                    edited(_) => { root.port-input-invalid = false; root.port-input-error = ""; }
                                    accepted => { if (!root.port-busy) { root.save-port(root.port-input); } }
                                }
                                ActionButton { label: "切换端口"; icon: "swap"; primary: true; enabled: !root.port-busy; clicked => { root.save-port(root.port-input); } }
                            }
                            if !root.port-input-error.is-empty : Hint { text: root.port-input-error; color: Theme.bad-text; }
                            if !root.settings-status.is-empty : Hint { text: root.settings-status; color: Theme.status_ink(root.settings-tone); }
                        }
                    }
                    technical-card := ClickableCard {
                        card-label: "实例管理";
                        checked: root.show-technical;
                        activated => { root.show-technical = !root.show-technical; }
                        VerticalLayout {
                            spacing: 9px;
                            HorizontalLayout {
                                spacing: 8px;
                                SectionLabel { text: "实例管理"; horizontal-stretch: 1; vertical-alignment: center; }
                                // The desktop renderer supports 2D transforms, so the
                                // disclosure chevron rotates literally instead of
                                // cross-fading two glyphs.
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    cross-axis-self-alignment: center;
                                    AppIcon {
                                        x: 0px;
                                        y: 0px;
                                        size: 16px;
                                        kind: "chevron-right";
                                        tint: technical-card.hovered || technical-card.focused || root.show-technical ? Theme.accent : Theme.muted;
                                        transform-rotation: root.show-technical ? 90deg : 0deg;
                                        animate transform-rotation { duration: 160ms; easing: ease-out; }
                                        animate tint { duration: Theme.quick; easing: ease-in-out; }
                                    }
                                }
                            }
                            details := Rectangle {
                                visible: root.show-technical || self.height > 0px;
                                preferred-height: root.show-technical ? details-content.preferred-height : 0px;
                                height: self.preferred-height;
                                clip: true;
                                animate preferred-height { duration: Theme.settle; easing: ease-out; }
                                details-content := VerticalLayout {
                                    spacing: 8px;
                                    Hint { text: "网关监督  " + root.supervision-value + "  " + root.supervision-detail; color: Theme.status_ink(root.supervision-tone); }
                                    Hint { text: "配置文件  " + root.config-path; }
                                    Hint { text: "实例数据  " + root.instance-path; }
                                }
                            }
                        }
                    }
                }
            }

            // Help is a first-class page: shortcuts, the UM login flow and the
            // port switch each get their own card, plus the on-disk locations
            // that document the running instance.
            help-scroll := ScrollView {
                visible: root.page == 4;
                vertical-stretch: 1;
                content-width: self.visible-width;
                help-content := VerticalLayout {
                    alignment: start;
                    min-height: self.preferred-height;
                    spacing: 12px;
                    padding-right: 8px;
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "快捷键"; }
                            HorizontalLayout { spacing: 12px; DataText { text: "Ctrl+1…4"; width: 96px; } Hint { text: "切换总览、请求诊断、运行日志、设置"; horizontal-stretch: 1; } }
                            HorizontalLayout { spacing: 12px; DataText { text: "Ctrl+R"; width: 96px; } Hint { text: "刷新当前页数据"; horizontal-stretch: 1; } }
                            HorizontalLayout { spacing: 12px; DataText { text: "Ctrl+F"; width: 96px; } Hint { text: "聚焦请求或日志搜索框"; horizontal-stretch: 1; } }
                            HorizontalLayout { spacing: 12px; DataText { text: "Esc"; width: 96px; } Hint { text: "关闭当前页的详情或账号表单"; horizontal-stretch: 1; } }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "UM 登录"; }
                            Hint { text: "在「总览」或「设置」中录入 UMPASS 账号密码。账号密码只保存在本机，本实例网关会用它们自动重新登录。"; }
                            Hint { text: "需要人工完成 Duo 验证时，点「继续登录」会打开可见的 Edge 窗口；完成后回到控制台即可看到登录状态。"; }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "端口切换"; }
                            Hint { text: "在「设置 → 模型 API 地址」修改端口。切换前会检查新端口是否可用，并等待在途请求结束；失败时恢复原端口。"; }
                            Hint { text: "模型 API 只监听本机回环地址，分享链不会经过这个端口。"; }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            spacing: 9px;
                            SectionLabel { text: "本机数据"; }
                            Hint { text: "配置文件  " + root.config-path; }
                            Hint { text: "实例数据  " + root.instance-path; }
                        }
                    }
                }
            }
            }

            status-row := HorizontalLayout {
                spacing: 8px;
                status-dot := StatusDot { tone: root.status-tone; y: (parent.height - self.height) / 2; }
                Hint { text: root.status-line; horizontal-stretch: 1; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
                DataText { text: "更新于 " + root.last-update; vertical-alignment: center; }
            }
        }
    }
    }
}
