import { ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme, Panel, Heading, Hint, Selectable, ActionButton, FocusAction, NavItem, Field, MaterialField, Toggle, Segmented, Dropdown, Tag, StatusDot, DataText, SectionLabel } from "theme.slint";
import { ChartEngine, ChartDataset, ChartTheme } from "@slintplot";
import { AppIcon } from "icons.slint";
export { ChartEngine }
import { UsageChart, UsagePoint, RequestAnalytics, RequestMetric, ModelSpeedRow } from "usage-chart.slint";
export { UsagePoint }
export { RequestMetric }
export { ModelSpeedRow }

export struct LogRow {
    id: string,
    at: string,
    level: string,
    source: string,
    text: string,
    detail: string,
}

export struct RequestRow {
    id: string,
    at: string,
    model: string,
    outcome: string,
    tone: int,
    summary: string,
    first-token: string,
    detail: string,
}

// One row of the upstream fault history card. `evidence` stays empty for the
// active fault; a recovered row keeps the recovery source, status and detail.
export struct FaultRow {
    title: string,
    detail: string,
    evidence: string,
}

// One maintenance-menu row. `reason` stays empty while the action is enabled; a
// closed row keeps the concrete reason instead of disappearing. The confirm copy
// is the second step of the same action.
export struct MaintenanceRow {
    action: int,
    label: string,
    impact: string,
    enabled: bool,
    reason: string,
    confirm-title: string,
    confirm-body: string,
    confirm-label: string,
    danger: bool,
}

// One maintenance-record row. The app instance has no record source yet, so the
// array stays empty and the area says 不适用 instead of drawing a table.
export struct MaintenanceRecordRow {
    at: string,
    action: string,
    result: string,
}

// One row of the settings page's UM model catalog (#153). The name/ID column
// carries both, and `detail` is the full facts behind the row's 详情.
export struct ModelRow {
    id: string,
    name: string,
    context: string,
    efforts: string,
    last-test: string,
    detail: string,
}

// One row of the settings page's context-probe batch list (#154). `selected`
// mirrors the checkbox; `state` and `summary` are the visible test result.
export struct ProbeRow {
    model-id: string,
    name: string,
    state: string,
    summary: string,
    tone: int,
    selected: bool,
}

// One row of the collapsible probe history table.
export struct ProbeHistoryRow {
    time: string,
    model: string,
    result: string,
    summary: string,
    tone: int,
}

// One row of the settings page's UM login-round table (#159). The words are
// already mapped; an unknown closed-set value reads 未知 and keeps its raw value
// only in `detail`.
export struct LoginRoundRow {
    key: string,
    at: string,
    round: string,
    state: string,
    state-tone: int,
    mode: string,
    trigger: string,
    submit: string,
    outcome: string,
    reason: string,
    upstream: string,
    detail: string,
}

// One navigation entry. The page number lives next to its label so the rail and
// the page title can never drift apart again.
export struct NavEntry {
    label: string,
    page: int,
    icon: string,
    // Entries in the same group sit together; a group change gets a gap.
    group: int,
}

component StateCell inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <int> tone: 3;
    in property <bool> pulse: false;
    spacing: 2px;
    alignment: start;
    Text { text: root.label; color: Theme.muted; font-size: 11px; font-weight: 600; }
    HorizontalLayout {
        spacing: 7px;
        alignment: start;
        StatusDot {
            tone: root.tone;
            y: (parent.height - self.height) / 2;
            pulsing: root.pulse;
        }
        Text {
            text: root.value;
            color: Theme.ink;
            font-family: Theme.font-display;
            font-weight: 650;
            font-size: 15px;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    Hint { text: root.detail; visible: !root.detail.is-empty; }
    @children
}

component Divider inherits Rectangle { height: 1px; background: Theme.edge; }

// A compact checkbox for the context-probe list (#154). The whole 24 px box is
// the hit target and the accessible role is checkbox, matching the appearance
// Toggle while fitting the dense table row.
component ProbeCheck inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled();
    width: 24px;
    height: 24px;
    background: transparent;
    Rectangle {
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: root.checked ? Theme.accent : Theme.field;
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.edge;
    }
    AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 11px;
        kind: "check";
        tint: Theme.on-accent;
        visible: root.checked;
    }
    pointer := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }
}

component TextDetails inherits Panel {
    in property <string> title;
    in property <string> body;
    callback closed();
    // A copy is confirmed in place for 1.2 s so the action never looks like a
    // no-op; a new body clears the old acknowledgement immediately.
    in-out property <bool> copied: false;
    changed body => { root.copied = false; }
    // Test seam: the acknowledgement and the copy control geometry.
    out property <length> copy-x: copy-button.absolute-position.x;
    out property <length> copy-y: copy-button.absolute-position.y;
    out property <length> copy-width: copy-button.width;
    out property <length> copy-height: copy-button.height;
    // Test seam: the text the panel actually displays, not just its input.
    out property <string> shown-text: full-text.text;
    copy-timer := Timer {
        interval: 1.2s;
        running: false;
        triggered => { root.copied = false; copy-timer.running = false; }
    }
    clip: true;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Heading { text: root.title; horizontal-stretch: 1; vertical-alignment: center; }
            copy-button := ActionButton {
                width: root.copied ? 70px : Theme.icon-button;
                height: Theme.icon-button;
                label: root.copied ? "已复制" : "复制全文";
                icon: root.copied ? "check" : "copy";
                icon-only: !root.copied;
                quiet: true;
                tooltip: root.copied ? "已复制" : "复制全文";
                clicked => {
                    full-text.select-all();
                    full-text.copy();
                    root.copied = true;
                    copy-timer.start();
                }
            }
            ActionButton { width: Theme.icon-button; height: Theme.icon-button; label: "关闭"; icon: "close"; icon-only: true; quiet: true; tooltip: "关闭详情"; clicked => { root.closed(); } }
        }
        // The platform text editor draws an accent underline when focused; the
        // wrapper clips those last two pixels so the detail panel keeps the
        // neutral console surface while selection and copy still work.
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            full-text := TextEdit {
                width: parent.width;
                height: parent.height + 2px;
                text: root.body;
                read-only: true;
                wrap: word-wrap;
                font-family: Theme.font-data;
                font-size: 11px;
                accessible-label: root.title;
            }
        }
    }
}

// A card in a scrollable page. A plain Rectangle in a layout has a zero
// preferred height and stretch 1, so it would absorb the viewport height and
// leave no room for the following siblings. Size it from its content instead and
// opt out of the layout's extra space, so the page scrolls when content overflows.
//
// A clickable card is one target: the pointer and the keyboard activate the same
// callback, hover steps the neutral surface and edge, and focus uses the same
// neutral step instead of a blue outline.
component Card inherits Panel {
    in property <length> inset: 16px;
    // A shorter vertical inset keeps a card with extra settings rows compact
    // without changing the shared horizontal alignment.
    in property <length> inset-y: root.inset;
    in property <length> gap: 10px;
    in property <bool> clickable: false;
    callback activated();
    out property <bool> hovered: root.clickable && pointer.has-hover;
    out property <bool> focused: root.clickable && keyboard.has-focus;
    out property <length> content-height: content.preferred-height;
    out property <length> content-width: content.width;
    vertical-stretch: 0;
    preferred-height: content.preferred-height;
    background: root.hovered || root.focused ? Theme.surface-2 : Theme.surface;
    border-color: root.hovered || root.focused ? Theme.edge-strong : Theme.edge;
    animate background, border-color { duration: Theme.quick; easing: ease-in-out; }
    drop-shadow-offset-y: 1px;
    drop-shadow-blur: 3px;
    drop-shadow-color: Theme.card-shadow;
    content := VerticalLayout {
        padding-top: root.inset-y;
        padding-bottom: root.inset-y;
        padding-left: root.inset;
        padding-right: root.inset;
        spacing: root.gap;
        @children
    }
    keyboard := FocusScope {
        enabled: root.clickable;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    pointer := TouchArea {
        enabled: root.clickable;
        mouse-cursor: MouseCursor.pointer;
        clicked => { keyboard.focus(); root.activated(); }
    }
}

// One maintenance-menu row. The row shows the impact while enabled and the
// concrete reason while closed; the button only arms the shared confirmation, so
// no action runs on the first click. Geometry is exposed so the headless tests
// can drive the same click path the window uses.
component MaintenanceItem inherits VerticalLayout {
    in property <MaintenanceRow> item;
    in property <bool> confirming: false;
    in property <bool> busy: false;
    callback activate();
    callback confirmed();
    callback cancelled();
    out property <length> button-x: activate-button.absolute-position.x;
    out property <length> button-y: activate-button.absolute-position.y;
    out property <length> button-width: activate-button.width;
    out property <length> button-height: activate-button.height;
    out property <length> confirm-x: confirm-button.absolute-position.x;
    out property <length> confirm-y: confirm-button.absolute-position.y;
    out property <length> confirm-width: confirm-button.width;
    out property <length> confirm-height: confirm-button.height;
    out property <length> cancel-x: cancel-button.absolute-position.x;
    out property <length> cancel-y: cancel-button.absolute-position.y;
    out property <length> cancel-width: cancel-button.width;
    out property <length> cancel-height: cancel-button.height;
    spacing: 6px;
    HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: start;
            Text {
                text: root.item.label;
                color: Theme.ink;
                font-weight: 600;
                font-size: 13px;
            }
            Hint { text: root.item.impact; }
            if !root.item.enabled : Hint {
                text: root.item.reason;
                color: Theme.warn-text;
            }
        }
        activate-button := ActionButton {
            label: root.confirming ? "已选择" : "执行";
            icon: root.confirming ? "check" : "play";
            quiet: true;
            enabled: root.item.enabled && !root.busy;
            clicked => { root.activate(); }
        }
    }
    // Always instantiated so the confirmation keeps a testable geometry; it
    // only takes height while the row is armed.
    confirm-panel := Panel {
        visible: root.confirming;
        height: root.confirming ? self.preferred-height : 0px;
        preferred-height: confirm-content.preferred-height;
        confirm-content := VerticalLayout {
            padding: 10px;
            spacing: 6px;
            Text {
                text: root.item.confirm-title;
                color: Theme.ink;
                font-weight: 600;
                font-size: 13px;
            }
            Hint { text: root.item.confirm-body; }
            HorizontalLayout {
                spacing: 8px;
                confirm-button := ActionButton {
                    label: root.item.confirm-label;
                    danger: root.item.danger;
                    enabled: !root.busy;
                    clicked => { root.confirmed(); }
                }
                cancel-button := ActionButton {
                    label: "取消";
                    quiet: true;
                    clicked => { root.cancelled(); }
                }
            }
        }
    }
}

// The instance card is one target: the pointer and the keyboard both toggle the
// detail, and hover or focus steps the same neutral surface and edge.
component ClickableCard inherits Card {
    in property <string> card-label;
    // Disclosure state exposed to assistive technology as both the check state
    // and the expanded state, since the same card opens and closes details.
    in-out property <bool> checked: false;
    clickable: true;
    accessible-role: button;
    accessible-label: root.card-label;
    accessible-checked: root.checked;
    accessible-expanded: root.checked;
    accessible-action-default => { root.activated(); }
}

// One settings row: the label is the left column and the controls sit at the
// right edge of the card, so every settings card shares one row rhythm.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <length> label-column: 96px;
    out property <length> label-x: row-label.absolute-position.x;
    out property <length> label-px: row-label.width;
    height: 40px;
    width: 100%;
    background: transparent;
    row-content := HorizontalLayout {
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 12px;
        row-label := Text {
            width: root.label-column;
            text: root.label;
            color: Theme.ink;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        @children
    }
}

// A clickable address chip: the whole chip is one hit target, the pointer and the
// keyboard activate the same callback, and the trailing copy icon names the action.
component CopyChip inherits Rectangle {
    in property <string> label;
    in property <bool> copied: false;
    out property <string> icon: root.copied ? "check" : "copy";
    callback clicked();
    height: 24px;
    border-radius: 5px;
    background: pointer.has-hover || focus.has-focus ? Theme.surface-2 : Theme.soft(3);
    border-width: 1px;
    border-color: pointer.has-hover || focus.has-focus ? Theme.edge-strong : Theme.edge;
    animate background, border-color { duration: Theme.quick; easing: ease-in-out; }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.label;
            color: Theme.ink;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
        AppIcon {
            size: 13px;
            kind: root.icon;
            tint: root.copied ? Theme.good-text : Theme.muted;
            cross-axis-self-alignment: center;
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    pointer := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
    accessible-role: button;
    accessible-label: "复制 " + root.label;
    accessible-action-default => { root.clicked(); }
    if !root.label.is-empty : Tooltip { text: @markdown("复制 \{root.label}"); }
}

export component MainWindow inherits Window {
    title: "本机控制台";
    preferred-width: 1060px;
    preferred-height: 720px;
    min-width: 540px;
    min-height: 420px;
    background: Theme.background;
    default-font-family: "Segoe UI";
    default-font-size: 12px;
    // Keep the shortcut handler reachable when no control owns focus.
    forward-focus: root-focus;
    private property <bool> compact: root.sidebar-mode == 1 || root.width < 800px;
    // The appearance card switches to one column below the width where three
    // label + control rows still fit side by side.
    private property <bool> appearance-narrow: root.width < 985px;
    // The card stays after "稍后登录": skipping the first-run prompt must not
    // remove the explanation or the way back to the account form.
    private property <bool> login-visible: root.account-label != "已登录"
        || !root.login-status.is-empty || root.account-can-continue;
    // The rail and the page title read from the same table, so a page has one
    // name and one number everywhere.
    private property <[NavEntry]> nav-entries: [
        { label: "总览", page: 0, icon: "dashboard", group: 0 },
        { label: "请求诊断", page: 1, icon: "search", group: 0 },
        { label: "运行日志", page: 3, icon: "scroll-text", group: 0 },
        { label: "设置", page: 2, icon: "settings", group: 1 },
        { label: "帮助", page: 4, icon: "help", group: 1 },
    ];
    private property <[string]> page-titles: ["总览", "请求诊断", "设置", "运行日志", "帮助"];
    // The account cell always carries a detail line so the three state columns
    // keep the same rhythm, even when the gateway only reports "已登录".
    public pure function account-state-detail() -> string {
        if (!root.account-detail.is-empty) { return root.account-detail; }
        if (root.account-label == "已登录") { return "登录状态正常"; }
        if (root.account-saved == "未配置账号") { return "未配置账号"; }
        return "登录后可用";
    }
    // The page content width inside the rail and the page padding; the request
    // list and detail split it without touching the other pages.
    public pure function request-content-width() -> length {
        return root.width - (root.compact ? 84px : 196px) - (root.compact ? 24px : 40px);
    }

    in-out property <int> page: 0;
    private property <float> page-opacity: 1;
    private property <int> pending-page: 0;
    init => { Theme.motion = root.allow-motion; root.apply-chart-theme(); }
    changed allow-motion => {
        Theme.motion = root.allow-motion;
        if (!root.allow-motion) { Theme.pulse-on = false; }
        root.apply-chart-theme();
    }
    // The chart library keeps its own palette; follow the system theme when it
    // changes at runtime instead of only reading it once at startup. The local
    // mirror gives `changed` a property name it can observe.
    private property <bool> chart-dark: Theme.dark;
    changed chart-dark => { root.apply-chart-theme(); }
    changed visible => { if (root.visible && root.allow-motion) { pulse-timer.start(); } }
    // The chart library owns a second theme; align its axes and motion with the
    // console so the plot does not read as a second design system.
    function apply-chart-theme() {
        ChartTheme.dark = Theme.dark;
        ChartTheme.text-color = Theme.muted;
        ChartTheme.grid-color = Theme.grid;
        ChartTheme.axis-color = Theme.edge;
        ChartTheme.font-size = 11px;
        // The request page is an analytics surface rather than the overview, so
        // its bars settle at the 160 ms desktop step instead of the chart
        // library's 420 ms default. The overview keeps 420 ms.
        ChartTheme.animation-duration = root.allow-motion
            ? (root.page == 1 ? 160ms : 420ms)
            : 0ms;
    }
    in property <string> gateway-value: "检测中";
    in property <string> gateway-detail;
    in property <int> gateway-tone: 3;
    in property <bool> gateway-pulse: true;
    in property <string> supervision-value;
    in property <string> supervision-detail;
    in property <int> supervision-tone: 3;
    in property <string> upstream-value: "检测中";
    in property <string> upstream-detail;
    in property <int> upstream-tone: 3;
    in property <bool> upstream-pulse: true;
    // The UM service card reads the app instance gateway's service snapshot.
    // A failed read keeps its reason and never invents a PID; a stopped service
    // offers the start action, and a missing gateway points at the gateway entry.
    in property <string> um-service-state: "检测中";
    in property <string> um-service-detail;
    in property <int> um-service-tone: 3;
    in property <string> um-service-checked-at;
    in property <bool> um-service-can-start;
    in property <bool> um-service-gateway-missing;
    in property <string> um-service-gateway-detail;
    in property <bool> um-service-can-start-gateway;
    in-out property <bool> um-service-busy: false;
    in property <string> um-service-start-status;
    in property <int> um-service-start-tone: 3;
    callback start-um-service();
    // The fault history card reads the record the app instance's gateway wrote.
    // A missing record is the legal empty state; an unreadable record keeps its
    // reason instead of folding into 「当前无上游故障」.
    in property <string> upstream-fault-status: "读取中";
    in property <int> upstream-fault-tone: 3;
    in property <string> upstream-fault-check;
    in property <bool> upstream-fault-active;
    in property <string> upstream-fault-active-title;
    in property <string> upstream-fault-active-detail;
    in property <[FaultRow]> upstream-fault-history: [];
    in-out property <bool> show-fault-evidence: false;
    out property <bool> upstream-fault-evidence-shown:
        root.show-fault-evidence && root.upstream-fault-history.length > 0;
    out property <bool> upstream-fault-evidence-toggle-visible:
        root.upstream-fault-history.length > 0;
    in property <string> account-label: "读取中";
    in property <string> account-detail;
    in property <int> account-tone: 3;
    in property <bool> account-pulse: true;
    in property <string> account-saved: "未配置账号";
    in property <string> account-saved-detail;
    in property <bool> account-can-clear;
    in property <bool> account-can-continue;
    // ADR 0011: an operator-requested manual takeover opens the visible window
    // directly; the on-demand action only opens it when verify rejects the
    // current credential.
    in property <bool> account-manual-takeover;
    in property <bool> account-form-visible;
    in property <bool> account-busy;
    in property <bool> show-intro;
    in-out property <string> credential-account-input;
    in-out property <string> credential-password-input;
    in-out property <bool> account-input-invalid;
    in-out property <string> account-input-error;
    in-out property <bool> password-input-invalid;
    in-out property <string> password-input-error;
    in property <bool> password-visible;
    in property <string> credential-status;
    in property <int> credential-tone: 3;
    in property <string> login-status;
    in property <int> login-tone: 3;
    // The overview's 「最近核验」 card: the last `/admin/auth/verify` probe,
    // its reason and the re-probe action. `verify-at` stays empty until the
    // first probe, so the action reads 立即核验 and then 重新核验.
    in property <string> verify-at;
    in property <string> verify-result: "从未核验";
    in property <string> verify-detail: "还没有向上游确认过当前登录凭据。";
    in property <int> verify-tone: 3;
    in property <bool> verify-busy: false;
    in property <string> verify-action-label: "立即核验";
    // The overview maintenance menu: five actions, their impact and the
    // concrete reason a closed action shows. The first click only arms the
    // shared confirmation; only its confirm button runs the action.
    in-out property <bool> maintenance-menu-open: false;
    in property <[MaintenanceRow]> maintenance-items: [
        { action: 0, label: "", impact: "", enabled: false,
            reason: "维护菜单尚未读取", confirm-title: "", confirm-body: "",
            confirm-label: "", danger: false },
        { action: 1, label: "", impact: "", enabled: false,
            reason: "维护菜单尚未读取", confirm-title: "", confirm-body: "",
            confirm-label: "", danger: false },
        { action: 2, label: "", impact: "", enabled: false,
            reason: "维护菜单尚未读取", confirm-title: "", confirm-body: "",
            confirm-label: "", danger: false },
        { action: 3, label: "", impact: "", enabled: false,
            reason: "维护菜单尚未读取", confirm-title: "", confirm-body: "",
            confirm-label: "", danger: false },
        { action: 4, label: "", impact: "", enabled: false,
            reason: "维护菜单尚未读取", confirm-title: "", confirm-body: "",
            confirm-label: "", danger: false }
    ];
    in-out property <int> maintenance-confirm: -1;
    in property <string> maintenance-status;
    in property <int> maintenance-status-tone: 3;
    // The app instance has no console-state.sqlite3 source, so the records
    // area says 不适用 and carries no rows instead of drawing an empty table.
    in property <string> maintenance-records-status: "不适用（本机实例无维护记录来源）";
    in property <int> maintenance-records-tone: 3;
    in property <bool> maintenance-records-not-applicable: true;
    in property <[MaintenanceRecordRow]> maintenance-records: [];
    // A start/stop action runs through the existing supervisor; verify,
    // on-demand login and restart delegate to their own cards.
    in-out property <bool> maintenance-action-busy: false;
    out property <bool> maintenance-busy:
        root.verify-busy || root.account-busy || root.gateway-restarting
        || root.maintenance-action-busy;
    callback maintenance-act(int);
    // Test seams: the row copy and geometry the headless tests read.
    out property <bool> maintenance-verify-enabled: root.maintenance-items[0].enabled;
    out property <string> maintenance-verify-note:
        root.maintenance-items[0].enabled
        ? root.maintenance-items[0].impact : root.maintenance-items[0].reason;
    out property <bool> maintenance-login-enabled: root.maintenance-items[1].enabled;
    out property <bool> maintenance-start-enabled: root.maintenance-items[2].enabled;
    out property <string> maintenance-start-note:
        root.maintenance-items[2].enabled
        ? root.maintenance-items[2].impact : root.maintenance-items[2].reason;
    out property <bool> maintenance-stop-enabled: root.maintenance-items[3].enabled;
    out property <bool> maintenance-restart-enabled: root.maintenance-items[4].enabled;
    out property <bool> maintenance-menu-visible: maintenance-menu.visible;
    out property <length> maintenance-toggle-x: maintenance-toggle.absolute-position.x;
    out property <length> maintenance-toggle-y: maintenance-toggle.absolute-position.y;
    out property <length> maintenance-toggle-width: maintenance-toggle.width;
    out property <length> maintenance-toggle-height: maintenance-toggle.height;
    out property <length> maintenance-verify-x: maintenance-verify.button-x;
    out property <length> maintenance-verify-y: maintenance-verify.button-y;
    out property <length> maintenance-verify-width: maintenance-verify.button-width;
    out property <length> maintenance-verify-height: maintenance-verify.button-height;
    out property <length> maintenance-login-x: maintenance-login.button-x;
    out property <length> maintenance-login-y: maintenance-login.button-y;
    out property <length> maintenance-login-width: maintenance-login.button-width;
    out property <length> maintenance-login-height: maintenance-login.button-height;
    out property <length> maintenance-start-x: maintenance-start.button-x;
    out property <length> maintenance-start-y: maintenance-start.button-y;
    out property <length> maintenance-start-width: maintenance-start.button-width;
    out property <length> maintenance-start-height: maintenance-start.button-height;
    out property <length> maintenance-stop-x: maintenance-stop.button-x;
    out property <length> maintenance-stop-y: maintenance-stop.button-y;
    out property <length> maintenance-stop-width: maintenance-stop.button-width;
    out property <length> maintenance-stop-height: maintenance-stop.button-height;
    out property <length> maintenance-restart-x: maintenance-restart.button-x;
    out property <length> maintenance-restart-y: maintenance-restart.button-y;
    out property <length> maintenance-restart-width: maintenance-restart.button-width;
    out property <length> maintenance-restart-height: maintenance-restart.button-height;
    out property <bool> maintenance-confirm-visible: root.maintenance-confirm >= 0;
    out property <string> maintenance-confirm-title:
        root.maintenance-confirm == 0 ? root.maintenance-items[0].confirm-title
        : root.maintenance-confirm == 1 ? root.maintenance-items[1].confirm-title
        : root.maintenance-confirm == 2 ? root.maintenance-items[2].confirm-title
        : root.maintenance-confirm == 3 ? root.maintenance-items[3].confirm-title
        : root.maintenance-items[4].confirm-title;
    out property <string> maintenance-confirm-body:
        root.maintenance-confirm == 0 ? root.maintenance-items[0].confirm-body
        : root.maintenance-confirm == 1 ? root.maintenance-items[1].confirm-body
        : root.maintenance-confirm == 2 ? root.maintenance-items[2].confirm-body
        : root.maintenance-confirm == 3 ? root.maintenance-items[3].confirm-body
        : root.maintenance-items[4].confirm-body;
    out property <string> maintenance-confirm-label:
        root.maintenance-confirm == 0 ? root.maintenance-items[0].confirm-label
        : root.maintenance-confirm == 1 ? root.maintenance-items[1].confirm-label
        : root.maintenance-confirm == 2 ? root.maintenance-items[2].confirm-label
        : root.maintenance-confirm == 3 ? root.maintenance-items[3].confirm-label
        : root.maintenance-items[4].confirm-label;
    out property <bool> maintenance-confirm-danger:
        root.maintenance-confirm == 0 ? root.maintenance-items[0].danger
        : root.maintenance-confirm == 1 ? root.maintenance-items[1].danger
        : root.maintenance-confirm == 2 ? root.maintenance-items[2].danger
        : root.maintenance-confirm == 3 ? root.maintenance-items[3].danger
        : root.maintenance-items[4].danger;
    out property <length> maintenance-confirm-x:
        root.maintenance-confirm == 0 ? maintenance-verify.confirm-x
        : root.maintenance-confirm == 1 ? maintenance-login.confirm-x
        : root.maintenance-confirm == 2 ? maintenance-start.confirm-x
        : root.maintenance-confirm == 3 ? maintenance-stop.confirm-x
        : maintenance-restart.confirm-x;
    out property <length> maintenance-confirm-y:
        root.maintenance-confirm == 0 ? maintenance-verify.confirm-y
        : root.maintenance-confirm == 1 ? maintenance-login.confirm-y
        : root.maintenance-confirm == 2 ? maintenance-start.confirm-y
        : root.maintenance-confirm == 3 ? maintenance-stop.confirm-y
        : maintenance-restart.confirm-y;
    out property <length> maintenance-confirm-width:
        root.maintenance-confirm == 0 ? maintenance-verify.confirm-width
        : root.maintenance-confirm == 1 ? maintenance-login.confirm-width
        : root.maintenance-confirm == 2 ? maintenance-start.confirm-width
        : root.maintenance-confirm == 3 ? maintenance-stop.confirm-width
        : maintenance-restart.confirm-width;
    out property <length> maintenance-confirm-height:
        root.maintenance-confirm == 0 ? maintenance-verify.confirm-height
        : root.maintenance-confirm == 1 ? maintenance-login.confirm-height
        : root.maintenance-confirm == 2 ? maintenance-start.confirm-height
        : root.maintenance-confirm == 3 ? maintenance-stop.confirm-height
        : maintenance-restart.confirm-height;
    out property <length> maintenance-cancel-x:
        root.maintenance-confirm == 0 ? maintenance-verify.cancel-x
        : root.maintenance-confirm == 1 ? maintenance-login.cancel-x
        : root.maintenance-confirm == 2 ? maintenance-start.cancel-x
        : root.maintenance-confirm == 3 ? maintenance-stop.cancel-x
        : maintenance-restart.cancel-x;
    out property <length> maintenance-cancel-y:
        root.maintenance-confirm == 0 ? maintenance-verify.cancel-y
        : root.maintenance-confirm == 1 ? maintenance-login.cancel-y
        : root.maintenance-confirm == 2 ? maintenance-start.cancel-y
        : root.maintenance-confirm == 3 ? maintenance-stop.cancel-y
        : maintenance-restart.cancel-y;
    out property <length> maintenance-cancel-width:
        root.maintenance-confirm == 0 ? maintenance-verify.cancel-width
        : root.maintenance-confirm == 1 ? maintenance-login.cancel-width
        : root.maintenance-confirm == 2 ? maintenance-start.cancel-width
        : root.maintenance-confirm == 3 ? maintenance-stop.cancel-width
        : maintenance-restart.cancel-width;
    out property <length> maintenance-cancel-height:
        root.maintenance-confirm == 0 ? maintenance-verify.cancel-height
        : root.maintenance-confirm == 1 ? maintenance-login.cancel-height
        : root.maintenance-confirm == 2 ? maintenance-start.cancel-height
        : root.maintenance-confirm == 3 ? maintenance-stop.cancel-height
        : maintenance-restart.cancel-height;
    out property <bool> maintenance-status-visible: !root.maintenance-status.is-empty;
    out property <bool> maintenance-table-visible:
        !root.maintenance-records-not-applicable
        && root.maintenance-records.length > 0;
    out property <int> maintenance-record-count: root.maintenance-records.length;
    out property <bool> maintenance-busy-note-visible: root.maintenance-busy;
    in property <string> status-line;
    in property <int> status-tone: 0;
    // Inline clear confirmation: one click arms it, the next click clears.
    private property <bool> confirm-clear: false;
    // The tray-less exit uses the same two-step inline confirmation.
    private property <bool> confirm-quit: false;
    in property <string> last-update: "—";
    // Manual refresh is one shared action: the icon spins for 600 ms and every
    // refresh button stays disabled until the spin ends. Auto refresh only drives
    // the overview and never touches the log page's live follow.
    in-out property <bool> refreshing: false;
    out property <angle> refresh-rotation: 0deg;
    in-out property <int> auto-refresh: 5;
    in-out property <bool> refresh-paused: false;
    in-out property <int> auto-refresh-index: 0;
    in property <string> overview-updated-at: "—";
    in property <string> request-updated-at: "—";
    in property <string> log-updated-at: "—";
    in property <string> settings-updated-at: "—";
    in-out property <int> usage-period: 0;
    in property <[UsagePoint]> usage-points: [];
    in property <[string]> usage-labels;
    in property <[float]> usage-token-counts;
    in property <[float]> usage-request-counts;
    in property <string> token-total: "—";
    in property <string> request-total: "—";
    in property <bool> usage-loading: true;
    in property <string> usage-status;
    in property <int> usage-tone: 3;
    // Test seam: the shell copies the Windows animation preference into this
    // property. A saved "reduced" choice wins over it.
    in property <bool> system-allows-motion: true;
    in-out property <int> motion-mode: 0;
    out property <bool> allow-motion: root.motion-mode == 1 ? false : root.system-allows-motion;
    // The saved appearance choice: 0 expands the rail, 1 keeps icons only.
    in-out property <int> sidebar-mode: 0;
    in-out property <bool> reduce-transparency: false;
    callback sidebar-mode-changed(int);
    callback motion-mode-changed(int);
    callback transparency-changed(bool);
    // The saved appearance choice: 0 follows the system, 1 light, 2 dark.
    in-out property <int> theme-mode <=> Theme.theme-mode;
    // Test seam: the headless tests stand in for the Windows app theme.
    in-out property <bool> system-dark <=> Theme.system-dark;
    out property <bool> theme-dark: Theme.dark;
    // Test seams: the rail geometry and the effective appearance choices.
    out property <length> rail-width: rail.width;
    out property <bool> sidebar-compact: root.compact;
    out property <bool> sidebar-labels-visible: !root.compact;
    out property <bool> sidebar-tooltips-visible: root.compact;
    out property <bool> motion-enabled: Theme.motion;
    out property <bool> transparency-note-visible: appearance-hint.visible;
    out property <string> transparency-note-text: appearance-hint.text;
    out property <length> sidebar-mode-x: sidebar-mode-control.absolute-position.x;
    out property <length> sidebar-mode-y: sidebar-mode-control.absolute-position.y;
    out property <length> sidebar-mode-width: sidebar-mode-control.width;
    out property <length> sidebar-mode-height: sidebar-mode-control.height;
    out property <length> motion-mode-x: motion-mode-control.absolute-position.x;
    out property <length> motion-mode-y: motion-mode-control.absolute-position.y;
    out property <length> motion-mode-width: motion-mode-control.width;
    out property <length> motion-mode-height: motion-mode-control.height;
    out property <length> transparency-toggle-x: transparency-toggle.absolute-position.x;
    out property <length> transparency-toggle-y: transparency-toggle.absolute-position.y;
    out property <length> transparency-toggle-width: transparency-toggle.width;
    out property <length> transparency-toggle-height: transparency-toggle.height;
    // Test seam: lets the interaction tests switch chart modes without pixels.
    in-out property <bool> usage-show-line: false;
    in-out property <bool> usage-show-requests: false;

    in property <string> log-status: "尚未读取日志";
    in property <int> log-tone: 3;
    // The manual refresh acknowledges itself twice: the status line says it is
    // refreshing, then the button shows 已刷新 for 1.2 s after the read lands.
    in-out property <bool> log-refreshed: false;
    in-out property <bool> log-refresh-pending: false;
    in property <[LogRow]> logs: [];
    // The log page has two layers. `log-mode` 0 tails the instance's own file;
    // 1 reads the gateway's bounded server-side history. The history filters
    // never touch the live follow, pause or new-log count.
    in-out property <int> log-mode: 0;
    // 今天 / 24 小时 / 7 天 / 30 天 / 全部. `log-period` keeps the saved
    // desktop.json index; the history control owns the five visible ranges.
    in-out property <int> log-range: 0;
    in-out property <bool> log-level-error: false;
    in-out property <bool> log-level-warn: false;
    in-out property <bool> log-level-info: false;
    in-out property <bool> log-level-debug: false;
    // Gateway `sources` closed set; the first entry is "all sources".
    in property <[string]> log-source-options: ["全部来源"];
    in-out property <int> log-source-index: 0;
    in-out property <string> log-source;
    // "没有更早记录" once the last history page is loaded.
    in property <string> log-history-note;
    // Legacy single-level index kept for desktop.json persistence.
    in-out property <int> log-filter-level: 0;
    in-out property <string> log-filter-keyword;
    in-out property <bool> log-follow: true;
    in-out property <length> log-scroll-y: 0px;
    in-out property <int> new-log-count;
    in property <int> log-total;
    in property <int> log-version;
    in-out property <int> log-period;
    in property <bool> older-logs;
    // Test seam: the log detail state is set by row activation and read by the
    // layout test that checks the list height after closing the detail.
    in-out property <string> open-log-id;
    private property <string> open-log-title;
    private property <string> open-log-body;

    in property <[RequestRow]> requests: [];
    in property <string> request-status: "等待从本实例读取请求记录…";
    in property <int> request-tone: 3;
    // 较新/较早 page navigation.
    in property <bool> older-requests;
    in property <bool> newer-requests;
    // 加载更早 appends history; it has its own cursor so appending to the
    // end never disables the 较早 page pager.
    in property <bool> has-earlier-records;
    in-out property <string> request-keyword;
    in-out property <int> request-period;
    in-out property <int> request-result;
    // The model dropdown lists the window's models; the first entry is the
    // "all models" choice and keeps the filter empty.
    in property <[string]> request-model-options: ["全部模型"];
    in-out property <int> request-model-index: 0;
    in-out property <string> request-model-filter: "";
    // All + the six result kinds in the same order the view model maps.
    in property <[string]> request-result-options: ["全部结果", "成功", "失败", "截断", "客户端断开", "已取消", "未知"];
    in-out property <string> selected-request;
    in property <string> request-detail-title;
    in property <string> request-detail;
    in-out property <length> request-scroll-y: 0px;
    in property <[RequestMetric]> request-metrics;
    in property <string> request-summary: "";
    in property <[string]> request-chart-labels;
    in property <[float]> request-chart-token-counts;
    in property <[float]> request-chart-request-counts;
    in property <[float]> request-chart-speed-counts;
    in property <[ChartDataset]> request-chart-token-series;
    in property <[ChartDataset]> request-chart-request-series;
    in property <[ChartDataset]> request-chart-speed-series;
    in property <[ModelSpeedRow]> request-model-speeds;
    in-out property <int> request-metric: 0;
    in-out property <bool> request-split-by-model: false;

    in-out property <string> port-input: "7999";
    in-out property <bool> port-input-invalid;
    in-out property <string> port-input-error;
    in property <string> active-address;
    // The copy entries carry the scheme so the copied text is the full API URL.
    private property <string> base-url: "http://" + root.active-address;
    // The shell reports one clipboard write: `copy-ok` or the reason in
    // `copy-error`. The page that started the copy owns the target, so only the
    // clicked entry turns into a check.
    in-out property <bool> copy-ok;
    in-out property <string> copy-error;
    private property <int> copy-target: 0;
    private property <bool> base-copied;
    private property <bool> v1-copied;
    in property <bool> port-busy;
    in property <string> settings-status;
    // A failed gateway offers one recovery action; restart interrupts in-flight
    // requests, so it asks once before acting.
    callback restart-gateway();
    // The shell persists the page filters and the auto-refresh interval when any
    // of them changes, so a restart opens the same view.
    callback settings-changed();
    in-out property <bool> confirm-restart: false;
    in-out property <bool> gateway-restarting: false;
    in property <int> settings-tone: 3;
    // Access info (#152): the existing model API address row also carries the
    // gateway's interface type and hints. A failed read keeps its reason and
    // never shows a made-up address; a gateway that is not running shows the
    // port-derived address with an explicit note and never claims a connection.
    in property <string> access-address;
    in property <string> access-full-base-url;
    in property <string> access-interface-type: "尚未读取接入信息";
    in property <int> access-tone: 3;
    in property <[string]> access-hints;
    in property <string> access-status;
    in property <string> access-address-note;
    in property <bool> access-address-available: true;
    private property <string> access-display-address:
        root.access-address-available
            ? (root.access-address.is-empty ? root.base-url : root.access-address)
            : "地址不可用";
    // The settings page's UM model catalog: a failed refresh keeps the previous
    // rows and marks them stale; a legal empty catalog says 无模型.
    in property <[ModelRow]> um-models;
    in property <string> um-model-status: "尚未读取 UM 模型目录";
    in property <int> um-model-tone: 3;
    in property <bool> um-model-stale;
    in property <bool> um-model-loading;
    in property <bool> um-model-empty;
    in-out property <string> selected-model;
    in property <string> um-model-detail-title;
    in property <string> um-model-detail;
    callback refresh-um-models();
    callback open-model(string);
    // Context probes (#154): batch selection, the run/stop actions, progress,
    // budget and the collapsible history. A failed probe keeps its reason and a
    // missing budget or result field reads 不可用 instead of a zero.
    in property <[ProbeRow]> probe-models;
    in property <[ProbeHistoryRow]> probe-history;
    in property <string> probe-status: "尚未执行上下文探测";
    in property <int> probe-tone: 3;
    in property <string> probe-progress;
    in property <string> probe-budget;
    in property <bool> probe-running;
    in property <bool> probe-stop-requested;
    in property <bool> probe-loading;
    in-out property <[string]> probe-selected;
    in-out property <bool> probe-history-open: false;
    callback toggle-probe-model(string);
    callback select-all-probes();
    callback clear-probe-selection();
    callback run-context-probe();
    callback stop-context-probe();
    // The settings page's UM login-round table (#159): round/reason filters,
