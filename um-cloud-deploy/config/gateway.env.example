# Rust gateway host environment.  Installed as /etc/um-share/gateway.env
# (0640 root:um-share).  UM_SHARE_UID is appended by install.sh; do not put a
# different numeric uid here by hand.
#
# This is the target 8003/8002 contract.  The Python rollback release uses
# config/broker-python.env.example instead.
UM_SHARE_HOST_STATE_DIR=/run/um-share
UM_SHARE_GATEWAY_PORT=8003
UM_SHARE_GATEWAY_ENTRY_KIND=native
UM_SHARE_GATEWAY_ENTRY=/opt/um-share/current/bin/um-gateway
UM_SHARE_GATEWAY_MODE=production
UM_DRAIN_BUDGET_S=900
UM_BROKER_DRAIN_MAX_S=90
# The 8003 gateway persists its revoke nonces and applied generations here.
# The gateway host runs ProtectSystem=strict and only /var/lib/um-share is
# writable, so this must NOT point inside the release tree
# (/opt/um-share/current).  install.sh appends this key to an existing
# gateway.env; keep both in sync.  The gateway adopts a pre-fix
# <release>/data/share-revoke.state once at its first start, so an upgrade
# does not drop a pending security-journal generation.
CHAT2API_SHARE_REVOKE_STATE_FILE=/var/lib/um-share/share-revoke.state
