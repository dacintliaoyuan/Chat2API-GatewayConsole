{
  "name": "ai-gateway-console",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "check:contracts": "node --experimental-strip-types --test scripts/backend-contract/check.mjs scripts/backend-contract/check-generated.mjs scripts/backend-contract/check-share-readiness.mjs scripts/backend-contract/check-share-public.mjs scripts/backend-contract/check-cloud-usage-ledger.mjs",
    "check:logs": "node --experimental-strip-types --test scripts/check-log-presentation.mjs",
    "check:cloud-console": "node --test scripts/check-cloud-console.mjs",
    "check:um": "node --test scripts/check-um-views.mjs",
    "check:console": "node scripts/console-gate/run.mjs",
    "format": "prettier --write src scripts index.html package.json tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
